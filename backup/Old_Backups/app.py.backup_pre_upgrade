def caption_dropdown_card(title: str, items: List[Dict[str, str]], key: str, enabled_key: str, default_enabled: bool):
    labels = [item["label"] for item in items]
    if key not in st.session_state or st.session_state[key] not in labels:
        st.session_state[key] = labels[0]

    st.markdown('<div class="caption-wrap">', unsafe_allow_html=True)
    enabled = st.checkbox(f"Enable {title}", value=default_enabled, key=enabled_key)
    st.markdown(f'<div class="caption-title">{title}</div>', unsafe_allow_html=True)

    selected_label = st.selectbox(
        "Select caption style",
        labels,
        index=labels.index(st.session_state[key]),
        key=f"{key}_dropdown",
    )
    st.session_state[key] = selected_label
    item = {x["label"]: x for x in items}[selected_label]

    st.markdown(f'<div class="caption-desc">{item["desc"]}</div>', unsafe_allow_html=True)
    st.markdown('<div class="caption-preview-box">', unsafe_allow_html=True)

    p = preview_path(item["id"])
    if p.exists() and p.stat().st_size > 2500:
        st.video(str(p))
    else:
        st.warning("Preview missing. Run: python caption_preview_generator.py")

    st.markdown("</div></div>", unsafe_allow_html=True)
    return enabled, item["id"]


