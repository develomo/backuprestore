    if str(mode).upper() == "LONG":
        if q in {"balanced", "high", "max", "edit", "fast", "1080p", "4k", "2160p"}:
            return "480p"
        if "720" in q:
            return "720p"
        if "360" in q:
            return "360p"
        return "480p"
    return value


