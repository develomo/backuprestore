def upload_single(label: str, mode: str, kind: str, exts: set, key: str) -> Optional[str]:
    folder = asset_path(mode, kind)
    st.markdown(f'<div class="asset-label">{label}</div>', unsafe_allow_html=True)

    version_key = f"{key}_{mode}_{kind}_version"
    version = st.session_state.get(version_key, 0)

    uploaded = st.file_uploader(
        label,
        type=[x.replace(".", "") for x in exts],
        accept_multiple_files=False,
        key=f"{key}_{mode}_{kind}_{version}",
        label_visibility="collapsed",
    )
    if uploaded:
        save_uploaded_file(uploaded, folder)
        st.session_state[version_key] = version + 1
        st.rerun()

    files = list_files(folder, exts)
    choices = [""] + [str(p) for p in files]
    select_key = f"{key}_{mode}_{kind}_select"

    if files and (select_key not in st.session_state or st.session_state.get(select_key) not in choices):
        st.session_state[select_key] = str(files[0])

    selected = st.selectbox(label, choices, key=select_key, label_visibility="collapsed")
    resolved = selected or (str(files[0]) if files else None)

    st.markdown(f'<div class="count">{len(files)} files</div>', unsafe_allow_html=True)
    if resolved:
        st.caption(f"Selected: {Path(resolved).name}")
    return resolved


