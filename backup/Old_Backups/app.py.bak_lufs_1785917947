def call_supported(fn, kwargs: Dict[str, Any]):
    signature = inspect.signature(fn)
    has_var_kwargs = any(p.kind == inspect.Parameter.VAR_KEYWORD for p in signature.parameters.values())

    if has_var_kwargs:
        safe_kwargs = dict(kwargs)
    else:
        safe_kwargs = {k: v for k, v in kwargs.items() if k in signature.parameters}

    for bad_key in [
        "caption_enabled",
        "preset_overrides",
        "voice_level",
        "music_level",
        "sfx_level",
    ]:
        if bad_key not in signature.parameters:
            safe_kwargs.pop(bad_key, None)

    return fn(**safe_kwargs)


