def get_broll_clips(max_n: int = 12) -> List[Path]:
    d = Path("assets/brolls")
    if not d.exists():
        return []
    files = sorted(
        [x for x in d.glob("*") if x.suffix.lower() in {".mp4", ".mov", ".jpg", ".png", ".jpeg", ".webp"}],
        key=natural_key,
    )
    return files[:max_n]


def get_broll_clip() -> Optional[Path]:
    clips = get_broll_clips(max_n=1)
    return clips[0] if clips else None


def apply_broll_overlay(v, o, body_end_cutoff: float, interval: float = BROLL_INTERVAL_SECONDS):
    clips = get_broll_clips()
    v = Path(v)
    o = Path(o)
    if not clips:
        return v

    timestamps = []
    t = interval / 2.0
    while t < body_end_cutoff - 3.5:
        timestamps.append(t)
        t += interval
    if not timestamps:
        return v

    cmd = [FFMPEG, "-y", "-i", str(v)]
    filter_parts = []
    current = "[0:v]"
    for i, ts in enumerate(timestamps):
        clip = clips[i % len(clips)]
        input_idx = i + 1
        cmd += ["-i", str(clip)]
        b_label = f"[b{i}]"
        out_label = f"[ov{i}]"
        filter_parts.append(
            f"[{input_idx}:v]scale=iw*0.3:ih*0.3,scale=iw:ih:force_original_aspect_ratio=decrease,"
            f"pad=iw:ih:(ow-iw)/2:(oh-ih)/2:black@0,setsar=1,format=yuva420p,"
            f"fade=t=in:st=0:d=0.4:alpha=1,fade=t=out:st=2.4:d=0.4:alpha=1{b_label}"
        )
        filter_parts.append(
            f"{current}{b_label}overlay=x=(W-w)/2:y=(H-h)/2:enable='between(t,{ts:.2f},{ts+2.8:.2f})'{out_label}"
        )
        current = out_label

    cmd += [
        "-filter_complex", ";".join(filter_parts),
        "-map", current,
        "-c:a", "copy", "-c:v", "libx264", "-preset", "ultrafast", "-crf", "28",
        "-threads", "2", str(o),
    ]
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=240)
        if r.returncode == 0 and o.exists() and o.stat().st_size > 1000:
            return o
        log(f"[BRoll] overlay ffmpeg failed rc={r.returncode}: {(r.stderr or b'').decode('utf-8', 'ignore')[-400:]}")
    except Exception as e:
        log(f"[BRoll] overlay exception, skipping: {e}")
    return v


# =============================================================================
# PART 8 — SUBSCRIBE OVERLAY ENGINE  ***CRITICAL FIX***
# Spec item #4 (Subscribe Overlay):
#   ROOT CAUSE: the old apply_subscribe_overlay_mid() silently `return`ed
#   (copying input to output untouched) whenever the overlay path was
#   missing OR the computed start/end window was invalid - with NO log
#   line, so a broken overlay looked identical to a working render.
#
#   FIX 1: every skip path now logs a clear "[SubscribeOverlay] SKIPPED -
#          reason: ..." line.
#   FIX 2: guaranteed 5-8s continuous display window (fixed at 6.5s,
#          configurable), computed against the BODY (excludes intro/outro).
#   FIX 3: safe fallback window (35%-45% of body) if the natural mid-point
#          window would be invalid for this video's length.
#   FIX 4: moved to TOP-RIGHT corner so it never collides with bottom-center
#          captions or the bottom-right watermark.
#   FIX 5: report fields `subscribe_overlay_shown` and
#          `subscribe_overlay_duration_actual` are now returned so the
#          controller/report JSON can verify it actually fired.
# =============================================================================

def apply_subscribe_overlay_reliable(video, overlay, out, total_duration: float, intro_sec: float,
                                      outro_sec: float, duration_seconds: float = SUBSCRIBE_OVERLAY_DURATION_SECONDS,
                                      corner: str = "top-right") -> Tuple[Path, bool, float]:
    video = Path(video)
    out = Path(out)

    if not overlay or not Path(overlay).exists():
        log("[SubscribeOverlay] SKIPPED - reason: no overlay file provided or file not found")
        shutil.copy2(video, out)
        return out, False, 0.0

    overlay = Path(overlay)
    body_start = intro_sec
    body_end = max(body_start, total_duration - outro_sec)
    body_len = body_end - body_start

    if body_len <= duration_seconds + 4.0:
        log(f"[SubscribeOverlay] SKIPPED - reason: body too short ({body_len:.2f}s) for a safe "
            f"{duration_seconds:.1f}s overlay window")
        shutil.copy2(video, out)
        return out, False, 0.0

    mid = body_start + body_len * 0.5
    start = mid - duration_seconds / 2.0
    end = start + duration_seconds

    safe_margin = 1.5
    if start < body_start + safe_margin or end > body_end - safe_margin:
        # Fix #3: fallback safe window at the 35%-45% mark of the body.
        fallback_start = body_start + body_len * 0.35
        fallback_end = body_start + body_len * 0.45
        if (fallback_end - fallback_start) < 2.0:
            log("[SubscribeOverlay] SKIPPED - reason: even the fallback window is too small for this video length")
            shutil.copy2(video, out)
            return out, False, 0.0
        log(f"[SubscribeOverlay] mid-point window was unsafe, using fallback window "
            f"{fallback_start:.2f}s-{fallback_end:.2f}s instead")
        start, end = fallback_start, fallback_end

    if end <= start or end > total_duration:
        log("[SubscribeOverlay] SKIPPED - reason: could not compute a valid time-window for this video")
        shutil.copy2(video, out)
        return out, False, 0.0

    actual_duration = end - start
    pos_map = {
        "top-right": ("main_w-overlay_w-24", "24"),
        "bottom-right": ("main_w-overlay_w-24", "main_h-overlay_h-24"),
        "top-left": ("24", "24"),
        "bottom-left": ("24", "main_h-overlay_h-24"),
    }
    ox, oy = pos_map.get(corner, pos_map["top-right"])

    try:
        if overlay.suffix.lower() in IMAGE_EXTS:
            filt = (f"[1:v]scale=220:-1,format=rgba,colorchannelmixer=aa=0.92[ov];"
                    f"[0:v][ov]overlay={ox}:{oy}:enable='between(t,{start:.3f},{end:.3f})'")
            cmd = [FFMPEG, "-y", "-i", str(video), "-loop", "1", "-i", str(overlay),
                   "-filter_complex", filt, "-c:v", "libx264", "-preset", "ultrafast", "-crf", "30",
                   "-pix_fmt", "yuv420p", "-threads", "2", "-an", str(out)]
        else:
            filt = (f"[1:v]scale=260:-1,format=rgba,chromakey=0x00ff00:0.28:0.12,colorchannelmixer=aa=0.95[ov];"
                    f"[0:v][ov]overlay={ox}:{oy}:enable='between(t,{start:.3f},{end:.3f})'")
            cmd = [FFMPEG, "-y", "-i", str(video), "-stream_loop", "-1", "-i", str(overlay),
                   "-filter_complex", filt, "-t", f"{total_duration:.3f}", "-c:v", "libx264",
                   "-preset", "ultrafast", "-crf", "30", "-pix_fmt", "yuv420p", "-threads", "2", "-an", str(out)]
        run_cmd(cmd, timeout=180)
        log(f"[SubscribeOverlay] shown from {start:.2f}s to {end:.2f}s (duration {actual_duration:.2f}s, corner={corner})")
        return out, True, actual_duration
    except Exception as e:
        log(f"[SubscribeOverlay] SKIPPED - reason: ffmpeg overlay step failed: {e}")
        shutil.copy2(video, out)
        return out, False, 0.0


# =============================================================================
# PART 9 — OUTRO / END-CARD ENGINE  ***CRITICAL FIX***
# Spec item #5 (Outro):
#   ROOT CAUSE: when no outro asset was uploaded, the pipeline simply had
#   NO outro segment at all (video = intro + body, nothing else) - there
#   was never a guaranteed distinct "ending" moment.
#
#   FIX 1: if an uploaded outro asset exists, it is used exactly as before
#          (normalized/padded to the target frame size).
#   FIX 2: if NO outro asset is uploaded, a fallback BRANDED END-CARD is
#          generated on the fly (solid background + fading "thank you" /
#          "subscribe" text + optional logo) so the video ALWAYS ends on a
#          distinct, intentional card - never silently absent.
#   FIX 3: the outro window stays completely clean (Spec #5.2.4) - no
#          captions/subscribe-overlay/music/sfx bleed into it. This was
#          already true for audio (atrim bounds) and is now also enforced
#          for captions/lower-thirds via explicit `outro_cutoff` params
#          threaded through Parts 5 and 6, and watermark via Part 10's
#          `enable` time-bound expression.
# =============================================================================

def generate_fallback_outro_card(out_path, size, fps, duration: float, niche: str = "default",
                                  logo_path: Optional[Path] = None) -> Path:
    out_path = Path(out_path)
    w, h = size
    bg_color = "0x101418"
    primary_text = "THANK YOU FOR WATCHING"
    sub_text = "SUBSCRIBE FOR MORE"

    vf_parts = [
        f"drawtext=text='{primary_text}':fontcolor=white:fontsize={max(18, int(h*0.075))}:"
        f"x=(w-text_w)/2:y=(h*0.40):alpha='if(lt(t,0.4),t/0.4,1)'",
        f"drawtext=text='{sub_text}':fontcolor=0xE0C46A:fontsize={max(14, int(h*0.045))}:"
        f"x=(w-text_w)/2:y=(h*0.54):alpha='if(lt(t,0.7),0,min(1,(t-0.7)/0.3))'",
    ]
    vf = ",".join(vf_parts)

    try:
        if logo_path and Path(logo_path).exists():
            run_cmd([
                FFMPEG, "-y", "-f", "lavfi", "-i", f"color=c={bg_color}:s={w}x{h}:d={duration:.3f}:r={fps}",
                "-i", str(logo_path),
                "-filter_complex",
                f"[0:v]{vf}[bg];[1:v]scale=iw*0.16:-1,format=rgba,"
                f"fade=t=in:st=0:d=0.5:alpha=1[logo];[bg][logo]overlay=(W-w)/2:(H*0.20)",
                "-t", f"{duration:.3f}", "-r", str(fps), "-pix_fmt", "yuv420p",
                "-c:v", "libx264", "-preset", "ultrafast", "-crf", "28", "-threads", "2", "-an", str(out_path),
            ], timeout=60)
        else:
            run_cmd([
                FFMPEG, "-y", "-f", "lavfi", "-i", f"color=c={bg_color}:s={w}x{h}:d={duration:.3f}:r={fps}",
                "-vf", vf, "-t", f"{duration:.3f}", "-r", str(fps), "-pix_fmt", "yuv420p",
                "-c:v", "libx264", "-preset", "ultrafast", "-crf", "28", "-threads", "2", "-an", str(out_path),
            ], timeout=60)
    except Exception as e:
        log(f"[FallbackOutro] drawtext-based card failed ({e}); generating plain color card instead")
        run_cmd([
            FFMPEG, "-y", "-f", "lavfi", "-i", f"color=c={bg_color}:s={w}x{h}:d={duration:.3f}:r={fps}",
            "-t", f"{duration:.3f}", "-r", str(fps), "-pix_fmt", "yuv420p",
            "-c:v", "libx264", "-preset", "ultrafast", "-crf", "28", "-threads", "2", "-an", str(out_path),
        ], timeout=60)

    return out_path


def resolve_outro_segment(outro_path, batch_dir: Path, size, fps, outro_sec: float, quality: str,
                           niche: str = "default", logo_path: Optional[Path] = None) -> Tuple[Path, str]:
    """
    Spec #5 fix: ALWAYS returns a usable outro segment file.
    Returns (path, "uploaded") if a real outro asset was provided, or
    (path, "fallback_generated") if a branded end-card had to be synthesized.
    """
    outro_out = batch_dir / "outro_segment.mp4"
    if outro_path and Path(outro_path).exists():
        run_cmd([
            FFMPEG, "-y", "-i", str(outro_path), "-t", f"{outro_sec:.3f}",
            "-vf", f"scale={size[0]}:{size[1]}:force_original_aspect_ratio=decrease,"
                   f"pad={size[0]}:{size[1]}:(ow-iw)/2:(oh-ih)/2:black,fps={fps}",
            "-c:v", "libx264", "-preset", "ultrafast", "-crf", "30", "-pix_fmt", "yuv420p",
            "-threads", "2", "-an", str(outro_out),
        ], timeout=120)
        return outro_out, "uploaded"

    log("[Outro] No outro asset uploaded - generating a fallback branded end-card instead of leaving the video without an ending")
    generate_fallback_outro_card(outro_out, size, fps, outro_sec, niche=niche, logo_path=logo_path)
    return outro_out, "fallback_generated"


