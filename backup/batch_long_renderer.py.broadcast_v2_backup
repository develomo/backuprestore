def build_music_playlist_file(music_tracks: List[Path], out_path: Path,
                               segment_length: float = MUSIC_SEGMENT_SECONDS,
                               crossfade: float = MUSIC_CROSSFADE_SECONDS) -> Optional[Path]:
    tracks = [Path(t) for t in music_tracks if Path(t).exists()]
    if len(tracks) < 2:
        return None
    try:
        cmd = [FFMPEG, "-y"]
        for t in tracks:
            cmd += ["-t", f"{segment_length:.2f}", "-i", str(t)]
        filters = []
        current = "[0:a]"
        for i in range(1, len(tracks)):
            out_label = f"[mx{i}]"
            filters.append(f"{current}[{i}:a]acrossfade=d={crossfade:.2f}:c1=tri:c2=tri{out_label}")
            current = out_label
        cmd += ["-filter_complex", ";".join(filters), "-map", current, "-c:a", "aac", "-b:a", "192k", str(out_path)]
        run_cmd(cmd, label=f"[MusicPlaylist] combining {len(tracks)} tracks -> {out_path.name}", timeout=180)
        return out_path
    except Exception as e:
        log(f"[MusicPlaylist] build failed, falling back to single track: {e}")
        return None


def _measure_loudnorm(build_filters_fn, target_lufs: float, tp: float, lra: float) -> Optional[Dict[str, str]]:
    try:
        measure_filter_str = f"loudnorm=I={target_lufs}:TP={tp}:LRA={lra}:print_format=json"
        cmd, _ = build_filters_fn(measure_filter_str)
        cmd += ["-map", "0:v:0", "-map", "[aout]", "-f", "null", "-"]
        r = run_cmd_capture(cmd, timeout=240)
        stderr = r.stderr or ""
        match = re.search(r"\{[^{}]*\}", stderr, re.DOTALL)
        if not match:
            return None
        data = json.loads(match.group(0))
        required = ("input_i", "input_tp", "input_lra", "input_thresh", "target_offset")
        if not all(k in data for k in required):
            return None
        return data
    except Exception as e:
        log(f"[TwoPassLoudnorm] measurement pass failed, falling back to single-pass: {e}")
        return None


def measure_final_audio_loudness(final_path) -> Dict[str, Any]:
    """Spec #8.3 acceptance criteria: independently measures the loudness
    of the FINISHED render (not the internal filter graph) so the report
    reflects what a listener would actually experience."""
    result: Dict[str, Any] = {"measured": False}
    try:
        cmd = [FFMPEG, "-i", str(final_path), "-af", "loudnorm=print_format=json", "-f", "null", "-"]
        r = run_cmd_capture(cmd, timeout=120)
        stderr = r.stderr or ""
        match = re.search(r"\{[^{}]*\}", stderr, re.DOTALL)
        if not match:
            return result
        data = json.loads(match.group(0))
        result.update({
            "measured": True,
            "input_i_lufs": data.get("input_i"),
            "input_lra": data.get("input_lra"),
            "input_tp": data.get("input_tp"),
        })
    except Exception as e:
        result["error"] = str(e)
    return result


def mux_audio_timeline(video, voice, out, music, sfx, total_duration, intro_sec, voice_duration,
                        niche: str = "default", audio_profile: Optional[Dict[str, Any]] = None,
                        chapter_markers: Optional[List[Dict[str, Any]]] = None):
    video = Path(video)
    voice = Path(voice)
    out = Path(out)
    prof = audio_profile if isinstance(audio_profile, dict) else audio_profile_for_niche(niche)

    voice_volume = float(prof.get("voice_volume", 1.45))
    music_volume = float(prof.get("music_volume", 0.135))
    sfx_volume = float(prof.get("sfx_volume", 0.060))
    hp = int(prof.get("highpass", 90))
    lp = int(prof.get("lowpass", 9500))
    target_lufs = float(prof.get("target_lufs", -14))
    music_tone = str(prof.get("music_tone", "highpass=f=60,lowpass=f=11500"))

    intro_ms = int(intro_sec * 1000)
    trim_end = f"{intro_sec + voice_duration:.3f}"
    fade_out_start = max(intro_sec, intro_sec + voice_duration - 1.2)

    sting_path = find_chapter_sting_file()
    interior_chapter_times = []
    if chapter_markers and sting_path:
        for m in chapter_markers:
            st = fnum(m.get("start_seconds", 0.0)) + intro_sec
            if 1.0 < st < (total_duration - 1.0):
                interior_chapter_times.append(st)
        interior_chapter_times = interior_chapter_times[:12]

    def build_filters(final_loudnorm_filter: str) -> Tuple[List[str], List[str]]:
        cmd: List[str] = [FFMPEG, "-y", "-i", str(video), "-i", str(voice)]
        filters: List[str] = []

        # ---- VOICE CHAIN (Spec #8 fix 1+2: ONE compressor, ONE gentle EQ) ----
        # BUGFIX: a single ffmpeg output label (e.g. [vside]) can only ever
        # be consumed by ONE downstream filter. The previous version fed
        # [vside] into BOTH the music sidechaincompress AND the sfx
        # sidechaincompress, which ffmpeg rejects ("Stream specifier
        # 'vside' ... matches no streams" / "Invalid argument") because
        # the second consumer finds the pad already linked. The fix: decide
        # up-front how many sidechain consumers exist (music, sfx), then
        # asplit the voice tap into exactly that many DEDICATED copies
        # (vside0, vside1, ...), one per consumer.
        has_music = bool(music and Path(music).exists())
        has_sfx = bool(sfx and Path(sfx).exists())
        num_side_consumers = int(has_music) + int(has_sfx)

        filters.append(
            f"[1:a]volume={voice_volume},"
            f"highpass=f={hp},lowpass=f={lp},"
            f"acompressor=threshold=-19dB:ratio={VOICE_COMPRESSOR_RATIO}:"
            f"attack={VOICE_COMPRESSOR_ATTACK_MS}:release={VOICE_COMPRESSOR_RELEASE_MS},"
            f"equalizer=f={VOICE_PRESENCE_FREQ}:t=q:w=1:g={VOICE_PRESENCE_GAIN},"
            f"alimiter=limit=0.97,"
            f"adelay={intro_ms}|{intro_ms},"
            f"atrim=0:{trim_end}"
            "[vout_pre]"
        )
        if num_side_consumers > 0:
            side_out_labels = "".join(f"[vside{i}]" for i in range(num_side_consumers))
            filters.append(f"[vout_pre]asplit={num_side_consumers + 1}[vout]{side_out_labels}")
        else:
            filters.append("[vout_pre]anull[vout]")

        labels = ["[vout]"]
        idx = 2
        vside_cursor = 0

        if has_music:
            cmd.extend(["-stream_loop", "-1", "-i", str(music)])  # BROADCAST: Seamless infinite loop
            # Music: single tone-shape + single gentle compress (Spec #8 fix 4).
            filters.append(
                f"[{idx}:a]volume={music_volume},"
                f"{music_tone},"
                f"acompressor=threshold=-24dB:ratio=1.7:attack=30:release=250,"
                f"afade=t=in:st={intro_sec:.3f}:d=1.0,"
                f"afade=t=out:st={fade_out_start:.3f}:d=1.2,"
                f"adelay={intro_ms}|{intro_ms},"
                f"atrim=0:{trim_end},"
                "aresample=44100[m_pre]"
            )
            filters.append(
                f"[m_pre][vside{vside_cursor}]sidechaincompress=threshold=0.045:ratio=8:attack=22:release=420:makeup=1[m]"
            )
            vside_cursor += 1
            labels.append("[m]")
            idx += 1

    if has_sfx:
        # BROADCAST-GRADE FIX: Multiple SFX files cycled on clip transitions
        sfx_list = []
        if isinstance(sfx_files, (list, tuple)):
            sfx_list = [Path(s) for s in sfx_files if Path(s).exists()]
        elif sfx and Path(sfx).exists():
            sfx_list = [Path(sfx)]
        
        if sfx_list:
            # Use first SFX as primary, cycle others for variety
            primary_sfx = sfx_list[0]
            cmd.extend(['-stream_loop', '-1', '-i', str(primary_sfx)])
            
            # Add cinematic whoosh/riser at chapter boundaries
            cinematic_sfx = None
            for sfx_candidate in sfx_list[1:]:
                if 'whoosh' in sfx_candidate.name.lower() or 'riser' in sfx_candidate.name.lower():
                    cinematic_sfx = sfx_candidate
                    break
            
            # Dynamic SFX automation: volume based on narration intensity
            filters.append(
                f'[{idx}:a]volume={sfx_volume},'
                'highpass=f=80,lowpass=f=13500,'
                'acompressor=threshold=-22dB:ratio=2.8:attack=15:release=180,'
                f'adelay={intro_ms}|{intro_ms},'
                f'atrim=0:{trim_end},'
                'aresample=44100[s_pre]'
            )
            
            # Sidechain compression for professional ducking
            filters.append(
                f'[s_pre][vside{vside_cursor}]sidechaincompress=threshold=0.05:ratio=4.5:attack=18:release=350:makeup=1.2[s]'
            )
            vside_cursor += 1
            labels.append('[s]')
            idx += 1
            
            # Add cinematic SFX layer if available
            if cinematic_sfx:
                cmd.extend(['-i', str(cinematic_sfx)])
                filters.append(
                    f'[{idx}:a]volume=0.25,'
                    'highpass=f=120,lowpass=f=8000,'
                    f'adelay={intro_ms}|{intro_ms},'
                    f'atrim=0:{trim_end},'
                    'aresample=44100[cin_pre]'
                )
                labels.append('[cin_pre]')
                idx += 1
            idx += 1

        if interior_chapter_times:
            cmd.extend(["-i", str(sting_path)])
            n_hits = len(interior_chapter_times)
            filters.append(f"[{idx}:a]volume=0.30,asplit={n_hits}" + "".join(f"[st_src{i}]" for i in range(n_hits)))
            hit_labels = []
            for i, ts in enumerate(interior_chapter_times):
                delay_ms = int(max(0.0, ts) * 1000)
                filters.append(f"[st_src{i}]adelay={delay_ms}|{delay_ms}[sth{i}]")
                hit_labels.append(f"[sth{i}]")
            filters.append("".join(hit_labels) + f"amix=inputs={n_hits}:duration=longest[chapters_mixed]")
            labels.append("[chapters_mixed]")
            idx += 1

        filters.append(
            "".join(labels)
            + f"amix=inputs={len(labels)}:duration=longest:dropout_transition=0.35,"
            + "acompressor=threshold=-18dB:ratio=2.0:attack=10:release=120,"
            + "alimiter=limit=0.97,"
            + f"{final_loudnorm_filter},"
            + "apad[aout]"
        )
        return cmd, filters

    measured = _measure_loudnorm(build_filters, target_lufs, TARGET_TP, TARGET_LRA)
    if measured:
        final_loudnorm = (
            f"loudnorm=I={target_lufs}:TP={TARGET_TP}:LRA={TARGET_LRA}:"
            f"measured_I={measured['input_i']}:measured_TP={measured['input_tp']}:"
            f"measured_LRA={measured['input_lra']}:measured_thresh={measured['input_thresh']}:"
            f"offset={measured.get('target_offset', '0.0')}:linear=true:print_format=summary"
        )
        loudnorm_mode = "two_pass"
    else:
        final_loudnorm = f"loudnorm=I={target_lufs}:TP={TARGET_TP}:LRA={TARGET_LRA}"
        loudnorm_mode = "single_pass_fallback"

    cmd, filters = build_filters(final_loudnorm)
    cmd += [
        "-filter_complex", ";".join(filters),
        "-map", "0:v:0",
        "-map", "[aout]",
        "-t", f"{total_duration:.3f}",
        "-c:v", "copy",
        "-c:a", "aac",
        "-b:a", "192k",
        "-movflags", "+faststart",
        str(out),
    ]
    run_cmd(cmd, label=f"[Module4Audio] mastering voice(single-stage)+music+sfx ({loudnorm_mode}) -> {target_lufs} LUFS", timeout=300)
    return out, loudnorm_mode


# =============================================================================
# PART 13 — TOP-LEVEL: MEMORY-SAFE BATCH RENDER
# =============================================================================

def render_long_batch_memory(
    voice_path,
    clips,
    output_path=None,
    music_path=None,
    sfx_files=None,
    intro_path=None,
    outro_path=None,
    subscribe_overlay=None,
    quality=DEFAULT_EDIT_QUALITY,
    fps=DEFAULT_FPS,
    batch_size=None,
    final_quality=None,
    add_captions=True,
    words=None,
    words_path=None,
    transcript_text=None,
    caption_mode: str = "phrase",
    style_id=None,
    temp_root=None,
    cleanup: bool = True,
    progress_callback: Optional[Callable] = None,
    preset_overrides: Optional[Dict[str, Any]] = None,
    custom_logo_path: Optional[str] = None,
    **kwargs,
):
    os.environ["FFMPEG_THREADS"] = "2"
    reset_transition_stats()

    started = time.time()
    preset = dict(preset_overrides or {})

    # Spec #6: `add_captions` is honored directly, no override, with a
    # clear log either way (Spec section 10, rule 5).
    add_captions = bool(add_captions)
    if not add_captions:
        log("[Captions] add_captions=False -> caption module fully skipped for this render")

    intro_sec = fnum(preset.get("intro_seconds", INTRO_SECONDS), INTRO_SECONDS)
    outro_sec = fnum(preset.get("outro_seconds", OUTRO_SECONDS), OUTRO_SECONDS)
    voice_offset = fnum(preset.get("voice_start_offset", intro_sec), intro_sec)

    quality = normalize_quality(preset.get("quality", quality))
    size = quality_to_size(quality)
    fps = min(max(12, inum(preset.get("fps", fps), DEFAULT_FPS)), 24)

    requested_batch_size = max(2, min(16, inum(preset.get("batch_size", batch_size or DEFAULT_BATCH_SIZE), DEFAULT_BATCH_SIZE)))
    batch_size = ram_guard_batch_size(requested_batch_size)

    voice = Path(voice_path)
    clip_paths = existing_files(clips, VIDEO_EXTS)
    if not voice.exists():
        raise FileNotFoundError(f"Voice not found: {voice}")
    if not clip_paths:
        raise FileNotFoundError("No valid long clips found")

    voice_duration = probe_duration(voice)
    body_duration = voice_duration
    total_duration = intro_sec + body_duration + outro_sec
    body_end_cutoff = intro_sec + body_duration  # everything from here on = outro, must stay clean

    output = Path(output_path) if output_path else Path.cwd() / "outputs" / f"final_long_stable_{int(time.time())}.mp4"
    output.parent.mkdir(parents=True, exist_ok=True)
    check_disk_space(output.parent, MIN_FREE_DISK_MB)

    temp = Path(temp_root) if temp_root else output.parent / f"_stable_long_temp_{int(time.time())}"
    seg_dir = temp / "segments"
    batch_dir = temp / "batches"
    seg_dir.mkdir(parents=True, exist_ok=True)
    batch_dir.mkdir(parents=True, exist_ok=True)

    intro = Path(intro_path) if intro_path and Path(intro_path).exists() else None
    outro_path_resolved = Path(outro_path) if outro_path and Path(outro_path).exists() else None
    sub = Path(subscribe_overlay) if subscribe_overlay and Path(subscribe_overlay).exists() else None

    music: Optional[Path] = None
    music_mode = "single_or_none"
    raw_music_candidates: List[Path] = []
    if isinstance(music_path, (list, tuple, set)):
        raw_music_candidates = existing_files(list(music_path), AUDIO_EXTS)
    elif music_path and Path(music_path).is_dir():
        raw_music_candidates = existing_files(list(Path(music_path).glob("*")), AUDIO_EXTS)
    elif music_path and Path(music_path).exists():
        music = Path(music_path)

    if len(raw_music_candidates) >= 2:
        playlist_out = temp / "music_playlist.m4a"
        built = build_music_playlist_file(raw_music_candidates, playlist_out)
        if built is not None:
            music = built
            music_mode = "multi_track_playlist"
        else:
            music = raw_music_candidates[0]
    elif len(raw_music_candidates) == 1:
        music = raw_music_candidates[0]

    sfx = first_existing(sfx_files, AUDIO_EXTS)

    # Phase 5: Pre-render RAM check
    pre_ram = get_ram_percent()
    if pre_ram is not None and pre_ram >= 75.0:
        log(f"[MemorySafe] WARNING: RAM already at {pre_ram:.1f}% before render starts!")
        log("[MemorySafe] Forcing batch_size=1 and pausing 5 seconds for cleanup")
        gc.collect()
        time.sleep(5.0)
        batch_size = 1
    log(f"[StableLong] start | clips={len(clip_paths)} | voice={voice_duration:.2f}s | "
        f"total={total_duration:.2f}s | intro={intro_sec}s | outro={outro_sec}s | "
        f"quality={quality} | captions={add_captions} | batch_size={batch_size} | music_mode={music_mode} | RAM={pre_ram or 'unknown'}%")

    outputs: List[Path] = []
    rendered = 0
    corrupt: List[Dict[str, Any]] = []

    chapter_markers = generate_chapter_markers(body_duration, CHAPTER_INTERVAL_SECONDS)

    word_items_for_pacing: List[Dict[str, Any]] = []
    try:
        word_items_for_pacing = load_caption_words(
            voice, words=words, words_path=words_path, transcript_text=transcript_text,
            total_duration=max(1.0, body_duration),
        )
    except Exception as e:
        log(f"[StableLong] could not pre-load words for pacing/lower-thirds: {e}")

    try:
        if intro:
            intro_out = batch_dir / "batch_000_intro.mp4"
            logo_for_intro = resolve_watermark_path(preset.get("niche", "default"), custom_logo_path)
            normalize_video_asset(intro, intro_out, size, fps, intro_sec, quality, logo_fade_path=logo_for_intro)
            outputs.append(intro_out)

        # ---- Spec #1 + #2: build the sequential, non-overlapping segment
        # queue from ALL uploaded clips, then consume it (with wraparound
        # repeat only after a full pass) to exactly cover body_duration. ----
        render_seed = int(started) % 100000
        pattern = list(_BASE_PACING_PATTERN)
        random.Random(render_seed).shuffle(pattern)

        part_queue = build_clip_part_queue(clip_paths, pattern=pattern, seed=render_seed)
        segments, unique_before_repeat, total_passes = consume_queue_to_duration(part_queue, body_duration)

        if not segments:
            raise RuntimeError("Clip segmentation produced zero usable segments - check input clips")

        # Apply the content-aware pacing bias on top of the segmentation
        # (small, gentle nudge - the primary variety already comes from the
        # sequential non-overlap fix itself).
        bias = _speech_density_bias(word_items_for_pacing, body_duration, len(segments))
        for i, seg in enumerate(segments):
            seg["duration"] = max(0.5, seg["duration"] * bias[i % len(bias)])

        # Re-normalize total duration back to exactly body_duration after
        # applying the bias multipliers (they can drift the sum slightly).
        total_seg_dur = sum(s["duration"] for s in segments)
        if total_seg_dur > 0:
            scale = body_duration / total_seg_dur
            for seg in segments:
                seg["duration"] = max(0.2, seg["duration"] * scale)

        log(f"[ClipSegmentation] queue_parts={len(part_queue)} | segments_used={len(segments)} | "
            f"unique_clips_before_repeat={unique_before_repeat}/{len(clip_paths)} | repeat_passes={total_passes}")

        # Precompute absolute start times (relative to body start) for
        # chapter-boundary + transition-chapter-flag detection.
        abs_starts = []
        acc = 0.0
        for s in segments:
            abs_starts.append(acc)
            acc += s["duration"]

        for start_i, batch in chunked(list(range(len(segments))), batch_size):
            batch_size = ram_guard_batch_size(batch_size)
            ram_soft_pause_if_critical()

            log(f"[StableLong] batch {start_i // batch_size + 1}: segments {start_i + 1}-{start_i + len(batch)}")
            segs: List[Path] = []
            seg_global_indices: List[int] = []
            seg_chapter_flags: List[bool] = []

            for local_i, seg_idx in enumerate(batch):
                seg = segments[seg_idx]
                out_seg = seg_dir / f"seg_{seg_idx + 1:05d}.mp4"
                try:
                    if progress_callback:
                        try:
                            progress_callback(seg_idx + 1, len(segments), str(seg["clip"]))
                        except Exception:
                            pass

                    clip_abs_start = intro_sec + abs_starts[seg_idx]
                    clip_abs_end = clip_abs_start + seg["duration"]
                    punch = is_chapter_boundary_clip(clip_abs_start, clip_abs_end, CHAPTER_INTERVAL_SECONDS)

                    render_clip_segment(
                        seg["clip"], out_seg, seg["start"], seg["duration"], seg["global_index"],
                        size, fps, quality, preset.get("niche", "default"), chapter_punch=punch,
                    )
                    segs.append(out_seg)
                    seg_global_indices.append(seg["global_index"])
                    seg_chapter_flags.append(punch)
                    rendered += 1
                except Exception as e:
                    msg = str(e)[-600:]
                    log(f"[StableLong] skipped corrupt/failed segment (clip={Path(seg['clip']).name}, "
                        f"start={seg['start']:.2f}s, dur={seg['duration']:.2f}s): {msg}")
                    corrupt.append({"clip": str(seg["clip"]), "start": seg["start"], "duration": seg["duration"], "error": msg})
                safe_gc()

            if segs:
                batch_out = batch_dir / f"batch_{start_i // batch_size + 1:04d}.mp4"
                concat_files(segs, batch_out, niche=preset.get("niche", "default"), use_transitions=True,
                             global_indices=seg_global_indices, chapter_flags=seg_chapter_flags)
                outputs.append(batch_out)

            for s in segs:
                try:
                    s.unlink(missing_ok=True)
                except Exception:
                    pass
        # Phase 5: Aggressive post-batch cleanup
        gc.collect()
        time.sleep(1.5)  # Let OS reclaim memory
        # Phase 5: Kill zombie FFmpeg processes
        try:
            import subprocess
            subprocess.run(["taskkill", "/F", "/IM", "ffmpeg.exe", "/FI", "MEMUSAGE gt 200000"],
                          capture_output=True, timeout=5)
        except Exception:
            pass
            safe_gc()

        # ---- Spec #5: outro is now GUARANTEED (uploaded asset or a
        # generated fallback branded end-card) ----
        outro_logo = resolve_watermark_path(preset.get("niche", "default"), custom_logo_path)
        outro_out, outro_asset_type = resolve_outro_segment(
            outro_path_resolved, batch_dir, size, fps, outro_sec, quality,
            niche=preset.get("niche", "default"), logo_path=outro_logo,
        )
        outputs.append(outro_out)

        if not outputs:
            raise RuntimeError("No visual outputs rendered")

        video_raw = temp / "video_raw.mp4"
        concat_files(outputs, video_raw, niche=preset.get("niche", "default"), use_transitions=True,
                     global_indices=list(range(len(outputs))), chapter_flags=[False] * len(outputs))
        safe_gc()

        visual_duration = probe_duration(video_raw)
        if visual_duration < total_duration - .5:
            extended = temp / "video_duration_fixed.mp4"
            log(f"[StableLong] visual shorter ({visual_duration:.2f} < {total_duration:.2f}); LOOPING to match voice duration")
            run_cmd([
                FFMPEG, "-y", "-stream_loop", "-1", "-i", str(video_raw), "-t", f"{total_duration:.3f}",
                "-c:v", "libx264", "-preset", "ultrafast", "-crf", "30", "-pix_fmt", "yuv420p",
                "-threads", "2", str(extended),
            ], timeout=180)
            video_raw = extended
        elif visual_duration > total_duration + .5:
            extended = temp / "video_duration_fixed.mp4"
            log(f"[StableLong] visual longer ({visual_duration:.2f} > {total_duration:.2f}); trimming to match voice")
            run_cmd([
                FFMPEG, "-y", "-i", str(video_raw), "-t", f"{total_duration:.3f}",
                "-c:v", "libx264", "-preset", "ultrafast", "-crf", "30", "-pix_fmt", "yuv420p",
                "-threads", "2", str(extended),
            ], timeout=180)
            video_raw = extended

        current = video_raw

        # ---- Spec #4: reliable subscribe overlay ----
        subscribe_shown = False
        subscribe_actual_duration = 0.0
        if sub:
            with_sub = temp / "video_subscribe.mp4"
            current, subscribe_shown, subscribe_actual_duration = apply_subscribe_overlay_reliable(
                current, sub, with_sub, total_duration, intro_sec, outro_sec,
                duration_seconds=SUBSCRIBE_OVERLAY_DURATION_SECONDS, corner="bottom-right",
            )
            safe_gc()
        else:
            log("[SubscribeOverlay] SKIPPED - reason: no subscribe overlay asset provided for this render")

        broll_out = temp / "video_broll.mp4"
        current = apply_broll_overlay(current, broll_out, body_end_cutoff)
        safe_gc()

        lower_third_events_used = 0
        if word_items_for_pacing:
            lt_out = temp / "video_lowerthirds.mp4"
            current, lower_third_events_used = apply_lower_thirds(
                current, lt_out, word_items_for_pacing, preset.get("niche", "default"), size, body_end_cutoff,
            )
            safe_gc()

        caption_qa_report: Dict[str, Any] = {"verified": False, "reason": "captions_disabled"}
        if add_captions:
            captioned = temp / "video_captioned.mp4"
            # Perf fix: reuse word_items_for_pacing (already computed above,
            # possibly via a multi-minute Whisper pass) instead of letting
            # burn_captions() run Whisper AGAIN from scratch. `words` here
            # takes priority over `words_path`/`transcript_text` inside
            # load_caption_words(), so this reuse is safe and equivalent.
            caption_words_source = words if words else (word_items_for_pacing or None)
            current = burn_captions(
                current, captioned, voice, caption_words_source, words_path, transcript_text,
                caption_mode, style_id, size, voice_offset, preset.get("niche", "default"),
                outro_cutoff=body_end_cutoff,
            )
            safe_gc()
            try:
                caption_qa_report = qa_verify_captions(current)
            except Exception as e:
                caption_qa_report = {"verified": False, "reason": f"qa_exception: {e}"}
        else:
            log("[Captions] Skipped burning captions (add_captions=False) - plain video pass-through for this step")

        # ---- Spec #7: watermark - custom logo priority + time-bounded ----
        wm_out = temp / "video_watermarked.mp4"
        current = apply_niche_watermark(
            current, wm_out, preset.get("niche", "default"),
            custom_logo_path=custom_logo_path, exclude_after_seconds=body_end_cutoff,
        )
        safe_gc()

        final, loudnorm_mode = mux_audio_timeline(
            current, voice, output, music, sfx, total_duration, voice_offset, voice_duration,
            niche=preset.get("niche", "default"), audio_profile=preset.get("audio_profile"),
            chapter_markers=chapter_markers,
        )

        final_loudness = measure_final_audio_loudness(final)

        transition_stats = get_transition_stats()
        total_transitions = max(1, transition_stats["xfade_success"] + transition_stats["xfade_fallback"])
        xfade_success_rate = round(100.0 * transition_stats["xfade_success"] / total_transitions, 1)

        report = {
            "engine": "stable_long_renderer_master_spec_upgrade",
            "clips_input": len(clip_paths),
            "clips_rendered": rendered,
            "corrupt_skipped": corrupt,
            "quality": quality,
            "size": {"width": size[0], "height": size[1], "dar": "16:9"},
            "fps": fps,
            "batch_size": batch_size,
            "voice_duration": voice_duration,
            "intro_seconds": intro_sec,
            "voice_start_offset": voice_offset,
            "outro_seconds": outro_sec,
            "total_duration": total_duration,
            "intro_used": bool(intro),
            "outro_asset_type": outro_asset_type,
            "subscribe_overlay_shown": subscribe_shown,
            "subscribe_overlay_duration_actual": round(subscribe_actual_duration, 2),
            "captions_requested": bool(add_captions),
            "caption_style_id_locked": style_id,
            "caption_qa": caption_qa_report,
            "lower_third_events_used": lower_third_events_used,
            "chapter_markers": chapter_markers,
            "transition_stats": transition_stats,
            "transition_xfade_success_rate_percent": xfade_success_rate,
            "transitions_used": list(_TRANSITIONS_USED_LOG),
            "unique_clips_used_before_repeat": unique_before_repeat,
            "total_clip_repeat_passes": total_passes,
            "segments_rendered_total": len(segments),
            "music_mode": music_mode,
            "music_used": bool(music),
            "sfx_used": bool(sfx),
            "loudnorm_mode": loudnorm_mode,
            "target_lufs": -14,
            "target_lra": TARGET_LRA,
            "final_audio_measured": final_loudness,
            "custom_logo_used": bool(custom_logo_path and is_valid_image_file(custom_logo_path)),
            "hidden_upscale": False,
            "final": str(final),
            "seconds": round(time.time() - started, 2),
        }
        try:
            output.with_suffix(".stable_report.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
        except Exception:
            pass

        log(f"[StableLong] done -> {final}")
        return str(final)

    finally:
        if corrupt:
            try:
                (output.parent / "corrupt_clips_log.json").write_text(json.dumps(corrupt, indent=2), encoding="utf-8")
            except Exception:
                pass
        if cleanup:
            try:
                shutil.rmtree(temp, ignore_errors=True)
            except Exception:
                pass
        safe_gc()


