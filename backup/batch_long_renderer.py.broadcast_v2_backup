# PART 11 — CHAPTER / PATTERN-INTERRUPT ENGINE (bonus, retained, body-bounded)
# =============================================================================

def generate_chapter_markers(body_duration: float, interval: float = CHAPTER_INTERVAL_SECONDS) -> List[Dict[str, Any]]:
    markers = []
    t = 0.0
    idx = 0
    while t < body_duration:
        markers.append({"index": idx, "start_seconds": round(t, 2), "label": f"Chapter {idx + 1}"})
        t += interval
        idx += 1
    return markers


def is_chapter_boundary_clip(clip_start_time: float, clip_end_time: float, interval: float = CHAPTER_INTERVAL_SECONDS) -> bool:
    return int(clip_start_time // interval) != int(max(0.0, clip_end_time - 0.01) // interval)


def find_chapter_sting_file() -> Optional[Path]:
    if not STING_DIR.exists():
        return None
    for ext in (".wav", ".mp3", ".m4a", ".ogg"):
        p = STING_DIR / f"chapter_sting{ext}"
        if p.exists():
            return p
    files = existing_files(list(STING_DIR.glob("*")), AUDIO_EXTS)
    return files[0] if files else None


# =============================================================================
# PART 12 — AUDIO MASTER ENGINE  ***CRITICAL FIX (voice humanization)***
# Spec item #8 (Voice Humanization):
#   ROOT CAUSE (measured): the voice chain ran TWO separate heavy
#   acompressor stages back-to-back (one before the intro-delay, one
#   after), collapsing the measured Loudness Range (LRA) down to ~2.0 -
#   which reads as flat/robotic/fatiguing over a 20+ minute video.
#
#   FIX 1: voice now gets exactly ONE compressor stage (ratio ~2.15,
#          threshold -19dB, attack 9ms, release 105ms) - no second
#          compressor stacked after the delay.
#   FIX 2: the old second stage's "acompressor + equalizer boost" combo is
#          replaced with a SINGLE gentle presence-boost EQ only (no
#          compressor), preserving whatever natural dynamics/micro-variation
#          the upstream voice/TTS engine already produced.
#   FIX 3: loudnorm target LRA moved from 10 (which the old pipeline never
#          actually reached because upstream over-compressed first) to
#          6.5 - solidly inside the requested 4-7 band - and TP tightened
#          -1.0 -> -1.5 for extra headroom.
#   FIX 4: the SAME simplification (drop the redundant second heavy
#          compress+EQ stage) is applied to the music and sfx chains too,
#          since they had the identical copy-pasted double-stage pattern
#          and it served no distinct purpose there either.
#   FIX 5 (measurement): measure_final_audio_loudness() runs a genuine
#          `loudnorm print_format=json` analysis pass over the FINISHED
#          render and reports the actual achieved LUFS/LRA/TP in the
#          render report JSON, satisfying the Spec #8.3 acceptance
#          criteria ("measured LRA via ffmpeg... kam se kam 4.0+ ho").
# =============================================================================

