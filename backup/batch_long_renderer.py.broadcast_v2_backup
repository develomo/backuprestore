# PART 10 — BRANDING / WATERMARK ENGINE  ***CRITICAL FIX***
# Spec item #7 (Logo/Watermark):
#   FIX 1: `custom_logo_path` (an optional UI-uploaded logo) now takes
#          PRIORITY over the niche/default folder lookup.
#   FIX 2: uploaded logo is validated as a real image (Spec #7.2.4) before
#          ever being handed to ffmpeg - an invalid/corrupt upload safely
#          skips the watermark step instead of failing the whole render.
#   FIX 3: size tuned to ~8-10% of frame width (was 12% before), opacity
#          tuned to ~55-65% (was 60% flat before, now default 0.60 sits in
#          range), corner fixed at bottom-right per spec.
#   FIX 4: watermark is now TIME-BOUNDED to stop before the outro begins
#          (`exclude_after_seconds`), so the outro stays clean per Spec
#          #7.2.2 ("outro exclude, sirf outro mein watermark na ho").
# =============================================================================

def resolve_watermark_path(niche: str, custom_logo_path: Optional[str] = None) -> Optional[Path]:
    if custom_logo_path:
        if is_valid_image_file(custom_logo_path):
            return Path(custom_logo_path)
        log(f"[Watermark] custom_logo_path provided but failed validation, ignoring: {custom_logo_path}")

    d = Path("assets/logos").resolve()
    n = str(niche or "default").lower()
    for e in (".png", ".jpg", ".jpeg", ".webp"):
        p = d / f"{n}{e}"
        if p.exists():
            return p
    for e in (".png", ".jpg", ".jpeg", ".webp"):
        p = d / f"default{e}"
        if p.exists():
            return p
    return None


def apply_niche_watermark(v, o, n: str = "default", custom_logo_path: Optional[str] = None,
                           exclude_after_seconds: Optional[float] = None):
    wp = resolve_watermark_path(n, custom_logo_path)
    if not wp:
        log("[Watermark] No logo found (custom upload, niche folder, or default). Skipping.")
        return Path(v)

    enable_expr = ""
    if exclude_after_seconds is not None:
        enable_expr = f":enable='lt(t,{exclude_after_seconds:.3f})'"

    try:
        log(f"[Watermark] Applying logo: {wp} (excluded after {exclude_after_seconds})")
        cmd = [
            FFMPEG, "-y", "-i", str(v), "-i", str(wp),
            "-filter_complex",
            # Fix #3: 9% scale (within 8-10%), 60% opacity (within 55-65%).
            f"[1:v]scale=iw*0.09:-1,format=rgba,colorchannelmixer=aa=0.60[wm];"
            f"[0:v][wm]overlay=W-w-25:H-h-25{enable_expr}",
            "-c:v", "libx264", "-preset", "ultrafast", "-crf", "28", "-pix_fmt", "yuv420p",
            "-threads", "2", "-c:a", "copy", str(o),
        ]
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=90)
        if r.returncode != 0:
            log(f"[Watermark] FFmpeg Error: {r.stderr.decode('utf-8', errors='ignore')[-500:]}")
        if o.exists() and o.stat().st_size > 1000:
            return Path(o)
    except Exception as e:
        log(f"[Watermark] Exception: {e}")
    return Path(v)


def add_logo_overlay_ffmpeg(input_video, output_video, logo_path=None, position: str = "bottom-right",
                             scale: float = 0.09, margin: int = 20):
    """Generic reusable logo overlay helper (kept for any external callers).
    Falls back to a silent copy if logo_path is missing/invalid."""
    input_video = Path(input_video)
    output_video = Path(output_video)
    if not logo_path or not is_valid_image_file(logo_path):
        shutil.copy2(input_video, output_video)
        return output_video

    margin_str = str(margin)
    pos_map = {
        "bottom-right": f"overlay=W-w-{margin_str}:H-h-{margin_str}",
        "top-right": f"overlay=W-w-{margin_str}:{margin_str}",
        "top-left": f"overlay={margin_str}:{margin_str}",
        "bottom-left": f"overlay={margin_str}:H-h-{margin_str}",
        "center": "overlay=(W-w)/2:(H-h)/2",
    }
    overlay_filter = pos_map.get(position, pos_map["bottom-right"])
    scale_filter = f"scale=iw*{scale}"

    cmd = [
        FFMPEG, "-y", "-i", str(input_video), "-i", str(logo_path),
        "-filter_complex", f"[1:v]{scale_filter}[logo];[0:v][logo]{overlay_filter}",
        "-c:a", "copy", "-threads", "2", str(output_video),
    ]
    try:
        subprocess.run(cmd, check=True, capture_output=True, timeout=90)
        return output_video
    except Exception as e:
        log(f"[LogoOverlay] FFmpeg logo overlay failed, using original: {e}")
        shutil.copy2(input_video, output_video)
        return output_video


