def is_auto_caption_style(style_id=None) -> bool:
    s = str(style_id or "").strip().lower()
    return s in {"", "auto", "automatic", "default_auto", "niche_auto", "auto_caption", "caption_auto"}


def caption_style(style_id=None, niche: str = "default") -> Dict[str, Any]:
    if is_auto_caption_style(style_id):
        return caption_profile_for_niche(niche)
    sid = str(style_id or "").lower()
    st = caption_profile_for_niche(niche)
    st["style_id"] = str(style_id)
    if "gold" in sid or "orange" in sid or "luxury" in sid:
        st["primary"] = "&H0000D7FF"
    elif "cyan" in sid or "blue" in sid or "crystal" in sid:
        st["primary"] = "&H00FFF3A7"
    elif "purple" in sid or "violet" in sid or "neon" in sid:
        st["primary"] = "&H00FCABF0"
    elif "green" in sid or "emerald" in sid:
        st["primary"] = "&H0096FF96"
    elif "red" in sid or "ruby" in sid:
        st["primary"] = "&H004040FF"
    elif "yellow" in sid:
        st["primary"] = "&H0000FFFF"
    elif "black" in sid:
        st["primary"] = "&H00000000"
        st["outline"] = "&H00FFFFFF"
    elif "white" in sid or "clean" in sid or "minimal" in sid:
        st["primary"] = "&H00FFFFFF"
    if "small" in sid:
        st["fontsize"] = 30
    elif "large" in sid or "bold" in sid:
        st["fontsize"] = 38
    return st


def clean_caption_word(text) -> str:
    s = str(text or "").strip()
    s = re.sub(r"\s+", " ", s)
    s = re.sub(r"[^\wÀ-ž\u0600-\u06FF\u0900-\u097F'’.,!?-]+", "", s, flags=re.UNICODE)
    return s.strip()


def validate_caption_tokens(tokens) -> List[Dict[str, Any]]:
    out = []
    for t in tokens or []:
        try:
            word = clean_caption_word(t.get("word", ""))
            if not word:
                continue
            letters = re.sub(r"[^A-Za-zÀ-ž]", "", word)
            if len(letters) > 18:
                vowels = len(re.findall(r"[aeiouAEIOUÀ-ž]", letters))
                if vowels < 2:
                    continue
            st = max(0.0, fnum(t.get("start", 0.0)))
            en = max(st + 0.08, fnum(t.get("end", st + 0.35), st + 0.35))
            out.append({"word": word, "start": st, "end": en})
        except Exception:
            pass
    fake = {"warning", "impact", "now", "alert"}
    if out and {x["word"].lower() for x in out}.issubset(fake):
        return []
    return out


def wrap_caption_text(text, max_chars: int = 42) -> str:
    text = str(text or "").strip()
    if len(text) <= max_chars:
        return text
    words = text.split()
    lines = []
    cur = []
    for w in words:
        test = (" ".join(cur + [w])).strip()
        if len(test) > max_chars and cur:
            lines.append(" ".join(cur))
            cur = [w]
        else:
            cur.append(w)
    if cur:
        lines.append(" ".join(cur))
    return "\\N".join(lines[:3])


def write_ass_file(path, segments, size, style_id, caption_offset, niche: str = "default", outro_cutoff: Optional[float] = None):
    path = Path(path)
    w, h = size
    st = caption_style(style_id, niche=niche)
    if style_id and not is_auto_caption_style(style_id):
        st["selected_style_id"] = style_id
    margin_v = max(42, int(h * float(st.get("margin_v_ratio", 0.135))))
    alignment = int(st.get("alignment", 2))
    fontsize = int(st.get("fontsize", 34))
    font = str(st.get("font", "Segoe UI Semibold"))
    max_chars = int(st.get("max_chars", 42))

    lines = [
        "[Script Info]", "ScriptType: v4.00+", f"PlayResX: {w}", f"PlayResY: {h}",
        "ScaledBorderAndShadow: yes", "",
        "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
        f"Style: Default,{font},{fontsize},{st['primary']},&H000000FF,{st['outline']},{st['back']},-1,0,0,0,100,100,0,0,3,2.8,0,{alignment},42,42,{margin_v},1",
        "", "[Events]",
        "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
    ]
    for seg in segments:
        start = max(0.0, fnum(seg.get("start")) + caption_offset - CAPTION_LEAD_SECONDS)
        end = max(start + 0.15, fnum(seg.get("end"), start + 0.5) + caption_offset)
        # Never let a caption spill into the outro window (Spec #5.2.4).
        if outro_cutoff is not None:
            if start >= outro_cutoff:
                continue
            end = min(end, outro_cutoff)
        text = wrap_caption_text(ass_escape(seg.get("text", "")), max_chars=max_chars)
        if text:
            lines.append(f"Dialogue: 0,{ass_time(start)},{ass_time(end)},Default,,0,0,0,,{text}")

    path.write_text("\n".join(lines), encoding="utf-8")
    return path


def burn_captions(video, out, voice_path, words=None, words_path=None, transcript_text=None,
                   caption_mode: str = "phrase", style_id=None, size=(854, 480),
                   caption_offset: float = VOICE_START_OFFSET, niche: str = "default",
                   outro_cutoff: Optional[float] = None):
    video = Path(video)
    out = Path(out)
    total = probe_duration(video)
    word_items = load_caption_words(
        voice_path, words=words, words_path=words_path, transcript_text=transcript_text,
        total_duration=max(1, total - caption_offset - OUTRO_SECONDS),
    )
    segments = group_caption_words(word_items, caption_mode, style_id=style_id, niche=niche)

    if not segments:
        log("[StableLong] no caption segments available - forcing fallback from transcript if present")
        if not transcript_text:
            shutil.copy2(video, out)
            return out
        parts = str(transcript_text).split()
        step = max(0.2, total / max(1, len(parts)))
        segments = [{"start": i * step, "end": (i + 1) * step, "text": p} for i, p in enumerate(parts)]

    ass = out.with_suffix(".ass")
    write_ass_file(ass, segments, size, style_id, caption_offset, niche=niche, outro_cutoff=outro_cutoff)
    ass_filter = str(ass.resolve()).replace("\\", "/").replace(":", "\\:")
    run_cmd([
        FFMPEG, "-y", "-i", str(video), "-vf", f"subtitles='{ass_filter}'",
        "-c:v", "libx264", "-preset", "ultrafast", "-crf", "29", "-pix_fmt", "yuv420p",
        "-threads", "2", "-an", str(out),
    ], timeout=180)
    return out


def qa_verify_captions(video_path, sample_count: int = 8) -> Dict[str, Any]:
    report: Dict[str, Any] = {"verified": False, "checked_frames": 0, "frames_with_text": 0, "reason": None}
    try:
        import pytesseract  # type: ignore
        from PIL import Image  # type: ignore
    except Exception as e:
        report["reason"] = f"ocr_unavailable: {e}"
        return report

    try:
        video_path = Path(video_path)
        total = probe_duration(video_path)
        if total <= 1:
            report["reason"] = "video_too_short"
            return report

        tmp_dir = video_path.parent / f"_caption_qa_{int(time.time())}"
        tmp_dir.mkdir(parents=True, exist_ok=True)
        try:
            step = max(1.0, total / max(1, sample_count + 1))
            frames_with_text = 0
            checked = 0
            for i in range(1, sample_count + 1):
                ts = min(total - 0.2, i * step)
                frame_path = tmp_dir / f"f_{i:02d}.png"
                r = subprocess.run(
                    [FFMPEG, "-y", "-ss", f"{ts:.2f}", "-i", str(video_path), "-frames:v", "1", str(frame_path)],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30,
                )
                if r.returncode != 0 or not frame_path.exists():
                    continue
                checked += 1
                try:
                    img = Image.open(frame_path)
                    w, h = img.size
                    crop = img.crop((0, int(h * 0.72), w, h))
                    text = pytesseract.image_to_string(crop).strip()
                    if len(text) >= 2:
                        frames_with_text += 1
                except Exception:
                    pass
            report["checked_frames"] = checked
            report["frames_with_text"] = frames_with_text
            report["verified"] = checked > 0 and (frames_with_text / max(1, checked)) >= 0.4
        finally:
            shutil.rmtree(tmp_dir, ignore_errors=True)
    except Exception as e:
        report["reason"] = f"qa_error: {e}"
    return report


