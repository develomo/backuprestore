def _lower_third_style(niche: str) -> Dict[str, Any]:
    base = caption_profile_for_niche(niche)
    return {
        "font": base.get("font", "Segoe UI Semibold"),
        "fontsize": max(20, int(base.get("fontsize", 34) * 0.6)),
        "primary": base.get("primary", "&H00FFFFFF"),
        "outline": base.get("outline", "&H00000000"),
        "back": "&HB0000000",
        "alignment": 1,
        "margin_v_ratio": 0.055,
    }


def build_lower_third_events(word_items: List[Dict[str, Any]], niche: str, body_end_cutoff: float,
                              max_events: int = 20) -> List[Dict[str, Any]]:
    keywords = _LOWER_THIRD_KEYWORDS_BY_NICHE.get(str(niche or "default").lower(), {})
    if not keywords or not word_items:
        return []
    events: List[Dict[str, Any]] = []
    last_time = -1e9
    for w in word_items:
        word_lc = str(w.get("word", "")).lower().strip(".,!?")
        if word_lc in keywords:
            st = fnum(w.get("start", 0.0))
            if st + 3.0 >= body_end_cutoff:
                continue  # never let a lower-third spill into the outro
            if st - last_time < LOWER_THIRD_MIN_SPACING_SECONDS:
                continue
            events.append({"start": st, "end": st + 3.0, "text": keywords[word_lc]})
            last_time = st
            if len(events) >= max_events:
                break
    return events


def write_lower_third_ass(path, events: List[Dict[str, Any]], size, niche: str):
    path = Path(path)
    w, h = size
    st = _lower_third_style(niche)
    margin_v = max(20, int(h * float(st["margin_v_ratio"])))
    lines = [
        "[Script Info]", "ScriptType: v4.00+", f"PlayResX: {w}", f"PlayResY: {h}",
        "ScaledBorderAndShadow: yes", "",
        "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
        f"Style: Default,{st['font']},{st['fontsize']},{st['primary']},&H000000FF,{st['outline']},{st['back']},-1,0,0,0,100,100,0,0,3,2.0,0,{st['alignment']},30,30,{margin_v},1",
        "", "[Events]",
        "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
    ]
    for ev in events:
        start = max(0.0, fnum(ev.get("start")))
        end = max(start + 0.5, fnum(ev.get("end"), start + 3.0))
        text = ass_escape(ev.get("text", ""))
        if text:
            lines.append(f"Dialogue: 0,{ass_time(start)},{ass_time(end)},Default,,0,0,0,,{{\\fad(300,300)}}{text}")
    path.write_text("\n".join(lines), encoding="utf-8")
    return path


def apply_lower_thirds(video, out, word_items: List[Dict[str, Any]], niche: str, size, body_end_cutoff: float):
    video = Path(video)
    out = Path(out)
    events = build_lower_third_events(word_items, niche, body_end_cutoff)
    if not events:
        shutil.copy2(video, out)
        return out, 0
    ass = out.with_suffix(".lt.ass")
    write_lower_third_ass(ass, events, size, niche)
    ass_filter = str(ass.resolve()).replace("\\", "/").replace(":", "\\:")
    try:
        run_cmd([
            FFMPEG, "-y", "-i", str(video), "-vf", f"subtitles='{ass_filter}'",
            "-c:v", "libx264", "-preset", "ultrafast", "-crf", "29", "-pix_fmt", "yuv420p",
            "-threads", "2", "-an", str(out),
        ], timeout=180)
        return out, len(events)
    except Exception as e:
        log(f"[LowerThirds] burn failed, skipping: {e}")
        shutil.copy2(video, out)
        return out, 0


