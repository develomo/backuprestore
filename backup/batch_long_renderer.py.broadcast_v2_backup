def run_cmd(cmd: Sequence, label: Optional[str] = None, retries: int = 1, timeout: Optional[int] = None):
    # Spec section 10, rule 1: crash-proof - retries + safe error surfacing.
    if label:
        log(label)
    last_err = ""
    attempts = max(1, int(retries) + 1)
    for attempt in range(1, attempts + 1):
        try:
            r = subprocess.run(
                [str(x) for x in cmd],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                errors="ignore",
                timeout=timeout,
            )
            if r.returncode == 0:
                return r
            last_err = (r.stderr or "")[-6000:]
            if attempt < attempts:
                log(f"[FFmpegRetry] attempt {attempt} failed, retrying... ({last_err[-300:]})")
                safe_gc()
                time.sleep(0.6)
                continue
            raise RuntimeError(last_err)
        except subprocess.TimeoutExpired:
            last_err = f"timeout after {timeout}s"
            if attempt < attempts:
                log(f"[FFmpegRetry] attempt {attempt} timed out, retrying...")
                continue
            raise RuntimeError(last_err)
    raise RuntimeError(last_err or "unknown ffmpeg failure")


def run_cmd_capture(cmd: Sequence, timeout: Optional[int] = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        [str(x) for x in cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, errors="ignore", timeout=timeout,
    )


def probe_duration(path) -> float:
    try:
        r = subprocess.run(
            [FFPROBE, "-v", "error", "-show_entries", "format=duration", "-of", "default=nw=1:nk=1", str(path)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="ignore",
        )
        if r.returncode == 0:
            return max(0.05, float(r.stdout.strip()))
    except Exception:
        pass
    return 6.0


def probe_video_size(path) -> Tuple[int, int]:
    try:
        r = subprocess.run(
            [FFPROBE, "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
             "-of", "csv=s=x:p=0", str(path)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="ignore",
        )
        if r.returncode == 0 and "x" in r.stdout:
            w, h = r.stdout.strip().split("x")[:2]
            return max(1, int(w)), max(1, int(h))
    except Exception:
        pass
    return 854, 480


