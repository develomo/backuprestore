def motion_direction(index: int) -> Tuple[str, str, str]:
    # Spec #3.2.3: pan direction rotates (not always the same fixed pan),
    # mixed with zoom variety so it never feels like "just zoom".
    dirs = [
        ("center_push", "(iw-iw/zoom)/2", "(ih-ih/zoom)/2"),
        ("left_to_right", "(iw-iw/zoom)*0.22", "(ih-ih/zoom)/2"),
        ("right_to_left", "(iw-iw/zoom)*0.78", "(ih-ih/zoom)/2"),
        ("top_to_bottom", "(iw-iw/zoom)/2", "(ih-ih/zoom)*0.22"),
        ("bottom_to_top", "(iw-iw/zoom)/2", "(ih-ih/zoom)*0.78"),
        ("diagonal_soft", "(iw-iw/zoom)*0.30", "(ih-ih/zoom)*0.70"),
        ("diagonal_reverse", "(iw-iw/zoom)*0.70", "(ih-ih/zoom)*0.30"),
    ]
    return dirs[int(index or 0) % len(dirs)]


def _curved_pan_expressions(index: int, total_frames: int) -> Tuple[str, str]:
    _, x0, y0 = motion_direction(index)
    _, x1, y1 = motion_direction(index + 3)
    total_frames = max(2, int(total_frames))
    x_expr = f"(({x0})+((({x1})-({x0}))*(on/{total_frames})))"
    y_expr = f"(({y0})+((({y1})-({y0}))*(on/{total_frames})))"
    return x_expr, y_expr


def make_visual_filter(src, size, index, fps, wanted_duration: float, niche: str = "default",
                        chapter_punch: bool = False) -> str:
    w, h = size
    parts = []
    crop = detect_crop_filter(src)
    if crop:
        parts.append(crop)

    prof = motion_profile_for_niche(niche)
    zmin = float(prof["zoom_min"])
    zmax = float(prof["zoom_max"])
    idx = int(index or 0)

    z = zmin + (idx % 5) * ((zmax - zmin) / 4.0)
    base_step = float(prof["step"])
    rnd = random.Random(1000 + idx)
    step = base_step * rnd.uniform(0.85, 1.15)

    total_frames = max(2, int(round(float(fps) * max(0.5, wanted_duration))))

    zoom_out = (idx % 3 == 2)
    if zoom_out:
        start_z = zmax - ((idx % 3) * 0.001)
        end_z = max(zmin, start_z - (zmax - zmin) * 0.62)
        zoom_expr = f"if(lte(on,2),{start_z:.4f},max({end_z:.4f},zoom-{step:.6f}))"
    else:
        zoom_expr = f"if(lte(on,2),min({z*1.05:.4f},{z:.4f}),min({z:.4f},zoom+{step:.6f}))"

    if chapter_punch:
        punch_target = min(zmax, z * 1.12)
        zoom_expr = f"if(lte(on,7),min({punch_target:.4f},{z*1.02:.4f}+on*{step*3:.6f}),min({z:.4f},zoom+{step:.6f}))"

    x_expr, y_expr = _curved_pan_expressions(idx, total_frames)

    parts += [
        f"scale={w}:{h}:force_original_aspect_ratio=increase",
        f"crop={w}:{h}:exact=1",
        f"zoompan=z='{zoom_expr}':x='{x_expr}':y='{y_expr}':d=1:s={w}x{h}:fps={fps}",
        f"scale={w}:{h}",
        build_color_grade_filter(prof, niche=niche),
        "unsharp=5:5:0.32:5:5:0.0",
        "setsar=1",
        "setdar=16/9",
    ]
    return ",".join(parts)


def render_clip_segment(src, out, start, wanted, index, size, fps, quality, niche: str = "default",
                         chapter_punch: bool = False):
    """
    Spec #1 fix applied here: `start` and `wanted` (duration) are now taken
    DIRECTLY from the segmentation queue (Part 1) - no more scene_start()
    jitter re-computing a different overlapping offset each time.
    """
    src = Path(src)
    out = Path(out)
    crf = "32" if normalize_quality(quality) == "360p" else "29"
    run_cmd([
        FFMPEG, "-y", "-ss", f"{start:.3f}", "-t", f"{wanted:.3f}", "-i", str(src),
        "-an", "-vf", make_visual_filter(src, size, index, fps, wanted, niche=niche, chapter_punch=chapter_punch),
        "-r", str(fps), "-pix_fmt", "yuv420p", "-c:v", "libx264", "-preset", "ultrafast",
        "-crf", crf, "-threads", "2", "-movflags", "+faststart", str(out),
    ], label=None, timeout=180)
    return out


def normalize_video_asset(src, out, size, fps, limit, quality, logo_fade_path: Optional[Path] = None):
    src = Path(src)
    out = Path(out)
    w, h = size
    crf = "32" if normalize_quality(quality) == "360p" else "29"
    base_vf = f"scale={w}:{h}:force_original_aspect_ratio=increase,crop={w}:{h}:exact=1,scale={w}:{h},setsar=1,setdar=16/9"

    if logo_fade_path and Path(logo_fade_path).exists():
        try:
            run_cmd([
                FFMPEG, "-y", "-t", f"{float(limit):.3f}", "-i", str(src),
                "-i", str(logo_fade_path),
                "-an",
                "-filter_complex",
                f"[0:v]{base_vf}[base];"
                f"[1:v]scale=iw*0.16:-1,format=rgba,"
                f"fade=t=in:st=0:d=0.8:alpha=1[logo];"
                f"[base][logo]overlay=(W-w)/2:(H-h)/2:enable='lte(t,1.2)'",
                "-r", str(fps), "-pix_fmt", "yuv420p", "-c:v", "libx264", "-preset", "ultrafast",
                "-crf", crf, "-threads", "2", "-movflags", "+faststart", str(out),
            ], timeout=120)
            return out
        except Exception as e:
            log(f"[AnimatedIntro] logo-fade overlay failed, falling back to plain intro: {e}")

    run_cmd([
        FFMPEG, "-y", "-t", f"{float(limit):.3f}", "-i", str(src), "-an",
        "-vf", base_vf,
        "-r", str(fps), "-pix_fmt", "yuv420p", "-c:v", "libx264", "-preset", "ultrafast",
        "-crf", crf, "-threads", "2", "-movflags", "+faststart", str(out),
    ], timeout=120)
    return out


# =============================================================================
# PART 3 — TRANSITION ENGINE
# Spec item #3 (Transition/Animation Variety):
#   Fix 1: transition pool expanded to 12 clearly distinct types (well over
#          the requested 7-8) - fade, dissolve, smoothleft, smoothright,
#          wipeleft, wiperight, circleopen, circleclose, pixelize, radial,
#          diagbl, diagtr.
#   Fix 2: selection is simple ROUND-ROBIN over a per-niche permutation of
#          that 12-item pool. Because round-robin never repeats an item
#          until the whole pool has been used once, and the pool has 12
#          entries (> the required 10-clip gap), the "no repeat within any
#          10-consecutive window" rule is satisfied by construction - no
#          fragile random-with-history-check logic needed.
#   Fix 3: motion_direction() (Part 2) already rotates through 7 directions
#          and mixes in curved pan paths, satisfying the "not just zoom"
#          requirement.
# =============================================================================

_TRANSITION_POOL_MASTER = [
    "fade", "dissolve", "smoothleft", "smoothright", "wipeleft", "wiperight",
    "circleopen", "circleclose", "pixelize", "radial", "diagbl", "diagtr",
]

assert len(_TRANSITION_POOL_MASTER) >= TRANSITION_REPEAT_GAP, (
    "Transition pool must be at least as large as the required repeat-gap "
    "for the round-robin no-repeat guarantee to hold."
)

_TRANSITION_STATS = {"xfade_success": 0, "xfade_fallback": 0}
_TRANSITIONS_USED_LOG: List[str] = []


def get_transition_stats() -> Dict[str, int]:
    return dict(_TRANSITION_STATS)


def reset_transition_stats() -> None:
    _TRANSITION_STATS["xfade_success"] = 0
    _TRANSITION_STATS["xfade_fallback"] = 0
    _TRANSITIONS_USED_LOG.clear()


def transition_pool_for_niche(niche: str = "default") -> List[str]:
    """Returns a niche-flavoured PERMUTATION of the same master pool (so
    every niche still has the full 12-item, gap-guaranteeing pool, just in
    a different rotation/order for a bit of flavour variety)."""
    n = str(niche or "default").lower()
    offsets = {
        "luxury": 0, "luxury_lifestyle": 0,
        "mystery": 2, "finance": 4, "finance_simulation": 4,
        "ai": 6, "quantum_future": 6,
        "islamic": 8, "home_design": 1, "interior_design": 1, "stoic": 3,
        "default": 0,
    }
    off = offsets.get(n, 0)
    pool = _TRANSITION_POOL_MASTER[off:] + _TRANSITION_POOL_MASTER[:off]
    return pool


def transition_profile_for_niche(niche: str = "default") -> Dict[str, Any]:
    n = str(niche or "default").lower()
    profiles = {
        "luxury": {"duration_base": 0.50},
        "luxury_lifestyle": {"duration_base": 0.50},
        "mystery": {"duration_base": 0.55},
        "ai": {"duration_base": 0.48},
        "quantum_future": {"duration_base": 0.48},
        "finance": {"duration_base": 0.40},
        "finance_simulation": {"duration_base": 0.40},
        "islamic": {"duration_base": 0.52},
        "home_design": {"duration_base": 0.48},
        "interior_design": {"duration_base": 0.48},
        "stoic": {"duration_base": 0.50},
        "default": {"duration_base": 0.46},
    }
    return profiles.get(n, profiles["default"])


def transition_decision(global_index: int, clip_duration: float, niche: str, is_chapter_boundary: bool) -> Dict[str, Any]:
    pool = transition_pool_for_niche(niche)
    prof = transition_profile_for_niche(niche)
    duration_base = float(prof.get("duration_base", 0.46))

    if is_chapter_boundary:
        # A deliberate "reset" cue at chapter boundaries (bonus feature).
        kind = "fade"
        dur = min(1.1, max(0.70, duration_base + 0.30))
    else:
        # Fix #2: pure round-robin over the gap-guaranteeing pool.
        kind = pool[int(global_index or 0) % len(pool)]
        dur = duration_base

    clip_duration = float(clip_duration or 6.0)
    if clip_duration < 3.5:
        dur = min(dur, 0.28)
    elif clip_duration > 8.0:
        dur = min(0.70, dur + 0.10)

    dur = max(0.18, min(0.75, dur))
    _TRANSITIONS_USED_LOG.append(kind)
    return {"transition": kind, "duration": dur, "global_index": int(global_index or 0)}


def concat_files(files, out, niche: str = "default", use_transitions: bool = True,
                  global_indices: Optional[List[int]] = None, chapter_flags: Optional[List[bool]] = None):
    out = Path(out)
    files = [Path(f) for f in files if Path(f).exists()]
    if not files:
        raise RuntimeError("No files to concat")
    if len(files) == 1:
        shutil.copy2(files[0], out)
        return out
    if not use_transitions:
        _TRANSITION_STATS["xfade_fallback"] += 1
        return concat_files_hard(files, out)
    if len(files) > MAX_XFADE_CONCAT_INPUTS:
        # Windows can fail process creation entirely ("WinError 206 - the
        # filename or extension is too long") once the argument list for
        # this many -i flags + a giant -filter_complex string gets long
        # enough. Rather than waste time attempting it and falling back
        # anyway, skip straight to the robust text-file based hard concat
        # for merges this large. Each individual batch was already built
        # WITH xfade transitions internally, so only the top-level "stitch
        # all batches together" join loses crossfades - a reasonable,
        # predictable trade-off instead of an unpredictable crash+retry.
        log(f"[Module2Transition] {len(files)} inputs exceeds safety cap of {MAX_XFADE_CONCAT_INPUTS} "
            f"for a single xfade command - using hard concat directly for this merge")
        _TRANSITION_STATS["xfade_fallback"] += 1
        return concat_files_hard(files, out)
    try:
        result = concat_files_xfade(files, out, niche=niche, global_indices=global_indices, chapter_flags=chapter_flags)
        _TRANSITION_STATS["xfade_success"] += 1
        return result
    except Exception as e:
        _TRANSITION_STATS["xfade_fallback"] += 1
        log(f"[Module2Transition] xfade failed, fallback hard concat: {str(e)[-500:]}")
        return concat_files_hard(files, out)


def concat_files_hard(files, out):
    out = Path(out)
    files = [Path(f) for f in files if Path(f).exists()]
    lf = out.with_suffix(".txt")
    with lf.open("w", encoding="utf-8") as f:
        for p in files:
            fp = str(p.resolve()).replace("\\", "/").replace("'", "'\\''")
            f.write(f"file '{fp}'\n")
    try:
        run_cmd([FFMPEG, "-y", "-f", "concat", "-safe", "0", "-i", str(lf), "-c", "copy", str(out)])
    except Exception:
        run_cmd([FFMPEG, "-y", "-f", "concat", "-safe", "0", "-i", str(lf),
                  "-c:v", "libx264", "-preset", "ultrafast", "-crf", "30", "-pix_fmt", "yuv420p", str(out)])
    try:
        lf.unlink(missing_ok=True)
    except Exception:
        pass
    return out


def concat_files_xfade(files, out, niche: str = "default", global_indices: Optional[List[int]] = None,
                        chapter_flags: Optional[List[bool]] = None):
    out = Path(out)
    files = [Path(f) for f in files if Path(f).exists()]
    durations = [probe_duration(f) for f in files]
    if global_indices is None:
        global_indices = list(range(len(files)))
    if chapter_flags is None:
        chapter_flags = [False] * len(files)

    cmd = [FFMPEG, "-y"]
    for f in files:
        cmd += ["-i", str(f)]

    filters = []
    for i in range(len(files)):
        filters.append(f"[{i}:v]settb=AVTB,setpts=PTS-STARTPTS,fps={DEFAULT_FPS},format=yuv420p[v{i}]")

    current = "[v0]"
    elapsed = durations[0]
    transition_report = []
    for i in range(1, len(files)):
        decision = transition_decision(
            global_index=global_indices[i] if i < len(global_indices) else i,
            clip_duration=durations[i - 1],
            niche=niche,
            is_chapter_boundary=chapter_flags[i] if i < len(chapter_flags) else False,
        )
        tr = decision["transition"]
        dur = float(decision["duration"])
        offset = max(0.05, elapsed - dur)
        out_label = f"[x{i}]"
        filters.append(f"{current}[v{i}]xfade=transition={tr}:duration={dur:.3f}:offset={offset:.3f}{out_label}")
        transition_report.append(decision)
        current = out_label
        elapsed = elapsed + durations[i] - dur

    cmd += [
        "-filter_complex", ";".join(filters),
        "-map", current,
        "-an",
        "-c:v", "libx264",
        "-preset", "ultrafast",
        "-crf", "29",
        "-pix_fmt", "yuv420p",
        "-threads", "2",
        "-movflags", "+faststart",
        str(out),
    ]
    run_cmd(cmd, label=f"[Module2Transition] xfade concat {len(files)} clips -> {out.name}", timeout=240)

    try:
        out.with_suffix(".transitions.json").write_text(json.dumps({
            "module": "Module 2 - Transition Intelligence Engine",
            "niche": niche,
            "input_count": len(files),
            "transitions": transition_report,
            "output": str(out),
        }, indent=2), encoding="utf-8")
    except Exception:
        pass
    return out


