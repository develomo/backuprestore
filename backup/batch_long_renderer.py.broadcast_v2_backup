def log(x) -> None:
    try:
        print(str(x), flush=True)
    except Exception:
        pass


def fnum(x, d: float = 0.0) -> float:
    try:
        return float(x)
    except Exception:
        return float(d)


def inum(x, d: int = 0) -> int:
    try:
        return int(x)
    except Exception:
        return int(d)


def natural_key(path):
    s = Path(path).stem
    out = []
    cur = ""
    for ch in s:
        if ch.isdigit():
            cur += ch
        else:
            if cur:
                out.append((0, int(cur)))
                cur = ""
            out.append((1, ch.lower()))
    if cur:
        out.append((0, int(cur)))
    return out


def existing_files(items, exts=None) -> List[Path]:
    out = []
    for item in items or []:
        try:
            p = Path(item)
            if p.exists() and p.is_file() and (exts is None or p.suffix.lower() in exts):
                out.append(p)
        except Exception:
            pass
    return sorted(out, key=natural_key)


def first_existing(items, exts=None) -> Optional[Path]:
    xs = existing_files(items, exts)
    return xs[0] if xs else None


def get_ram_percent() -> Optional[float]:
    if not _HAS_PSUTIL:
        return None
    try:
        return float(psutil.virtual_memory().percent)
    except Exception:
        return None


def ram_guard_batch_size(requested_batch_size: int) -> int:
    # Spec section 10, rule 2: RAM guard maintained.
    bs = max(1, int(requested_batch_size or DEFAULT_BATCH_SIZE))
    pct = get_ram_percent()
    if pct is None:
        return bs
    if pct >= RAM_CRITICAL_PERCENT:
        log(f"[MemorySafe] RAM CRITICAL ({pct:.1f}%) -> batch_size forced to 1")
        gc.collect()
        return 1
    if pct >= RAM_WARN_PERCENT:
        new_bs = max(1, min(bs, 2))
        if new_bs != bs:
            log(f"[MemorySafe] RAM high ({pct:.1f}%) -> batch_size reduced {bs} -> {new_bs}")
        gc.collect()
        return new_bs
    return bs


def ram_soft_pause_if_critical(sleep_seconds: float = 1.5) -> None:
    pct = get_ram_percent()
    if pct is not None and pct >= RAM_CRITICAL_PERCENT:
        log(f"[MemorySafe] RAM still critical ({pct:.1f}%) -> pausing {sleep_seconds}s")
        gc.collect()
        time.sleep(sleep_seconds)


def check_disk_space(path: Path, min_mb: float = MIN_FREE_DISK_MB) -> None:
    # Spec section 10, rule 3: disk-space check before render starts.
    try:
        usage = shutil.disk_usage(str(path))
        free_mb = usage.free / (1024 * 1024)
        if free_mb < min_mb:
            raise RuntimeError(
                f"[DiskSafe] Low disk space: only {free_mb:.1f}MB free at {path}. "
                f"Need at least {min_mb:.0f}MB. Render aborted to avoid corruption/crash."
            )
    except RuntimeError:
        raise
    except Exception:
        pass


