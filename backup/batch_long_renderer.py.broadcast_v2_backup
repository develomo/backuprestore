def ass_time(sec) -> str:
    sec = max(0.0, fnum(sec))
    h = int(sec // 3600)
    m = int((sec % 3600) // 60)
    s = sec % 60
    return f"{h}:{m:02d}:{s:05.2f}"


def ass_escape(text) -> str:
    return str(text or "").replace("\\", "\\\\").replace("{", "\\{").replace("}", "\\}").replace("\n", " ").strip()


def load_caption_words(voice_path, words=None, words_path=None, transcript_text=None, total_duration: float = 0.0) -> List[Dict[str, Any]]:
    data = words
    if not data and words_path:
        try:
            p = Path(words_path)
            if p.exists():
                data = json.loads(p.read_text(encoding="utf-8", errors="ignore"))
        except Exception:
            data = None
    if isinstance(data, dict):
        data = data.get("words", data.get("segments", []))

    clean = []
    if isinstance(data, list):
        for item in data:
            try:
                if isinstance(item, dict):
                    word = str(item.get("word", item.get("text", ""))).strip()
                    st = fnum(item.get("start", item.get("s", 0.0)))
                    en = fnum(item.get("end", item.get("e", st + .45)), st + .45)
                else:
                    word = str(getattr(item, "word", getattr(item, "text", ""))).strip()
                    st = fnum(getattr(item, "start", 0.0))
                    en = fnum(getattr(item, "end", st + .45), st + .45)
                if word:
                    clean.append({"word": word, "start": max(0, st), "end": max(st + .08, en)})
            except Exception:
                pass

    if not clean and transcript_text:
        parts = [x.strip() for x in str(transcript_text).split() if x.strip()]
        if parts:
            total_duration = max(1.0, fnum(total_duration, len(parts) * .35))
            step = total_duration / max(1, len(parts))
            for i, word in enumerate(parts):
                st = i * step
                clean.append({"word": word, "start": st, "end": st + min(.8, max(.22, step * .9))})

    if not clean and voice_path and Path(voice_path).exists():
        try:
            import whisper
            log("[StableLong] generating captions with Whisper")
            result = whisper.load_model("base").transcribe(str(voice_path), word_timestamps=True, verbose=False)
            for seg in result.get("segments", []) or []:
                for w in seg.get("words", []) or []:
                    word = str(w.get("word", "")).strip()
                    if word:
                        clean.append({"word": word, "start": fnum(w.get("start", 0.0)), "end": fnum(w.get("end", 0.0))})
        except Exception as e:
            log(f"[StableLong] whisper captions failed: {e}")

    fake = {"warning", "impact", "now", "alert"}
    if clean and {x["word"].lower() for x in clean}.issubset(fake):
        log("[StableLong] fake preview captions blocked")
        return []

    clean = validate_caption_tokens(clean)
    clean.sort(key=lambda x: x["start"])
    return clean


def group_caption_words(words, mode: str = "phrase", style_id=None, niche: str = "default") -> List[Dict[str, Any]]:
    words = validate_caption_tokens(words)
    if not words:
        return []
    mode = str(mode or "phrase").lower()
    prof = caption_style(style_id, niche=niche)
    max_words = max(2, min(6, int(prof.get("max_words", 4))))
    max_chars = max(28, min(56, int(prof.get("max_chars", 42))))
    uppercase = bool(prof.get("uppercase", True))

    if mode in {"word_by_word", "word-by-word", "word", "single"}:
        out = []
        for w in words:
            text = str(w["word"]).strip()
            if uppercase:
                text = text.upper()
            out.append({"text": text, "start": w["start"], "end": w["end"]})
        return out

    out = []
    i = 0
    while i < len(words):
        group = []
        chars = 0
        while i < len(words) and len(group) < max_words:
            token = str(words[i]["word"]).strip()
            if not token:
                i += 1
                continue
            if group and chars + len(token) + 1 > max_chars:
                break
            group.append(words[i])
            chars += len(token) + 1
            i += 1
            if token.endswith((".", "?", "!", "…")) and len(group) >= 2:
                break
        if group:
            text = " ".join(x["word"] for x in group).strip()
            if len(text) > max_chars * 2 and len(group) > 2:
                keep = max(2, len(group) - 1)
                overflow_words = group[keep:]
                group = group[:keep]
                i -= len(overflow_words)
                text = " ".join(x["word"] for x in group).strip()
            if uppercase:
                text = text.upper()
            out.append({"text": text, "start": group[0]["start"], "end": max(group[0]["start"] + 0.35, group[-1]["end"])})
        else:
            i += 1
    return out


