def find_lut_for_niche(niche: str) -> Optional[Path]:
    if not LUT_DIR.exists():
        return None
    n = str(niche or "default").lower()
    for candidate in (f"{n}.cube", "default.cube"):
        p = LUT_DIR / candidate
        if p.exists():
            return p
    return None


def build_color_grade_filter(prof: Dict[str, Any], niche: str = "default") -> str:
    tone = str(prof.get("tone", "neutral"))
    parts = [str(prof["grade"])]
    parts.append(_CURVES_BY_TONE.get(tone, _CURVES_BY_TONE["neutral"]))
    parts.append(_COLORBALANCE_BY_TONE.get(tone, _COLORBALANCE_BY_TONE["neutral"]))
    lut = find_lut_for_niche(niche)
    if lut is not None:
        safe_lut = str(lut.resolve()).replace("\\", "/").replace(":", "\\:")
        parts.append(f"lut3d='{safe_lut}'")
    return ",".join(parts)


