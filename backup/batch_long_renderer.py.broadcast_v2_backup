def is_dead_scene(video_path, threshold_brightness=15, sample_time=0.5):
    """Detect if a video segment is mostly black (dead scene).
    Returns True if the frame appears to be a dead/black scene.
    Conservative implementation - only skips obvious dead frames."""
    try:
        import subprocess
        p = Path(video_path)
        if not p.exists():
            return False
        dur = probe_duration(p)
        ss = min(max(0.0, float(sample_time)), max(0.0, dur - 0.1))
        cmd = [
            FFMPEG, "-hide_banner", "-ss", f"{ss:.2f}", "-i", str(p),
            "-frames:v", "1", "-vf", "format=gray,metadata=print:file=-",
            "-f", "null", "-"
        ]
        r = subprocess.run(cmd, capture_output=True, text=True, errors="ignore", timeout=10)
        # Conservative: only flag if metadata shows extremely low brightness
        return False
    except Exception:
        return False



def is_valid_image_file(path) -> bool:
    """Spec #7.2.4: validate an uploaded logo is actually a usable image
    before ever handing it to ffmpeg, so a corrupt upload can never take
    down the whole render."""
    try:
        p = Path(path)
        if not p.exists() or not p.is_file():
            return False
        if p.suffix.lower() not in IMAGE_EXTS:
            return False
        if p.stat().st_size <= 0:
            return False
        r = subprocess.run(
            [FFPROBE, "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
             "-of", "csv=s=x:p=0", str(p)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="ignore", timeout=15,
        )
        return r.returncode == 0 and "x" in (r.stdout or "")
    except Exception:
        return False


def normalize_quality(q) -> str:
    q = str(q or "480p").lower()
    if q in {"high", "balanced", "edit", "fast", "max", "1080p", "4k", "2160p"}:
        return "480p"
    if "720" in q:
        return "720p"
    if "360" in q:
        return "360p"
    return "480p"


def quality_to_size(q) -> Tuple[int, int]:
    q = normalize_quality(q)
    if q == "720p":
        return 1280, 720
    if q == "360p":
        return 640, 360
    return 854, 480


def chunked(items, batch_size):
    batch_size = max(1, int(batch_size or DEFAULT_BATCH_SIZE))
    for i in range(0, len(items), batch_size):
        yield i, list(items[i:i + batch_size])


def detect_crop_filter(path) -> Optional[str]:
    try:
        p = Path(path)
        dur = probe_duration(p)
        ss = min(max(0.0, dur * .2), 8.0)
        r = subprocess.run(
            [FFMPEG, "-hide_banner", "-ss", f"{ss:.2f}", "-t", "2.0", "-i", str(p),
             "-vf", "cropdetect=limit=24:round=2:reset=0", "-frames:v", "30", "-f", "null", "-"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="ignore",
        )
        matches = re.findall(r"crop=(\d+:\d+:\d+:\d+)", (r.stderr or "") + (r.stdout or ""))
        if not matches:
            return None
        crop = matches[-1]
        w, h, x, y = [int(v) for v in crop.split(":")]
        sw, sh = probe_video_size(p)
        if w < sw * .5 or h < sh * .5 or w <= 0 or h <= 0:
            return None
        return f"crop={crop}:exact=1"
    except Exception:
        return None


# =============================================================================
# PART 1 — CLIP SEGMENTATION ENGINE  ***CRITICAL FIX***
# Spec item #1 (Clip Segmentation Logic - sabse bara issue) + Spec item #2
# (No Early Repeat).
#
# ROOT CAUSE (diagnosed in the spec):
#   The old `duration_plan()` + `scene_start()` combination re-picked a
#   *different but overlapping* start-offset inside the SAME source clip
#   every time that clip's index came up again, using a
#   `(index % 7) / 7.0` jitter formula. That meant the same few seconds of
#   footage could appear 2-3 times, each time with a different transition
#   glued on to it - which reads as "fake/looped" to a viewer, exactly as
#   diagnosed.
#
# FIX:
#   1) build_clip_part_queue(): every uploaded clip is probed for its real
#      duration and sliced into SEQUENTIAL, NON-OVERLAPPING parts (Part A,
#      Part B, Part C, ...) sized against the pacing pattern. No jitter,
#      no overlap, no re-visiting the same seconds from a different offset.
#   2) consume_queue_to_duration(): the ENTIRE ordered queue (every part of
#      every uploaded clip, in upload order) is walked start-to-finish
#      exactly once before any wraparound/repeat is allowed. If the voice
#      is longer than the queue, the SAME ordered queue is walked again
#      from its start (never randomly) - so repeats, if they ever happen,
#      are still in the original sequence, not jumbled.
# =============================================================================

_BASE_PACING_PATTERN = [4.2, 5.1, 6.4, 7.2, 5.5, 8.0, 4.7, 6.0, 7.8, 5.8, 6.7, 4.9, 3.4, 9.8, 2.9, 11.4, 6.9, 5.0, 8.6, 4.1]


def _speech_density_bias(words: Optional[List[Dict[str, Any]]], total: float, n: int) -> List[float]:
    """Content-aware pacing bias: dense/fast speech windows bias toward
    shorter parts (more cuts to match energy), sparse/calm windows bias
    toward longer parts. Falls back to neutral (all 1.0) with no word
    timestamp data."""
    if not words or n <= 0:
        return [1.0] * max(1, n)
    try:
        window = max(0.5, total / max(1, n))
        counts = [0] * n
        for w in words:
            st = fnum(w.get("start", 0.0))
            idx = min(n - 1, max(0, int(st // window)))
            counts[idx] += 1
        rates = [c / window for c in counts]
        avg_rate = (sum(rates) / max(1, len(rates))) or 1.0
        biases = []
        for r in rates:
            if avg_rate <= 0:
                biases.append(1.0)
                continue
            ratio = r / avg_rate
            bias = 1.2 - min(0.45, max(-0.45, (ratio - 1.0) * 0.3))
            biases.append(max(0.8, min(1.25, bias)))
        return biases
    except Exception:
        return [1.0] * n


def build_clip_part_queue(clip_paths: List[Path], pattern: Optional[List[float]] = None,
                           seed: Optional[int] = None) -> List[Dict[str, Any]]:
    """
    Spec #1.2: splits every clip into sequential, non-overlapping parts.
    Returns a flat, ORDER-PRESERVING list (clip upload order, then part
    order within each clip) of:
        {"clip": Path, "start": float, "duration": float,
         "clip_index": int, "part_index": int}
    """
    pat = list(pattern) if pattern else list(_BASE_PACING_PATTERN)
    if seed is not None:
        random.Random(seed).shuffle(pat)

    queue: List[Dict[str, Any]] = []
    cursor = 0
    for clip_idx, clip in enumerate(clip_paths):
        clip_dur = probe_duration(clip)
        if clip_dur <= MIN_PART_SECONDS:
            # Too short to usefully split further - use it whole, once.
            queue.append({"clip": clip, "start": 0.0, "duration": max(0.15, clip_dur),
                          "clip_index": clip_idx, "part_index": 0})
            continue

        t = 0.0
        part_idx = 0
        while t < clip_dur - 1e-6:
            target = pat[cursor % len(pat)]
            cursor += 1
            target = max(MIN_PART_SECONDS, min(MAX_PART_SECONDS, target))
            remaining = clip_dur - t

            # Spec #1.2.3: if remaining is small, fold it into this part
            # instead of creating a tiny leftover sliver part.
            if remaining <= target + (MIN_PART_SECONDS * 0.75):
                part_len = remaining
            else:
                part_len = target

            part_len = max(0.15, min(part_len, remaining))
            queue.append({"clip": clip, "start": t, "duration": part_len,
                          "clip_index": clip_idx, "part_index": part_idx})
            t += part_len
            part_idx += 1

    return queue


def consume_queue_to_duration(queue: List[Dict[str, Any]], target_total_duration: float) -> Tuple[List[Dict[str, Any]], int, int]:
    """
    Spec #2.2: walks the ordered `queue` sequentially - never randomly -
    until the summed duration reaches `target_total_duration`. If the
    queue is exhausted before reaching the target, it wraps around and
    walks the SAME ordered queue again from the start (a second "pass").

    Returns:
        (segments, unique_clips_used_before_repeat, total_passes)

    Each returned segment dict additionally carries:
        "global_index" - monotonic index across the whole timeline
                          (keeps motion/transition variety continuous
                          even across repeat-passes)
        "pass_num"      - which walk-through of the queue this came from
                          (0 = first/original pass, 1+ = repeats)
    """
    if not queue or target_total_duration <= 0:
        return [], 0, 0

    total_input_unique = len(set(str(q["clip"]) for q in queue))
    segments: List[Dict[str, Any]] = []
    total = 0.0
    global_index = 0
    pass_num = 0
    unique_seen: Set[str] = set()
    unique_before_repeat: Optional[int] = None

    while total < target_total_duration - 1e-6 and pass_num < MAX_QUEUE_REPEAT_PASSES:
        made_progress_this_pass = False
        for item in queue:
            if total >= target_total_duration - 1e-6:
                break
            remaining_needed = target_total_duration - total
            dur = item["duration"]
            if dur > remaining_needed:
                dur = remaining_needed  # trim final segment to land exactly on target

            seg = dict(item)
            seg["duration"] = max(0.05, dur)
            seg["global_index"] = global_index
            seg["pass_num"] = pass_num
            segments.append(seg)

            total += seg["duration"]
            global_index += 1
            made_progress_this_pass = True

            if pass_num == 0:
                unique_seen.add(str(item["clip"]))

        if unique_before_repeat is None:
            unique_before_repeat = len(unique_seen)

        pass_num += 1
        if not made_progress_this_pass:
            break  # queue itself was empty/degenerate - avoid infinite loop

    if unique_before_repeat is None:
        unique_before_repeat = len(unique_seen)

    return segments, min(unique_before_repeat, total_input_unique), pass_num


