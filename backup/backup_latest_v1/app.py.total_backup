def inject_navbar():
    st.markdown("""
        <style>
        .stApp { margin-top: -50px; }
        .main-nav {
            display: flex;
            justify-content: center;
            background: linear-gradient(90deg, #0f0c29, #302b63, #24243e);
            padding: 15px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            border: 1px solid #444;
        }
        .nav-btn {
            background: none;
            border: none;
            color: white !important;
            font-size: 18px;
            font-weight: 600;
            padding: 10px 25px;
            margin: 0 10px;
            cursor: pointer;
            text-decoration: none;
            transition: 0.3s;
            border-radius: 8px;
        }
        .nav-btn:hover {
            background: rgba(255, 75, 75, 0.2);
            color: #FF4B4B !important;
            transform: translateY(-2px);
        }
        </style>
        <div class="main-nav">
            <div style="color: #FF4B4B; font-weight: 800; font-size: 22px; margin-right: 40px; padding-top: 5px;">
                🚀 CreatorFlow Pro
            </div>
            <a class="nav-btn" href="/?nav=video">🎬 Video Generator</a>
            <a class="nav-btn" href="/?nav=reels">📱 Reels Studio</a>
        </div>
    """, unsafe_allow_html=True)

# URL handling for navigation
query_params = st.query_params
current_nav = query_params.get("nav", "video")

inject_navbar()

if current_nav == "reels":
    st.title("📱 Reels Upload Studio")
    if 'reels_upload_studio_tab' in globals():
        reels_upload_studio_tab()
