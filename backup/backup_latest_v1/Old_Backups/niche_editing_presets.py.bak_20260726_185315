# ============================================================
# PRESET DATA MODEL
# ============================================================

@dataclass
class MotionConfig:
    """Per-clip motion configuration for ONE preset."""
    # Motion directions pool (all 12 available)
    directions: List[str] = field(default_factory=lambda: [
        "center_push", "left_to_right", "right_to_left",
        "top_to_bottom", "bottom_to_top", "diagonal_soft",
        "diagonal_reverse", "static_hold", "slow_pan_left",
        "slow_pan_right", "gentle_float_up", "gentle_float_down"
    ])
    # How many clips before a direction CAN repeat (minimum gap)
    min_repeat_gap: int = 4
    # Zoom intensity range
    zoom_min: float = 1.045
    zoom_max: float = 1.115
    zoom_step: float = 0.00048
    # Whether to sometimes use no motion (static hold for contrast)
    use_static_contrast: bool = True
    static_every_n_clips: int = 7


@dataclass
class TransitionConfig:
    """Per-clip transition configuration for ONE preset."""
    # Available transition types
    types: List[str] = field(default_factory=lambda: [
        "fade", "dissolve", "smoothleft", "smoothright",
        "wipeleft", "wiperight", "wipeup", "wipedown",
        "fadewhite", "fadeblack", "pixelize", "rectcrop",
        "circleopen", "slideright"
    ])
    min_repeat_gap: int = 8
    duration_base: float = 0.34
    duration_range: Tuple[float, float] = (0.12, 0.55)


@dataclass
class CutRhythmConfig:
    """Cut timing configuration for ONE preset."""
    # Short video cut duration ranges (seconds)
    hook_min: float = 1.2
    hook_max: float = 2.2
    body_min: float = 3.5
    body_max: float = 6.5
    emphasis_min: float = 6.0
    emphasis_max: float = 9.0
    # Long video ranges
    long_min: float = 4.2
    long_max: float = 7.8
    # No same duration twice in a row
    anti_pattern: bool = True


@dataclass
class ColorConfig:
    """Color grading configuration for ONE preset."""
    grade_filter: str = "eq=contrast=1.030:saturation=1.020:brightness=0.002"
    temperature_shift: float = 0.0
    vignette_strength: float = 0.0
    film_grain_opacity: float = 0.018
    sharpness: float = 0.08


@dataclass
class AnimationConfig:
    """Animation style pool for ONE preset."""
    styles: List[str] = field(default_factory=lambda: [
        "subtle_zoom_in", "subtle_zoom_out", "slow_push",
        "left_drift", "right_drift", "premium_float",
        "soft_reveal", "documentary_hold"
    ])
    min_repeat_gap: int = 3


@dataclass
class AudioConfig:
    """Audio mix preferences for ONE preset."""
    voice_volume: float = 1.55
    music_volume: float = 0.135
    sfx_volume: float = 0.060
    target_lufs: float = -14.0
    ducking_strength: float = 0.25
    sfx_period_sec: float = 7.5


@dataclass
class EditingPreset:
    """ONE complete editing style preset."""
    preset_id: str = ""           # e.g. "luxury_lifestyle_preset_3"
    preset_number: int = 1        # 1-8
    niche: str = "default"        # parent niche
    label: str = ""               # Human-readable name
    description: str = ""         # What makes this preset unique
    motion: MotionConfig = field(default_factory=MotionConfig)
    transition: TransitionConfig = field(default_factory=TransitionConfig)
    cut_rhythm: CutRhythmConfig = field(default_factory=CutRhythmConfig)
    color: ColorConfig = field(default_factory=ColorConfig)
    animation: AnimationConfig = field(default_factory=AnimationConfig)
    audio: AudioConfig = field(default_factory=AudioConfig)
    # Variation seed offsets per render_count
    variation_seed: int = 0


