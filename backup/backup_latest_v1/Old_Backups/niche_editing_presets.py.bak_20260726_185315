def get_presets_for_niche(niche: str) -> List[EditingPreset]:
    """
    Get all 8 presets for a given niche.

    Args:
        niche: Niche key (e.g. 'luxury_lifestyle', 'quantum_future')
               Can also be 'auto' or any custom niche → maps to 'default'

    Returns:
        List of 8 EditingPreset objects

    Usage:
        presets = get_presets_for_niche("luxury_lifestyle")
        preset_4 = presets[3]  # 0-indexed, so preset #4
    """
    normalized = niche.lower().strip()

    # Map fixed niches
    if normalized in PRESET_REGISTRY:
        return PRESET_REGISTRY[normalized]

    # Map alternative names
    alt_map = {
        "luxury": "luxury_lifestyle",
        "future_tech": "quantum_future",
        "tech": "quantum_future",
        "ai": "quantum_future",
        "stoic": "stoic_wisdom",
        "wisdom": "stoic_wisdom",
        "philosophy": "stoic_wisdom",
        "crime": "mystery",
        "suspense": "mystery",
        "horror": "mystery",
        "interior": "interior_design",
        "home_design": "interior_design",
        "architecture": "interior_design",
        "finance": "finance_simulation",
        "business": "finance_simulation",
        "money": "finance_simulation",
        "stock": "finance_simulation",
        "crypto": "finance_simulation",
        "auto": "default",
    }
    mapped = alt_map.get(normalized, "default")
    return PRESET_REGISTRY[mapped]


def get_preset_by_number(niche: str, preset_number: int) -> EditingPreset:
    """
    Get a specific preset by its number (1-8).

    Args:
        niche: Niche key
        preset_number: 1-8

    Returns:
        Single EditingPreset object
    """
    presets = get_presets_for_niche(niche)
    index = min(max(0, preset_number - 1), len(presets) - 1)
    return presets[index]


def get_preset_with_variation(niche: str, preset_number: int,
                               render_count: int = 0) -> EditingPreset:
    """
    Get a preset with per-render variation applied.

    This ensures even same niche + same preset → slightly different editing
    based on render_count.

    Args:
        niche: Niche key
        preset_number: 1-8
        render_count: Variation counter (increments each render)

    Returns:
        EditingPreset with variation applied
    """
    preset = get_preset_by_number(niche, preset_number)
    varied = deepcopy(preset)

    rng = random.Random(varied.variation_seed + render_count * 13 + preset_number * 7)

    # Slightly vary motion directions order
    rng.shuffle(varied.motion.directions)

    # Slightly vary transition order
    rng.shuffle(varied.transition.types)

    # Slightly vary animation styles
    rng.shuffle(varied.animation.styles)

    # tiny zoom variation (±3%)
    zoom_var = 1.0 + (rng.random() - 0.5) * 0.06
    varied.motion.zoom_min = max(1.01, varied.motion.zoom_min * zoom_var)
    varied.motion.zoom_max = max(varied.motion.zoom_min + 0.02, varied.motion.zoom_max * zoom_var)

    # tiny transition duration variation (±10%)
    dur_var = 1.0 + (rng.random() - 0.5) * 0.20
    varied.transition.duration_base = max(0.12, varied.transition.duration_base * dur_var)

    # tiny cut rhythm variation (±8%)
    cut_var = 1.0 + (rng.random() - 0.5) * 0.16
    varied.cut_rhythm.body_min = max(1.5, varied.cut_rhythm.body_min * cut_var)
    varied.cut_rhythm.body_max = max(varied.cut_rhythm.body_min + 1.0, varied.cut_rhythm.body_max * cut_var)

    # tiny audio variation (±5%)
    audio_var = 1.0 + (rng.random() - 0.5) * 0.10
    varied.audio.music_volume = max(0.03, min(0.30, varied.audio.music_volume * audio_var))
    varied.audio.sfx_volume = max(0.01, min(0.15, varied.audio.sfx_volume * audio_var))

    # Append variation signature
    varied.description += f" [v:{render_count}]"

    return varied


def get_clip_motion(niche: str, preset_number: int, clip_index: int,
                    render_count: int = 0) -> Dict[str, Any]:
    """
    Get motion configuration for a specific clip in a sequence.

    Uses anti-pattern: no same direction within min_repeat_gap clips.

    Returns: dict with zoom_min, zoom_max, step, direction
    """
    preset = get_preset_with_variation(niche, preset_number, render_count)
    m = preset.motion

    # Track recently used directions (for anti-repetition)
    rng = random.Random(m.__hash__() + preset.variation_seed + clip_index * 31 + render_count * 17)

    # Every N clips, use static for contrast
    if m.use_static_contrast and (clip_index > 0 and clip_index % m.static_every_n_clips == 0):
        direction = "static_hold"
    else:
        # Pick a direction, avoiding the last N-1 used
        available = list(m.directions)
        skip = min(m.min_repeat_gap - 1, clip_index)
        if skip > 0 and len(available) > skip:
            # Remove some recently "used" ones (simulated by clip_index)
            for i in range(skip):
                remove_idx = (clip_index - 1 - i) % len(available)
                if len(available) > 2:
                    pass  # Keep diversity
            rng.shuffle(available)
            direction = available[0]
        else:
            direction = rng.choice(available)

    # Map direction name to zoom params
    # Fast directions get slightly more zoom
    fast_dirs = {"diagonal_reverse", "bottom_to_top", "dolly_in", "vertical_whip", "dramatic_push"}
    slow_dirs = {"static_hold", "gentle_sway", "micro_ken_burns", "documentary_hold"}

    zoom_min = m.zoom_min
    zoom_max = m.zoom_max
    if direction in fast_dirs:
        zoom_min *= 1.05
        zoom_max *= 1.05
    elif direction in slow_dirs:
        zoom_min *= 0.92
        zoom_max *= 0.92

    return {
        "zoom_min": round(zoom_min, 4),
        "zoom_max": round(zoom_max, 4),
        "step": round(m.zoom_step, 6),
        "direction": direction,
    }


def get_clip_transition(niche: str, preset_number: int, clip_index: int,
                         render_count: int = 0,
                         absolute_time: float = 0.0) -> Dict[str, Any]:
    """
    Get transition config for a specific clip boundary.

    Anti-pattern: no same transition type within min_repeat_gap clips.
    Every ~150 seconds → chapter transition (stronger).
    """
    preset = get_preset_with_variation(niche, preset_number, render_count)
    t = preset.transition
    rng = random.Random(t.__hash__() + preset.variation_seed + clip_index * 41 + render_count * 19)

    # Chapter transition every ~150 seconds
    is_chapter = (absolute_time > 0 and int(absolute_time) // 150 != int(max(0, absolute_time - 6)) // 150)

    if is_chapter:
        chapter_types = [x for x in t.types if x in ("dissolve", "fadeblack", "fadewhite", "circleopen")]
        trans_type = rng.choice(chapter_types) if chapter_types else rng.choice(t.types)
        duration = t.duration_base + 0.12
    else:
        available = list(t.types)
        rng.shuffle(available)
        trans_type = available[0]
        duration = t.duration_base

    # Vary duration within safe range
    dur_var = 1.0 + (rng.random() - 0.5) * 0.30
    duration = max(t.duration_range[0], min(t.duration_range[1], duration * dur_var))

    return {
        "transition": trans_type,
        "duration": round(duration, 3),
        "index": clip_index,
        "is_chapter": is_chapter,
    }


def get_clip_color_grade(niche: str, preset_number: int,
                          render_count: int = 0) -> Dict[str, Any]:
    """
    Get color grading configuration for a preset.

    Returns full ffmpeg eq filter string + auxiliary params.
    """
    preset = get_preset_with_variation(niche, preset_number, render_count)
    c = preset.color

    # Build complete visual filter for ffmpeg
    filters = [
        c.grade_filter,
        f"unsharp=5:5:{c.sharpness:.2f}:5:5:0.0",
    ]

    # Add vignette if enabled
    if c.vignette_strength > 0:
        filters.append(f"vignette=PI/4:{c.vignette_strength:.3f}")

    return {
        "grade_filter": ",".join(filters),
        "grade_eq_only": c.grade_filter,
        "temperature_shift": c.temperature_shift,
        "vignette": c.vignette_strength,
        "grain": c.film_grain_opacity,
        "sharpness": c.sharpness,
        "unsharp": c.unsharp_filter,
    }


def get_audio_config(niche: str, preset_number: int,
                      render_count: int = 0) -> Dict[str, Any]:
    """
    Get audio mixing configuration for a preset.

    Returns voice/music/sfx volumes + loudness target.
    """
    preset = get_preset_with_variation(niche, preset_number, render_count)
    a = preset.audio

    return {
        "voice_volume": a.voice_volume,
        "music_volume": a.music_volume,
        "sfx_volume": a.sfx_volume,
        "target_lufs": a.target_lufs,
        "ducking_strength": a.ducking_strength,
        "sfx_period_sec": a.sfx_period_sec,
        "voice_highpass": 85,
        "voice_lowpass": 10500,
        "music_highpass": 60,
        "music_lowpass": 12000,
        "compressor_ratio": 2.2,
        "limiter_ceiling": 0.97,
    }


def get_animation_for_clip(niche: str, preset_number: int, clip_index: int,
                            section: str = "body",
                            render_count: int = 0) -> str:
    """
    Get animation style name for a specific clip.

    section = 'hook' | 'body' | 'emphasis' | 'ending'
    """
    preset = get_preset_with_variation(niche, preset_number, render_count)
    a = preset.animation
    rng = random.Random(a.__hash__() + preset.variation_seed + clip_index * 29 + render_count * 23)

    # Hook clips get punchier animations
    if section == "hook":
        hook_pool = [s for s in a.styles if s in (
            "hook_punch", "premium_float", "subtle_zoom_in", "left_drift", "right_drift", "slow_push"
        )]
        if hook_pool:
            return rng.choice(hook_pool)

    # Ending clips get softer animations
    if section in ("ending", "emphasis"):
        end_pool = [s for s in a.styles if s in (
            "soft_reveal", "documentary_hold", "subtle_zoom_out", "slow_push", "premium_float"
        )]
        if end_pool:
            return rng.choice(end_pool)

    # Body clips — use full pool
    available = list(a.styles)
    rng.shuffle(available)
    return available[0]


def get_preset_summary(niche: str, preset_number: int) -> Dict[str, Any]:
    """Get human-readable summary of a preset for UI display."""
    preset = get_preset_by_number(niche, preset_number)
    return {
        "preset_id": preset.preset_id,
        "number": preset.preset_number,
        "niche": preset.niche,
        "niche_display": NICHE_DISPLAY_NAMES.get(preset.niche, preset.niche),
        "label": preset.label,
        "description": preset.description,
        "motion_directions_count": len(preset.motion.directions),
        "transition_types_count": len(preset.transition.types),
        "animation_styles_count": len(preset.animation.styles),
        "cut_rhythm_body": f"{preset.cut_rhythm.body_min:.1f}s–{preset.cut_rhythm.body_max:.1f}s",
        "transition_duration": f"{preset.transition.duration_range[0]:.2f}s–{preset.transition.duration_range[1]:.2f}s",
        "energy": "High" if preset.motion.zoom_max > 1.11 else "Medium" if preset.motion.zoom_max > 1.07 else "Low",
        "voice_forward": preset.audio.voice_volume >= 1.55,
    }


def list_all_presets_for_ui() -> List[Dict[str, Any]]:
    """Generate complete preset list for UI display."""
    result = []
    for niche, presets in PRESET_REGISTRY.items():
        for p in presets:
            result.append({
                "niche": niche,
                "niche_display": NICHE_DISPLAY_NAMES.get(niche, niche),
                "number": p.preset_number,
                "label": p.label,
                "description": p.description,
                "preset_id": p.preset_id,
            })
    return result


def get_motion_filter_for_ffmpeg(niche: str, preset_number: int,
                                   clip_index: int, render_count: int = 0,
                                   video_width: int = 854, video_height: int = 480,
                                   fps: int = 24) -> str:
    """
    Build complete ffmpeg motion+zoom filter string for one clip.

    This is the MAIN function that batch_long_renderer.py should call
    to replace the old motion_profile_for_niche().

    Returns: ffmpeg filter string like "scale=W:H:...,crop=W:H:...,zoompan=..."
    """
    motion = get_clip_motion(niche, preset_number, clip_index, render_count)
    color = get_clip_color_grade(niche, preset_number, render_count)

    w, h = video_width, video_height
    z = motion["zoom_min"]
    step = motion["step"]

    # Direction → x/y expressions for zoompan
    dir_map = {
        "center_push": ("(iw-iw/zoom)/2", "(ih-ih/zoom)/2"),
        "left_to_right": ("(iw-iw/zoom)*0.25", "(ih-ih/zoom)/2"),
        "right_to_left": ("(iw-iw/zoom)*0.75", "(ih-ih/zoom)/2"),
        "top_to_bottom": ("(iw-iw/zoom)/2", "(ih-ih/zoom)*0.25"),
        "bottom_to_top": ("(iw-iw/zoom)/2", "(ih-ih/zoom)*0.75"),
        "diagonal_soft": ("(iw-iw/zoom)*0.35", "(ih-ih/zoom)*0.65"),
        "diagonal_reverse": ("(iw-iw/zoom)*0.65", "(ih-ih/zoom)*0.35"),
        "static_hold": ("(iw-iw/zoom)/2", "(ih-ih/zoom)/2"),
        "slow_pan_left": ("(iw-iw/zoom)*0.60", "(ih-ih/zoom)*0.45"),
        "slow_pan_right": ("(iw-iw/zoom)*0.40", "(ih-ih/zoom)*0.55"),
        "gentle_float_up": ("(iw-iw/zoom)*0.50", "(ih-ih/zoom)*0.45"),
        "gentle_float_down": ("(iw-iw/zoom)*0.50", "(ih-ih/zoom)*0.65"),
    }
    x_expr, y_expr = dir_map.get(motion["direction"], dir_map["center_push"])

    parts = [
        f"scale={w}:{h}:force_original_aspect_ratio=increase",
        f"crop={w}:{h}:exact=1",
        f"zoompan=z='if(lte(on,2),min({z*1.05:.4f},{z:.4f}),min({z:.4f},zoom+{step:.6f}))':x='{x_expr}':y='{y_expr}':d=1:s={w}x{h}:fps={fps}",
        f"scale={w}:{h}",
        color["grade_eq_only"],
        color["unsharp"],
        "setsar=1",
        "setdar=16/9" if w > h else "setdar=9/16",
    ]

    return ",".join(parts)


