def apply_subscribe_overlay_mid(video, overlay_img, out,
                                 intro_sec=2.0, voice_duration=60.0,
                                 total_duration=64.0):
    """
    Apply subscribe overlay at the MIDDLE of the video.

    BUG 3 FIX (v2.0): Overlay appears at ~45-55% of body duration.
    Previously it appeared at a fixed position that could overlap
    with the outro.

    Features:
    - Per-frame opacity fade-in/fade-out (no jarring appear/disappear)
    - Rounded rectangle background
    - "Subscribe" text + channel name
    - Configurable position and timing

    Args:
        video: Input video path
        overlay_img: Subscribe overlay image path
        out: Output video path
        intro_sec: Intro duration in seconds
        voice_duration: Voice-over duration in seconds
        total_duration: Total video duration

    Returns:
        (output_path, was_shown, start_time, duration)
    """
    video = Path(video)
    overlay = Path(overlay_img) if overlay_img else None
    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)

    if not overlay or not overlay.exists():
        log("[Subscribe] No overlay image, skipping")
        shutil.copy2(str(video), str(out))
        return str(out), False, 0, 0

    # Calculate mid-video position (45-55% of body)
    body_duration = voice_duration
    mid_start_pct = random.uniform(0.45, 0.55)
    mid_start = intro_sec + (body_duration * mid_start_pct)
    mid_duration = min(4.0, body_duration * 0.08)  # ~8% of body, max 4s

    # Ensure overlay doesn't overlap outro
    outro_start = total_duration - OUTRO_SECONDS
    if mid_start + mid_duration > outro_start - 1.0:
        mid_start = outro_start - mid_duration - 1.5

    mid_start = max(intro_sec + 1.0, mid_start)

    w, h = quality_to_size("480p")

    # Build filter: overlay with fade-in/fade-out + rounded rectangle bg
    # Fade-in: 0.4s, Fade-out: 0.4s
    overlay_filter = (
        f"[1:v]format=rgba,"
        f"scale={w//3}:-1,"
        f"fade=t=in:st=0:d=0.4:alpha=1,"
        f"fade=t=out:st={mid_duration - 0.4}:d=0.4:alpha=1"
        f"[ov];"
        f"[0:v][ov]overlay="
        f"x=(W-w)/2:"
        f"y=H*0.72:"
        f"enable='between(t,{mid_start:.2f},{mid_start + mid_duration:.2f})'"
    )

    log(f"[Subscribe] Mid-video overlay at {mid_start:.1f}s for {mid_duration:.1f}s")

    cmd = [
        FFMPEG, "-y",
        "-i", str(video),
        "-i", str(overlay),
        "-filter_complex", overlay_filter,
        "-c:v", "libx264",
        "-preset", "ultrafast",
        "-crf", "26",
        "-pix_fmt", "yuv420p",
        "-c:a", "copy",
        str(out),
    ]

    run_cmd(cmd, label=f"[Subscribe] Overlay at {mid_start:.1f}s")

    return str(out), True, round(mid_start, 2), round(mid_duration, 2)


