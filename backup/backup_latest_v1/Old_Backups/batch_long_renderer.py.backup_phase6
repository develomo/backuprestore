def probe_duration(path):
    """
    Get media file duration in seconds using FFprobe.

    Uses FFprobe to read metadata directly, does NOT decode the file.
    Returns 6.0 seconds as safe default if probing fails.
    """
    try:
        r = subprocess.run(
            [FFPROBE, "-v", "error", "-show_entries", "format=duration",
             "-of", "default=nw=1:nk=1", str(path)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, errors="ignore",
            timeout=15,
        )
        if r.returncode == 0:
            val = r.stdout.strip()
            if val.replace(".", "").replace("-", "").isdigit():
                return max(0.05, float(val))
    except Exception:
        pass
    return 6.0


def probe_video_size(path):
    """Get video (width, height) using FFprobe."""
    try:
        r = subprocess.run(
            [FFPROBE, "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height",
             "-of", "csv=p=0", str(path)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, errors="ignore",
            timeout=15,
        )
        if r.returncode == 0:
            parts = r.stdout.strip().split(",")
            if len(parts) >= 2:
                return int(parts[0]), int(parts[1])
    except Exception:
        pass
    return (854, 480)


# ============================================================
# DURATION PLANNER
# ============================================================

def duration_plan(total_duration, scene_count, min_dur=2.5, max_dur=9.5):
    """
    Distribute total duration across scenes using organic variation.

    Each scene gets 2.5s-9.5s with human-like variation (+-20%).
    Sum always equals total_duration (+-0.01 tolerance).

    Algorithm:
    1. Divide total by scene count (average)
    2. Apply random variation to each (+-20%)
    3. Adjust last scene to make sum exact

    Args:
        total_duration: Total body duration in seconds
        scene_count: Number of scenes/clips
        min_dur: Minimum scene duration
        max_dur: Maximum scene duration

    Returns:
        List of scene durations in seconds
    """
    total = fnum(total_duration, 60.0)
    n = max(1, inum(scene_count, 10))

    avg = total / n

    # Generate with +-20% organic variation
    rng = random.Random(total * 1000 + n)
    durations = []
    for i in range(n):
        variation = rng.uniform(-0.20, 0.20)
        d = avg * (1.0 + variation)
        d = max(min_dur, min(max_dur, d))
        durations.append(d)

    # Scale to exact total
    current_sum = sum(durations)
    if current_sum > 0:
        scale = total / current_sum
        durations = [d * scale for d in durations]
        durations = [max(min_dur, min(max_dur, d)) for d in durations]

    # Adjust last element to make sum exact
    current_sum = sum(durations)
    if durations:
        durations[-1] += (total - current_sum)
        durations[-1] = max(min_dur, min(max_dur, durations[-1]))

    return [round(d, 2) for d in durations]


# ============================================================
# BATCH CHUNKER
# ============================================================

def chunked(items, batch_size):
    """
    Split items into batches of up to batch_size.

    Args:
        items: List of items
        batch_size: Max items per batch

    Yields:
        (start_index, batch_items) tuples
    """
    for i in range(0, len(items), batch_size):
        yield i, items[i:i + batch_size]


