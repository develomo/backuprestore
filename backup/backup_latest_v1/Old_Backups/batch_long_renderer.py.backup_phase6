def media_files(search_paths, ext_set=VIDEO_EXTS):
    """
    Discover media files across one or more paths.

    Args:
        search_paths: Single path string or list of paths
        ext_set: Set of allowed extensions

    Returns:
        List of Path objects sorted alphabetically

    Handles:
    - Directories: scans for matching files
    - Single files: returns as-is if valid
    - Mixed list of dirs and files
    """
    if isinstance(search_paths, (str, Path)):
        search_paths = [Path(search_paths)]
    else:
        search_paths = [Path(p) for p in (search_paths or [])]

    out = []
    for p in search_paths:
        try:
            if p.is_dir():
                for f in sorted(p.iterdir()):
                    if f.is_file() and f.suffix.lower() in ext_set:
                        out.append(f)
            elif p.is_file() and p.suffix.lower() in ext_set:
                out.append(p)
        except Exception:
            pass

    return sorted(out, key=lambda x: x.name.lower())


def existing_files(paths, ext_set=VIDEO_EXTS):
    """
    Filter a list of paths to only those that exist and match extension.
    Accepts strings, Path objects, or a mix.
    """
    out = []
    for p in (paths or []):
        try:
            pp = Path(p)
            if pp.exists() and pp.suffix.lower() in ext_set:
                out.append(pp)
        except Exception:
            pass
    return out


def first_existing(paths, ext_set):
    """Return first existing file from a list. Accepts None."""
    for p in (paths or []):
        try:
            pp = Path(p)
            if pp.is_file() and pp.suffix.lower() in ext_set:
                return pp
        except Exception:
            pass
    return None


