TRANSITION_TYPES = {
    "fade":         "fade=t=in:st=0:d={dur},fade=t=out:st={out_start}:d={dur}",
    "fadeblack":    ("fade=t=in:st=0:d={dur}:color=black,"
                     "fade=t=out:st={out_start}:d={dur}:color=black"),
    "fadewhite":    ("fade=t=in:st=0:d={dur}:color=white,"
                     "fade=t=out:st={out_start}:d={dur}:color=white"),
    "dissolve":     "fade=t=in:st=0:d={dur},fade=t=out:st={out_start}:d={dur}",
    "wipeleft":     ("crop=iw*(1-{dur}/t):ih:iw*{dur}/t:0,"
                     "fade=t=out:st={out_start}:d=0.1"),
    "wiperight":    ("crop=iw*(1-{dur}/t):ih:0:0,"
                     "fade=t=out:st={out_start}:d=0.1"),
    "slideleft":    "crop=iw:ih:iw*{dur}/t:0,fade=t=out:st={out_start}:d=0.1",
    "slideright":   ("crop=iw:ih:iw*(1-{dur}/t):0,"
                     "fade=t=out:st={out_start}:d=0.1"),
    "circleopen":   ("geq=r=' hypot(X-(W/2),Y-(H/2)) < {rad} ? "
                     "p(X,Y) : 0':g=' hypot(X-(W/2),Y-(H/2)) < {rad} ? "
                     "p(X,Y) : 0':b=' hypot(X-(W/2),Y-(H/2)) < {rad} ? "
                     "p(X,Y) : 0'"),
    "circclose":    ("geq=r=' hypot(X-(W/2),Y-(H/2)) > {rad} ? "
                     "p(X,Y) : 0':g=' hypot(X-(W/2),Y-(H/2)) > {rad} ? "
                     "p(X,Y) : 0':b=' hypot(X-(W/2),Y-(H/2)) > {rad} ? "
                     "p(X,Y) : 0'"),
    "slideup":      "crop=iw:ih:0:ih*{dur}/t,fade=t=out:st={out_start}:d=0.08",
    "slidedown":    ("crop=iw:ih:0:ih*(1-{dur}/t),"
                     "fade=t=out:st={out_start}:d=0.08"),
}


