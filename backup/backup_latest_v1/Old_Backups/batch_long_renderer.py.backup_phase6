def load_caption_words(voice_path="", words=None, words_path=None,
                       transcript_text=None, total_duration=60.0):
    """
    Load caption words from various sources.

    Priority:
    1. words (direct list)
    2. words_path (JSON file)
    3. transcript_text (plain text, words auto-timed)
    4. voice_path (TTS with word timestamps, not implemented)

    Args:
        voice_path: Path to voice-over audio
        words: Direct list of word dicts [{word, start, end}, ...]
        words_path: Path to JSON word file
        transcript_text: Plain transcript text
        total_duration: Total video duration for auto-timing

    Returns:
        List of word dicts: [{word, start, end}, ...]
    """
    # Source 1: Direct word list
    if words and isinstance(words, list) and len(words) > 0:
        # Block fake preview captions
        word_count = len(words)
        fake_count = sum(
            1 for w in words
            if str(w.get("word", "")).lower().strip() in FAKE_PREVIEW_KEYWORDS
        )

        if fake_count > 0 and fake_count == word_count:
            log(f"[Caption] Blocked {word_count} fake preview caption words")
            return []

        log(f"[Caption] Loaded {len(words)} words from direct list")
        return list(words)

    # Source 2: JSON file
    if words_path and Path(words_path).exists():
        try:
            data = json.loads(Path(words_path).read_text(encoding="utf-8"))
            if isinstance(data, list):
                log(f"[Caption] Loaded {len(data)} words from {words_path}")
                return data
        except Exception as e:
            log(f"[Caption] Failed to load words from {words_path}: {e}")

    # Source 3: Plain transcript text
    if transcript_text and isinstance(transcript_text, str):
        text = transcript_text.strip()
        if text:
            word_list = [w.strip() for w in text.split() if w.strip()]
            if word_list:
                # Auto-time: distribute evenly across total_duration
                dur = float(total_duration)
                word_count = len(word_list)
                time_per_word = dur / max(word_count, 1)

                timed_words = []
                for i, w in enumerate(word_list):
                    timed_words.append({
                        "word": w,
                        "start": round(i * time_per_word, 2),
                        "end": round((i + 1) * time_per_word, 2),
                    })

                log(f"[Caption] Auto-timed {len(timed_words)} words from transcript")
                return timed_words

    return []


def group_caption_words(words, mode="phrase", max_chars=42):
    """
    Group words into display phrases.

    Args:
        words: List of word dicts [{word, start, end}, ...]
        mode: "phrase" (groups of 2-4 words) or "word" (one at a time)
        max_chars: Max characters per phrase line

    Returns:
        List of phrase dicts: [{text, start, end}, ...]
    """
    if not words:
        return []

    if mode == "word":
        return [
            {
                "text": w["word"],
                "start": w.get("start", 0),
                "end": w.get("end", 0),
            }
            for w in words
        ]

    # Phrase mode: group 2-4 words, respecting max_chars
    phrases = []
    current_phrase = []
    current_start = None
    char_count = 0

    for w in words:
        word_text = str(w.get("word", ""))
        word_start = fnum(w.get("start", 0))
        word_end = fnum(w.get("end", 0))

        if current_start is None:
            current_start = word_start

        # Check if adding this word would exceed max_chars
        if current_phrase and (char_count + len(word_text) + 1 > max_chars or
                               len(current_phrase) >= 4):
            # Save current phrase
            phrases.append({
                "text": " ".join(current_phrase),
                "start": round(current_start, 2),
                "end": round(fnum(w.get("end", current_start + 2.0)), 2),
            })
            current_phrase = []
            char_count = 0
            current_start = word_start

        current_phrase.append(word_text)
        char_count += len(word_text) + 1  # +1 for space

    # Don't forget last phrase
    if current_phrase:
        phrases.append({
            "text": " ".join(current_phrase),
            "start": round(current_start, 2),
            "end": round(fnum(words[-1].get("end", current_start + 2.0)), 2),
        })

    return phrases


