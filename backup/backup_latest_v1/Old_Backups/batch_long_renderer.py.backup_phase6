def normalize_quality(q):
    """Normalize quality string to standard preset name."""
    q = str(q or "480p").lower().replace(" ", "")
    mapping = {
        "360": "360p", "360p": "360p",
        "480": "480p", "480p": "480p",
        "540": "540p", "540p": "540p",
        "720": "720p", "720p": "720p",
        "1080": "1080p", "1080p": "1080p",
        "low": "360p",
        "medium": "480p",
        "high": "720p",
    }
    return mapping.get(q, "480p")


def quality_to_size(q):
    """Convert quality string to (width, height) tuple."""
    q = normalize_quality(q)
    sizes = {
        "360p": (640, 360),
        "480p": (854, 480),
        "540p": (960, 540),
        "720p": (1280, 720),
        "1080p": (1920, 1080),
    }
    return sizes.get(q, (854, 480))


