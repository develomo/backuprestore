def normalize_video_asset(src, out, size=(854, 480), fps=24,
                          duration=None, quality="480p"):
    """
    Normalize a video asset to standard format.

    Used for intro, outro, subscribe overlay, and other assets
    that need to match the main video's size, frame rate, and
    pixel format before concatenation.

    PIPELINE:
    1. Scale to target size, preserving aspect ratio and covering
       the full frame (force_original_aspect_ratio=increase)
    2. Crop to the exact target width/height
    3. Lock the frame rate to the project's fps
    4. If an exact duration is requested and the source is shorter,
       clone the last frame (tpad) to fill the remaining time; if
       the source is longer, trim it with -t
    5. Re-encode with consistent codec settings so concat/transition
       stages downstream never choke on mismatched streams

    Args:
        src: Source asset path (e.g. intro.mp4, outro.mp4)
        out: Output path for the normalized asset
        size: (width, height) target output size
        fps: Target frame rate
        duration: Optional exact target duration in seconds. If None,
            the source's natural duration is kept as-is.
        quality: Quality preset, used to pick an appropriate CRF

    Returns:
        Path (str) to the normalized asset
    """
    src = Path(src)
    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)

    w, h = size
    fps = int(fps or DEFAULT_FPS)

    src_dur = probe_duration(str(src))
    target_dur = fnum(duration, src_dur) if duration else None

    vf_parts = [
        f"scale={w}:{h}:force_original_aspect_ratio=increase",
        f"crop={w}:{h}",
        f"fps={fps}",
        "format=yuv420p",
    ]

    # If we need an exact duration and source is shorter, clone last frame
    if target_dur is not None and src_dur < target_dur - 0.05:
        pad_dur = target_dur - src_dur
        vf_parts.append(f"tpad=stop_mode=clone:stop_duration={pad_dur:.3f}")

    vf = ",".join(vf_parts)

    crf_map = {"360p": 29, "480p": 27, "540p": 25, "720p": 23, "1080p": 21}
    crf = crf_map.get(normalize_quality(quality), 27)

    cmd = [
        FFMPEG, "-y",
        "-i", str(src),
        "-vf", vf,
        "-an",
        "-c:v", "libx264",
        "-preset", "ultrafast",
        "-crf", str(crf),
        "-pix_fmt", "yuv420p",
    ]

    # If exact duration requested and source is longer (or equal), trim to it
    if target_dur is not None:
        cmd += ["-t", f"{target_dur:.3f}"]

    cmd += ["-movflags", "+faststart", str(out)]

    run_cmd(cmd, label=f"[NormalizeAsset] {src.name} -> {w}x{h}@{fps}fps"
                       f"{f' dur={target_dur:.1f}s' if target_dur else ''}")

    return str(out)


