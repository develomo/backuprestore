# CONCAT ENGINE (with transition support)
# ============================================================

def concat_files(segments, out, niche="default", use_transitions=True,
                  global_index_offset=0):
    """
    Concatenate multiple video segments with optional transitions.

    Uses FFmpeg concat demuxer for GPU-free joining.
    When use_transitions=True, each segment gets its own transition
    filter applied before concatenation.

    Args:
        segments: List of video file paths
        out: Output path
        niche: Niche name
        use_transitions: Apply transition filters
        global_index_offset: Offset for global clip indexing

    Returns:
        Output path
    """
    segments = [Path(s) for s in segments if Path(s).exists()]

    if not segments:
        raise FileNotFoundError("No segments to concatenate")

    if len(segments) == 1:
        shutil.copy2(str(segments[0]), str(out))
        return str(out)

    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)

    if not use_transitions:
        # Simple concat demuxer
        concat_list = out.with_suffix(".concat.txt")
        with open(concat_list, "w", encoding="utf-8") as f:
            for seg in segments:
                f.write(f"file '{seg.absolute().as_posix()}'\n")

        cmd = [
            FFMPEG, "-y",
            "-f", "concat", "-safe", "0",
            "-i", str(concat_list),
            "-c", "copy",
            "-movflags", "+faststart",
            str(out),
        ]
        run_cmd(cmd, label=f"[Concat] {len(segments)} segments (no transitions)")

        try:
            concat_list.unlink(missing_ok=True)
        except Exception:
            pass

        return str(out)

    # With transitions: render each segment with transition filter
    temp_dir = out.parent / f"_concat_temp_{int(time.time())}"
    temp_dir.mkdir(parents=True, exist_ok=True)

    processed = []
    running_time = 0.0

    for i, seg in enumerate(segments):
        global_i = global_index_offset + i
        dur = probe_duration(str(seg))

        # Last segment gets no transition
        if i == len(segments) - 1:
            processed.append(str(seg))
            break

        # Get transition decision
        decision = transition_decision(
            index=global_i,
            clip_duration=dur,
            niche=niche,
            absolute_time=running_time,
        )

        trans_filter = decision["transition_filter"]
        trans_name = decision["transition"]

        temp_out = temp_dir / f"trans_{i:05d}.mp4"

        cmd = [
            FFMPEG, "-y",
            "-i", str(seg),
            "-vf", trans_filter,
            "-c:v", "libx264",
            "-preset", "ultrafast",
            "-crf", "28",
            "-pix_fmt", "yuv420p",
            "-an",
            str(temp_out),
        ]
        run_cmd(cmd, label=f"[Transition] clip_{global_i} -> {trans_name}")

        processed.append(str(temp_out))
        running_time += dur

    # Concat processed segments
    concat_list = temp_dir / "concat_list.txt"
    with open(concat_list, "w", encoding="utf-8") as f:
        for p in processed:
            f.write(f"file '{Path(p).absolute().as_posix()}'\n")

    cmd = [
        FFMPEG, "-y",
        "-f", "concat", "-safe", "0",
        "-i", str(concat_list),
        "-c", "copy",
        str(out),
    ]
    run_cmd(cmd, label=f"[Concat Final] {len(processed)} segments -> {out.name}")

    # Cleanup
    try:
        shutil.rmtree(temp_dir, ignore_errors=True)
    except Exception:
        pass

    return str(out)


def concat_files_hard(segments, out):
    """
    Hard concat using concat filter (re-encodes).

    This is the FALLBACK when concat demuxer copy fails.
    Re-encodes all segments, slower but more reliable.

    Args:
        segments: List of video file paths
        out: Output path

    Returns:
        Output path
    """
    segments = [Path(s) for s in segments if Path(s).exists()]

    if not segments:
        raise FileNotFoundError("No segments to concatenate")

    if len(segments) == 1:
        shutil.copy2(str(segments[0]), str(out))
        return str(out)

    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)

    cmd = [FFMPEG, "-y"]

    filter_parts = []
    for i, seg in enumerate(segments):
        cmd += ["-i", str(seg)]
        filter_parts.append(f"[{i}:v]")

    concat_filter = "".join(filter_parts) + \
                    f"concat=n={len(segments)}:v=1:a=0[vout]"

    cmd += [
        "-filter_complex", concat_filter,
        "-map", "[vout]",
        "-c:v", "libx264",
        "-preset", "ultrafast",
        "-crf", "26",
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        str(out),
    ]

    run_cmd(cmd, label=f"[ConcatHard] {len(segments)} segments (re-encode)")
    return str(out)


