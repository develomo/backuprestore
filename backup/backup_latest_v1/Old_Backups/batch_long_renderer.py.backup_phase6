def run_cmd(cmd, label=None, timeout=600):
    """
    Run an FFmpeg command safely with error handling.

    Args:
        cmd: Command as list of strings
        label: Optional label for logging
        timeout: Max execution time in seconds

    Returns:
        subprocess.CompletedProcess

    Raises:
        RuntimeError: If command fails
    """
    if label:
        log(label)

    r = subprocess.run(
        [str(x) for x in cmd],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        errors="ignore",
        timeout=timeout,
    )

    if r.returncode != 0:
        error = (r.stderr or "")[-2000:]
        raise RuntimeError(f"FFmpeg failed (rc={r.returncode}): {error}")

    return r


