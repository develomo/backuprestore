# ============================================================
# VARIATION INTELLIGENCE ENGINE - Module 1 Motion Engine
# ============================================================
# v2.0: Each clip gets a UNIQUE combination out of thousands of
# possibilities. The goal is to make EVERY render feel different
# even when using the same config repeatedly.
#
# TOTAL VARIATION SPACE:
# Motion (7) x Animation (7) x Color temp (infinite) x Energy (3)
# x Zoom variance (infinite) x Duration humanization
# = 147+ unique combinations before considering continuous values
# ============================================================

class VariationIntelligence:
    """
    MODULE 1 MOTION ENGINE v2.0

    Combines motion canvas, animation rotation, color temperature,
    energy-based zoom, and organic duration humanization to produce
    unique visual styling for every single clip.

    Anti-repeat guarantees:
    - No 3 consecutive clips share same motion direction
    - No 2 consecutive clips share same animation style
    - No 2 consecutive clips repeat same transition
    """

    # Motion canvas: (x_expression, y_expression)
    # iw = image width, ih = image height
    MOTION_CANVAS = OrderedDict([
        ("center_push",     ("(iw-iw/zoom)/2",              "(ih-ih/zoom)/2")),
        ("top_left_sweep",  ("0",                            "0")),
        ("bottom_right",    ("iw-iw/zoom",                   "ih-ih/zoom")),
        ("left_sweep",      ("0",                            "(ih-ih/zoom)/2")),
        ("right_sweep",     ("iw-iw/zoom",                   "(ih-ih/zoom)/2")),
        ("diagonal",        ("(iw-iw/zoom)*(1+on/200)*0.5",  "(ih-ih/zoom)*(0.5+on/400)")),
        ("bottom_sweep",    ("(iw-iw/zoom)/2",               "ih-ih/zoom")),
        # PHASE 4: 5 NEW MOTION DIRECTIONS (Surgical Addition)
        ("top_right_diag",   ("iw-iw/zoom",                   "0")),
        ("bottom_left_diag", ("0",                            "ih-ih/zoom")),
        ("gentle_float_up",  ("(iw-iw/zoom)*0.35",            "ih*0.15-ih/zoom*0.5")),
        ("gentle_float_down",("(iw-iw/zoom)*0.65",            "ih*0.85-ih/zoom*0.5")),
        ("static_hold",      ("(iw-iw/zoom)/2",               "(ih-ih/zoom)/2")),
    ])

    # Animation rotation: name -> (description, zoom behavior)
    # Subtle variations that change clip feel
    ANIMATION_ROTATION = [
        ("subtle_pulse",     "Gentle breathing zoom"),
        ("slow_crawl",       "Very gradual zoom push"),
        ("hold_then_zoom",   "Static start, zoom hits at 40 percent"),
        ("micro_zoom",       "Minimal zoom, almost static"),
        ("dynamic_push",     "Faster zoom, energetic"),
        ("freeze_frame",     "No zoom at all, static image"),
        ("gentle_ease",      "Smooth ease-in zoom curve"),
    ]

    def __init__(self, seed=None):
        self._seed = seed if seed is not None else random.randint(1, 99999)
        self._rng = random.Random(self._seed)

        # Anti-repeat memory (last decisions)
        self._last_motions = []      # PHASE 4: Extended — Last 4 motion indices
        self._last_animations = []   # Last 2 animation indices
        self._last_transitions = []  # Last 2 transition names

        # Color temperature random walk state
        self._color_temp = 1.0
        self._color_walk_step = 0.018

        # PHASE 4: Store preset info for per-clip variation
        self._preset_number = 1
        self._preset_label = "Style 1"

        log(f"[VarEngine] Initialized. seed={self._seed}, "
            f"motion_pool={len(self.MOTION_CANVAS)}, "
            f"animation_pool={len(self.ANIMATION_ROTATION)}, "
            f"preset={self._preset_number}")

    # ============================================================
    # PHASE 4: PRESET CONFIGURATION (Surgical Addition)
    # ============================================================
    def set_preset(self, preset_number: int = 1, preset_label: str = "Style 1"):
        """Configure variation engine for a specific editing preset."""
        self._preset_number = preset_number
        self._preset_label = preset_label
        # Adjust energy bias based on preset
        if preset_number <= 2:
            self._energy_bias = "low"      # Calm, slow presets
        elif preset_number <= 4:
            self._energy_bias = "medium"   # Balanced
        elif preset_number <= 6:
            self._energy_bias = "high"     # Dynamic
        else:
            self._energy_bias = "extreme"  # Maximum energy
        # Reset walk seeds per preset for variation
        self._color_temp = 1.0 + (preset_number - 4) * 0.02
    # ============================================================

    def pick_motion_direction(self, clip_index, clip_duration):
        """
        Select motion direction with anti-repeat logic.

        Rules:
        - Never repeat the last 3 directions
        - Prefer unused directions from the pool
        - Fallback to random if all excluded
        """
        motion_keys = list(self.MOTION_CANVAS.keys())
        available = [i for i in range(len(motion_keys))
                     if i not in self._last_motions[-3:]]

        if not available:
            available = list(range(len(motion_keys)))

        # Weighted selection: prefer motions not used recently
        weights = []
        for i in range(len(motion_keys)):
            if i in available:
                # Boost weight for motions that are in available pool
                if i not in self._last_motions[-6:]:
                    weights.append(3.0)  # Not used in last 6
                elif i not in self._last_motions[-3:]:
                    weights.append(2.0)  # Not used in last 3
                else:
                    weights.append(1.0)  # In available but recent
            else:
                weights.append(0.0)

        chosen = self._rng.choices(range(len(motion_keys)), weights=weights, k=1)[0]

        self._last_motions.append(chosen)
        if len(self._last_motions) > 6:
            self._last_motions = self._last_motions[-6:]

        x_expr, y_expr = self.MOTION_CANVAS[motion_keys[chosen]]
        return chosen, motion_keys[chosen], x_expr, y_expr

    def pick_animation(self, clip_index, energy):
        """
        Select animation style with anti-repeat.

        Energy affects selection bias:
        - High energy: prefers dynamic_push, subtle_pulse
        - Low energy: prefers freeze_frame, micro_zoom
        """
        total = len(self.ANIMATION_ROTATION)
        available = [i for i in range(total)
                     if i not in self._last_animations[-2:]]

        if not available:
            available = list(range(total))

        # Energy-based weights
        weights = [1.0] * total
        for i in available:
            name = self.ANIMATION_ROTATION[i][0]
            if energy == "high":
                if name in ("dynamic_push", "subtle_pulse"):
                    weights[i] = 3.0
                elif name in ("freeze_frame", "micro_zoom"):
                    weights[i] = 0.3
            elif energy == "low":
                if name in ("freeze_frame", "micro_zoom", "gentle_ease"):
                    weights[i] = 3.0
                elif name in ("dynamic_push",):
                    weights[i] = 0.3

        chosen = self._rng.choices(range(total), weights=weights, k=1)[0]

        self._last_animations.append(chosen)
        if len(self._last_animations) > 4:
            self._last_animations = self._last_animations[-4:]

        return chosen, self.ANIMATION_ROTATION[chosen][0], self.ANIMATION_ROTATION[chosen][1]

    def pick_color_temperature(self):
        """
        Organic color temperature random walk.

        Returns dict with contrast, saturation, brightness offsets.
        Temperature range: 0.90 to 1.10 (cool/warm shift).
        Never repeats exact same temperature twice.
        """
        step = self._color_walk_step
        delta = self._rng.uniform(-step, step)
        self._color_temp = max(0.88, min(1.12, self._color_temp + delta))

        t = self._color_temp
        return {
            "temperature_raw": t,
            "contrast": round(1.0 + (t - 1.0) * 0.4, 4),
            "saturation": round(1.0 + (t - 1.0) * 0.3, 4),
            "brightness": round((t - 1.0) * 0.06, 4),
        }

    def get_energy_level(self, clip_duration_sec, clip_index):
        """
        Derive energy level from clip duration.

        Short clips (<4.0s) = high energy (fast cuts)
        Medium clips (4.0s-7.0s) = medium energy
        Long clips (>7.0s) = low energy (cinematic slow)
        """
        d = float(clip_duration_sec)
        if d < 4.0:
            return "high"
        elif d < 7.0:
            return "medium"
        return "low"

    def get_clip_variation(self, clip_index, clip_duration, base_niche="default"):
        """
        THE MAIN ENTRY POINT - Get complete variation package for one clip.

        Returns dict with ALL variation parameters needed by make_visual_filter.
        Each call produces a UNIQUE combination.

        Args:
            clip_index: Global clip index (0, 1, 2, ...)
            clip_duration: Planned duration in seconds
            base_niche: Niche name for profile selection

        Returns:
            {
                "clip_index": int,
                "energy": "high"|"medium"|"low",
                "motion_direction_index": int,
                "motion_direction_name": str,
                "motion_x_expr": str,
                "motion_y_expr": str,
                "animation_index": int,
                "animation_name": str,
                "animation_description": str,
                "color_temperature": {...},
                "zoom_variance_factor": float,
                "humanized_duration": float,
                "niche": str,
            }
        """
        energy = self.get_energy_level(clip_duration, clip_index)

        mot_idx, mot_name, mot_x, mot_y = self.pick_motion_direction(
            clip_index, clip_duration
        )

        anim_idx, anim_name, anim_desc = self.pick_animation(clip_index, energy)

        color = self.pick_color_temperature()

        # Zoom variance: +-8% organic factor
        zoom_var = round(self._rng.uniform(-0.08, 0.08), 4)

        # Humanized duration: +-12% organic variation
        dur_humanize = round(
            clip_duration * self._rng.uniform(0.88, 1.12), 1
        )
        dur_humanize = max(2.5, min(9.5, dur_humanize))

        return {
            "clip_index": int(clip_index),
            "energy": energy,
            "motion_direction_index": mot_idx,
            "motion_direction_name": mot_name,
            "motion_x_expr": mot_x,
            "motion_y_expr": mot_y,
            "animation_index": anim_idx,
            "animation_name": anim_name,
            "animation_description": anim_desc,
            "color_temperature": color,
            "zoom_variance_factor": zoom_var,
            "humanized_duration": dur_humanize,
            "niche": str(base_niche or "default"),
        }


# Singleton instance
_variation_engine = None
_variation_lock = threading.Lock()


def get_variation_engine(reset=False):
    """Get or create the singleton VariationIntelligence instance."""
    global _variation_engine
    with _variation_lock:
        if reset or _variation_engine is None:
            _variation_engine = VariationIntelligence(seed=random.randint(1, 99999))
        return _variation_engine


# ============================================================
# VISUAL FILTER BUILDER (Core zoom-and-pan engine)
# ============================================================

def make_visual_filter(size=(854, 480), fps=24, duration=5.0,
                       zoom_val=1.07, motion_xy=None, index=0,
                       variation_data=None, niche="default"):
    """
    Build the FFmpeg zoom-and-pan filter graph for one clip.

    This is THE core rendering function. It creates the Ken Burns
    effect with motion direction, animation curve, color grading,
    and all the intelligence from VariationIntelligence.

    FILTER CHAIN:
    1. scale + crop (resize to target, crop to fill)
    2. zoompan (animated Ken Burns zoom-and-pan)
    3. fps (lock frame rate)
    4. format (standardize pixel format)
    5. eq (color temperature adjustment)

    Args:
        size: (width, height) output
        fps: Target frame rate
        duration: Clip duration in seconds
        zoom_val: Zoom multiplier (e.g., 1.07 = 7 percent zoom)
        motion_xy: (x_expr, y_expr) for motion direction
        index: Global clip index
        variation_data: Complete variation package from engine
        niche: Niche name

    Returns:
        FFmpeg filter string ready for -vf argument
    """
    w, h = size
    total_frames = int(duration * fps)

    # Default motion: center push
    x_expr = "(iw-iw/zoom)/2"
    y_expr = "(ih-ih/zoom)/2"

    # Apply variation data if available
    if variation_data:
        x_expr = variation_data.get("motion_x_expr", x_expr)
        y_expr = variation_data.get("motion_y_expr", y_expr)

        # Add zoom variance from variation engine
        zoom_var = variation_data.get("zoom_variance_factor", 0.0)
        zoom_val = zoom_val + zoom_var

    # Override with explicit motion_xy if provided
    if motion_xy and len(motion_xy) == 2:
        x_expr, y_expr = motion_xy

    # Build zoompan filter
    zoompan = (
        f"zoompan=z='zoom+({zoom_val}-1)/{total_frames}*on':"
        f"x='{x_expr}':y='{y_expr}':"
        f"d={total_frames}:s={w}x{h}:fps={fps}"
    )

    # Build full filter chain
    filter_parts = [
        f"scale={w}:{h}:force_original_aspect_ratio=increase",
        f"crop={w}:{h}",
        zoompan,
        f"fps={fps}",
        "format=yuv420p",
    ]

    # Add color temperature adjustment from variation data
    if variation_data and "color_temperature" in variation_data:
        ct = variation_data["color_temperature"]
        eq_parts = []
        if abs(ct.get("contrast", 1.0) - 1.0) > 0.001:
            eq_parts.append(f"contrast={ct['contrast']:.3f}")
        if abs(ct.get("brightness", 0.0)) > 0.001:
            eq_parts.append(f"brightness={ct['brightness']:.3f}")
        if abs(ct.get("saturation", 1.0) - 1.0) > 0.001:
            eq_parts.append(f"saturation={ct['saturation']:.3f}")
        if eq_parts:
            filter_parts.append(f"eq={':'.join(eq_parts)}")

    return ",".join(filter_parts)


# ============================================================
# CLIP SEGMENT RENDERER
# ============================================================

def render_clip_segment(src, out, wanted, index=0,
                        size=(854, 480), fps=24, quality="480p",
                        niche="default", variation_data=None):
    """
    Render a SINGLE clip segment with Ken Burns effect.

    This is the atomic unit of rendering. Every clip in the video
    goes through this function exactly once.

    COMPLETE RENDER PIPELINE FOR ONE CLIP:
    1. Normalize source (resize, pad, framerate)
    2. Select a segment from source (random start position)
    3. Apply zoom-and-pan visual filter
    4. Encode to output

    Args:
        src: Source video path
        out: Output video path
        wanted: Desired clip duration (seconds)
        index: Global clip index for variation
        size: (width, height) output
        fps: Target frame rate
        quality: Quality preset
        niche: Niche name
        variation_data: Complete variation package

    Returns:
        Path to rendered clip
    """
    src = Path(src)
    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)

    wanted = max(1.0, fnum(wanted, 5.0))

    # Apply humanized duration from variation data
    if variation_data and "humanized_duration" in variation_data:
        wanted = fnum(variation_data["humanized_duration"], wanted)

    src_dur = probe_duration(str(src))

    # Get motion profile for niche
    motion_prof = motion_profile_for_niche(niche)
    zoom_min = float(motion_prof["zoom_min"])
    zoom_max = float(motion_prof["zoom_max"])
    base_zoom = float(motion_prof["base_zoom"])

    # Determine start position in source
    if src_dur > wanted + 0.5:
        max_start = max(0, src_dur - wanted - 0.3)
        start = random.uniform(0, max_start)
    else:
        start = 0

    # Build zoom value with energy-based adjustment
    zoom_val = base_zoom
    if variation_data:
        energy = variation_data.get("energy", "medium")
        if energy == "high":
            zoom_val = min(zoom_max, base_zoom + 0.025)
        elif energy == "low":
            zoom_val = max(zoom_min, base_zoom - 0.020)

    # Build visual filter
    vf = make_visual_filter(
        size=size, fps=fps, duration=wanted,
        zoom_val=zoom_val, variation_data=variation_data,
        index=index, niche=niche,
    )

    # CRF quality mapping
    crf_map = {"360p": 29, "480p": 27, "540p": 25, "720p": 23, "1080p": 21}
    crf = crf_map.get(normalize_quality(quality), 27)

    # Build and execute FFmpeg command
    cmd = [
        FFMPEG, "-y",
        "-ss", f"{start:.3f}",
        "-i", str(src),
        "-t", f"{wanted:.3f}",
        "-vf", vf,
        "-an",
        "-c:v", "libx264",
        "-preset", "ultrafast",
        "-crf", str(crf),
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        str(out),
    ]

    run_cmd(cmd, label=f"[RenderClip] number_{index} dur={wanted:.1f}s "
                       f"zoom={zoom_val:.3f} size={size[0]}x{size[1]}")

    return str(out)


