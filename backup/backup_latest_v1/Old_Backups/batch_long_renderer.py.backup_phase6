def build_audio_filter_complex(voice_path, music_path=None, sfx_path=None,
                                total_duration=64.0, intro_sec=2.0,
                                voice_duration=60.0, niche="default",
                                audio_profile=None):
    """
    Build FFmpeg audio filter_complex for mixing.

    Audio pipeline:
    1. Voice: delay + volume + compression + EQ
    2. Music: delay + volume + EQ + ducking (sidechain)
    3. SFX: trim to bursts + volume + EQ
    4. Mix all together
    5. Loudnorm (normalize loudness)

    Args:
        voice_path: Path to voice-over audio
        music_path: Optional background music
        sfx_path: Optional sound effects
        total_duration: Total video duration
        intro_sec: Intro duration
        voice_duration: Voice-over duration
        niche: Niche name
        audio_profile: Custom audio profile (overrides niche)

    Returns:
        FFmpeg filter_complex string
    """
    profile = audio_profile or audio_profile_for_niche(niche)

    voice_vol = profile["voice_volume"]
    music_vol = profile["music_volume"]
    sfx_vol = profile["sfx_volume"]
    highpass = profile["highpass"]
    lowpass = profile["lowpass"]
    comp_ratio = profile["compressor_ratio"]

    filter_parts = []
    inputs_used = []

    # ----- Voice chain (input 1) -----
    voice_chain = (
        f"[1:a]adelay={int(intro_sec * 1000)}|{int(intro_sec * 1000)},"
        f"volume={voice_vol:.2f},"
        f"highpass=f={highpass},"
        f"lowpass=f={lowpass},"
        f"acompressor=ratio={comp_ratio:.1f}:threshold=-18dB:"
        f"attack=5ms:release=100ms:makeup=2dB,"
        f"atrim=0:{total_duration:.2f}"
        f"[voice_out]"
    )
    filter_parts.append(voice_chain)
    inputs_used.append("voice")

    # ----- Music chain (input 2, optional) -----
    if music_path and Path(music_path).exists():
        if profile.get("music_ducking", True):
            # Sidechain ducking: music lowers when voice is active
            music_chain = (
                f"[2:a]volume={music_vol:.2f},"
                f"highpass=f={highpass},"
                f"lowpass=f={lowpass},"
                f"atrim=0:{total_duration:.2f},"
                f"asendcmd=c='0.0 afftdn sn start; "
                f"{total_duration:.2f} afftdn sn stop',"
                f"[music_raw];"
                f"[music_raw][voice_out]sidechaincompress="
                f"threshold=0.003:ratio=8:"
                f"level_sc=0.35:attack=10ms:release=300ms"
                f"[music_out]"
            )
        else:
            # No ducking, just constant music
            music_chain = (
                f"[2:a]volume={music_vol:.2f},"
                f"highpass=f={highpass},"
                f"lowpass=f={lowpass},"
                f"aloop=loop=-1:size=2e+09,"
                f"atrim=0:{total_duration:.2f}"
                f"[music_out]"
            )
        filter_parts.append(music_chain)
        inputs_used.append("music")
    else:
        # Silent music track
        filter_parts.append(
            f"aevalsrc=0:d={total_duration:.2f}:s=44100[music_out]"
        )
        inputs_used.append("silent_music")

    # ----- SFX chain (input 3, optional) -----
    # BUG 5 FIX: SFX as bursts, NOT continuous
    if sfx_path and Path(sfx_path).exists():
        sfx_dur = probe_duration(str(sfx_path))

        # Generate burst schedule (~every 7 seconds)
        burst_times = []
        burst_dur = min(1.5, sfx_dur)
        t = intro_sec + 3.0
        while t < total_duration - 2.0:
            burst_times.append(t)
            t += random.uniform(5.5, 8.5)  # 5.5s-8.5s gap

        # Build burst trim expression
        if burst_times:
            sfx_chain = (
                f"[3:a]volume={sfx_vol:.2f},"
                f"highpass=f={highpass},"
                f"lowpass=f={lowpass}"
                f"[sfx_raw];"
            )

            # Create trim for each burst
            burst_outputs = []
            for bi, bt in enumerate(burst_times):
                sfx_chain += (
                    f"[sfx_raw]atrim={bt:.2f}:{bt + burst_dur:.2f}"
                    f"[sfx_burst_{bi}];"
                )
                burst_outputs.append(f"[sfx_burst_{bi}]")

            # Mix all bursts
            if len(burst_outputs) == 1:
                sfx_chain += f"{burst_outputs[0]}[sfx_out]"
            else:
                mix_inputs = "".join(burst_outputs)
                sfx_chain += f"{mix_inputs}amix=inputs={len(burst_outputs)}:duration=longest[sfx_out]"

            filter_parts.append(sfx_chain)
            inputs_used.append("sfx")

            log(f"[SFX] {len(burst_times)} bursts scheduled "
                f"(every about 7 seconds, each {burst_dur:.1f}s)")
        else:
            filter_parts.append(
                f"aevalsrc=0:d={total_duration:.2f}:s=44100[sfx_out]"
            )
            inputs_used.append("silent_sfx")
    else:
        filter_parts.append(
            f"aevalsrc=0:d={total_duration:.2f}:s=44100[sfx_out]"
        )
        inputs_used.append("silent_sfx")

    # ----- Final mix -----
    mix_part = (
        f"[voice_out][music_out][sfx_out]"
        f"amix=inputs=3:duration=first:dropout_transition=3:"
        f"weights=1 1 1,"
        f"loudnorm=I={profile['target_lufs']:.1f}:LRA=11:TP=-1.5,"
        f"volume=1.2"
        f"[audio_final]"
    )
    filter_parts.append(mix_part)

    full_filter = ";".join(filter_parts)

    return full_filter, inputs_used


def mux_audio_timeline(video, voice, out, music=None, sfx=None,
                        total_duration=64.0, intro_sec=2.0,
                        voice_duration=60.0, niche="default",
                        audio_profile=None):
    """
    Mux the complete audio mix onto the video.

    This is the FINAL AUDIO step - combines everything:
    - Voice-over with niche EQ and compression
    - Background music with optional sidechain ducking
    - SFX transition bursts (BUG 5 FIX)
    - Loudness normalization

    Args:
        video: Silent video path
        voice: Voice-over audio path
        out: Final output path
        music: Optional background music
        sfx: Optional sound effects
        total_duration: Total video duration
        intro_sec: Intro duration
        voice_duration: Voice-over duration
        niche: Niche name
        audio_profile: Custom audio profile

    Returns:
        Output path with mixed audio
    """
    video = Path(video)
    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)

    # Build filter complex
    filter_complex, inputs_used = build_audio_filter_complex(
        voice_path=str(voice),
        music_path=str(music) if music else None,
        sfx_path=str(sfx) if sfx else None,
        total_duration=total_duration,
        intro_sec=intro_sec,
        voice_duration=voice_duration,
        niche=niche,
        audio_profile=audio_profile,
    )

    # Build command
    cmd = [
        FFMPEG, "-y",
        "-i", str(video),
        "-i", str(voice),
    ]

    input_count = 2
    if music and Path(music).exists():
        cmd += ["-i", str(music)]
        input_count += 1
    if sfx and Path(sfx).exists():
        cmd += ["-i", str(sfx)]
        input_count += 1

    cmd += [
        "-filter_complex", filter_complex,
        "-map", "0:v",
        "-map", "[audio_final]",
        "-c:v", "copy",
        "-c:a", "aac",
        "-b:a", "192k",
        "-ar", "44100",
        "-shortest",
        "-movflags", "+faststart",
        str(out),
    ]

    profile = audio_profile or audio_profile_for_niche(niche)
    log(f"[AudioMux] Niche={niche} | Voice={profile['voice_volume']:.1f}x "
        f"| Music={profile['music_volume']:.2f}x "
        f"| SFX={profile['sfx_volume']:.2f}x "
        f"| LUFS={profile['target_lufs']:.1f}")

    run_cmd(cmd, label=f"[AudioMux] Mixing final audio")

    return str(out)


# ============================================================
# MAIN RENDER ORCHESTRATOR - THE BIG ONE
# ============================================================

def render_long_batch_memory(
    voice_path,
    clip_paths,
    output_path,
    quality="480p",
    fps=24,
    batch_size=8,
    niche="default",
    intro_path=None,
    outro_path=None,
    music_path=None,
    sfx_path=None,
    subscribe_overlay=None,
    custom_logo_path=None,
    wm_opacity=0.6,
    add_captions=True,
    caption_mode="phrase",
    words=None,
    words_path=None,
    transcript_text=None,
    use_transitions=True,
    variation_enabled=True,
    intro_seconds=None,
    outro_seconds=None,
    preset_overrides=None,
    progress_callback=None,
    keep_temp=False,
    temp_root=None,
):
    """
    MAIN RENDERING ORCHESTRATOR - Complete pipeline entry point.

    THIS IS THE FUNCTION THAT DOES EVERYTHING.
    It orchestrates the ENTIRE video rendering pipeline:

    STAGES:
    1. PREPARE - Load assets, calculate durations
    2. RENDER CLIPS - Process each clip with Variation Intelligence
    3. CONCATENATE - Join clips with transitions
    4. POST-PRODUCTION - Subscribe overlay, watermark, B-roll
    5. CAPTIONS - Burn captions onto video
    6. AUDIO MIX - Mix voice + music + SFX, normalize loudness
    7. OUTPUT - Write final file

    BUG FIXES (v2.0):
    - BUG 1: Outro rendered as separate segment, NO audio bleed
    - BUG 2: Watermark uses custom_logo_path & wm_opacity
    - BUG 3: Subscribe overlay at correct mid-video position
    - BUG 4: Captions checkbox correctly respected
    - BUG 5: SFX as transition bursts, not continuous

    Args:
        voice_path: Path to voice-over audio file
        clip_paths: List of source video clip paths
        output_path: Path for final output video
        quality: Video quality preset (360p, 480p, or 720p)
        fps: Frame rate
        batch_size: Clips per batch
        niche: Niche/style preset
        intro_path: Optional intro video
        outro_path: Optional outro video
        music_path: Optional background music
        sfx_path: Optional sound effects
        subscribe_overlay: Optional subscribe overlay image
        custom_logo_path: Optional custom watermark logo
        wm_opacity: Watermark opacity (0.0-1.0)
        add_captions: Enable/disable captions
        caption_mode: "phrase" or "word"
        words: Direct word timing list
        words_path: JSON word timing file
        transcript_text: Plain transcript text
        use_transitions: Enable transitions
        variation_enabled: Enable Variation Intelligence
        intro_seconds: Override intro duration
        outro_seconds: Override outro duration
        preset_overrides: Custom overrides dict
        progress_callback: Optional progress callback
        keep_temp: Keep temporary files
        temp_root: Temporary directory root

    Returns:
        Path to final rendered video
    """
    # ================================================================
    # STAGE 1: PREPARE
    # ================================================================
    log("=" * 60)
    log("STAGE 1: PREPARE - Loading assets and calculating durations")
    log("=" * 60)

    start_time = time.time()

    # Quality and size
    quality = normalize_quality(quality)
    size = quality_to_size(quality)
    fps = min(max(12, int(fps or DEFAULT_FPS)), 24)
    batch_size = max(2, min(16, int(batch_size or DEFAULT_BATCH_SIZE)))

    # Timing
    intro_sec = fnum(intro_seconds, INTRO_SECONDS)
    outro_sec = fnum(outro_seconds, OUTRO_SECONDS)

    # Load and validate clips
    clip_paths = existing_files(clip_paths, VIDEO_EXTS)
    if not clip_paths:
        raise FileNotFoundError("No valid clip files found")

    # Validate voice
    voice_path = Path(voice_path)
    if not voice_path.exists():
        raise FileNotFoundError(f"Voice file not found: {voice_path}")

    # Probe voice duration
    voice_duration = probe_duration(str(voice_path))

    # Calculate total duration
    body_duration = voice_duration
    total_duration = intro_sec + body_duration + outro_sec

    # Calculate clip durations
    scene_durations = duration_plan(body_duration, len(clip_paths))

    # Initialize Variation Intelligence
    if variation_enabled:
        var_engine = get_variation_engine(reset=True)
        log(f"[Variation] Engine initialized with seed={var_engine._seed}")
    else:
        log("[Variation] DISABLED - all clips use standard motion")

    # Create temp directory
    if temp_root:
        temp_root = Path(temp_root)
    else:
        temp_root = Path(output_path).parent / f"_render_{int(time.time())}"

    temp_root.mkdir(parents=True, exist_ok=True)
    seg_dir = temp_root / "segments"
    batch_dir = temp_root / "batches"
    seg_dir.mkdir(parents=True, exist_ok=True)
    batch_dir.mkdir(parents=True, exist_ok=True)

    log(f"[Prepare] Clips: {len(clip_paths)} | "
        f"Voice: {voice_duration:.1f}s | "
        f"Total: {total_duration:.1f}s | "
        f"Intro: {intro_sec}s | Outro: {outro_sec}s | "
        f"Quality: {quality} ({size[0]}x{size[1]})")

    # ================================================================
    # STAGE 2: RENDER CLIPS
    # ================================================================
    log("=" * 60)
    log(f"STAGE 2: RENDERING {len(clip_paths)} CLIPS")
    log("=" * 60)

    rendered_segments = []
    corrupt_clips = []

    # Render intro if provided
    if intro_path and Path(intro_path).exists():
        intro_out = batch_dir / "intro.mp4"
        normalize_video_asset(intro_path, intro_out, size, fps, intro_sec, quality)
        rendered_segments.append(intro_out)
        log(f"[Intro] Normalized: {intro_sec}s")

    # Render clips in batches
    for batch_start, batch_clips in chunked(clip_paths, batch_size):
        batch_num = batch_start // batch_size + 1

        log(f"[Batch {batch_num}] Clips {batch_start + 1}-"
            f"{batch_start + len(batch_clips)} of {len(clip_paths)}")

        batch_segments = []

        for local_i, clip_src in enumerate(batch_clips):
            global_i = batch_start + local_i
            seg_out = seg_dir / f"seg_{global_i:05d}.mp4"

            # Get variation data
            variation_data = None
            if variation_enabled:
                variation_data = get_variation_engine().get_clip_variation(
                    clip_index=global_i,
                    clip_duration=scene_durations[global_i],
                    base_niche=niche,
                )

            # Notify progress
            if progress_callback:
                try:
                    progress_callback(global_i + 1, len(clip_paths), str(clip_src))
                except Exception:
                    pass

            # Render the clip
            try:
                render_clip_segment(
                    src=str(clip_src),
                    out=str(seg_out),
                    wanted=scene_durations[global_i],
                    index=global_i,
                    size=size,
                    fps=fps,
                    quality=quality,
                    niche=niche,
                    variation_data=variation_data,
                )
                batch_segments.append(seg_out)

            except Exception as e:
                error_msg = str(e)[-300:]
                log(f"[ERROR] Clip {global_i} FAILED: {error_msg}")
                corrupt_clips.append({
                    "clip_index": global_i,
                    "clip_path": str(clip_src),
                    "error": error_msg,
                })

            gc.collect()

        # Concat batch segments
        if batch_segments:
            batch_out = batch_dir / f"batch_{batch_num:04d}.mp4"
            concat_files(
                batch_segments, batch_out,
                niche=niche,
                use_transitions=use_transitions,
                global_index_offset=batch_start,
            )
            rendered_segments.append(batch_out)

        # Cleanup individual segments
        for s in batch_segments:
            try:
                s.unlink(missing_ok=True)
            except Exception:
                pass

        gc.collect()

    if not rendered_segments:
        raise RuntimeError("No clips were successfully rendered")

    rendered_count = len(clip_paths) - len(corrupt_clips)
    log(f"[Render Complete] {rendered_count}/{len(clip_paths)} clips rendered, "
        f"{len(corrupt_clips)} corrupt skipped")

    # ================================================================
    # STAGE 3: ASSEMBLE
    # ================================================================
    log("=" * 60)
    log("STAGE 3: ASSEMBLE - Concatenating with transitions")
    log("=" * 60)

    # Render outro if provided
    outro_out = None
    if outro_path and Path(outro_path).exists():
        outro_out = batch_dir / "outro.mp4"
        normalize_video_asset(outro_path, outro_out, size, fps, outro_sec, quality)
        log(f"[Outro] Normalized: {outro_sec}s")

    # Concat all segments into body
    body_raw = batch_dir / "body_raw.mp4"
    concat_files(
        rendered_segments, body_raw,
        niche=niche,
        use_transitions=use_transitions,
        global_index_offset=0,
    )

    # BUG 1 FIX: Pad/trim body to exact duration (separate from outro)
    body_actual = probe_duration(str(body_raw))
    body_target = total_duration - outro_sec if outro_out else total_duration

    if abs(body_actual - body_target) > 0.3:
        if body_actual < body_target:
            # Extend by freezing last frame
            pad_dur = body_target - body_actual
            log(f"[Body Fit] Extending by {pad_dur:.1f}s (last frame clone)")
            body_fixed = batch_dir / "body_fixed.mp4"
            run_cmd([
                FFMPEG, "-y",
                "-i", str(body_raw),
                "-vf", f"tpad=stop_mode=clone:stop_duration={pad_dur:.3f},"
                       f"trim=0:{body_target:.3f},setpts=PTS-STARTPTS",
                "-c:v", "libx264",
                "-preset", "ultrafast",
                "-crf", "26",
                "-pix_fmt", "yuv420p",
                "-an",
                str(body_fixed),
            ])
        else:
            # Trim to exact duration
            log(f"[Body Fit] Trimming by {body_actual - body_target:.1f}s")
            body_fixed = batch_dir / "body_fixed.mp4"
            run_cmd([
                FFMPEG, "-y",
                "-i", str(body_raw),
                "-vf", f"trim=0:{body_target:.3f},setpts=PTS-STARTPTS",
                "-c:v", "libx264",
                "-preset", "ultrafast",
                "-crf", "26",
                "-pix_fmt", "yuv420p",
                "-an",
                str(body_fixed),
            ])
    else:
        body_fixed = body_raw

    # BUG 1 FIX: Append outro as SEPARATE segment (no audio bleed)
    if outro_out:
        body_and_outro = batch_dir / "body_with_outro.mp4"
        concat_files_hard([body_fixed, outro_out], body_and_outro)
        body_final = body_and_outro
    else:
        body_final = body_fixed

    # ================================================================
    # STAGE 4: POST-PRODUCTION
    # ================================================================
    log("=" * 60)
    log("STAGE 4: POST-PRODUCTION - Subscribe overlay, watermark, B-roll")
    log("=" * 60)

    post_video = body_final

    # Subscribe overlay (BUG 3 FIX: correct mid position)
    if subscribe_overlay:
        post_sub = batch_dir / "post_sub.mp4"
        apply_subscribe_overlay_mid(
            post_video, subscribe_overlay, post_sub,
            intro_sec=intro_sec,
            voice_duration=voice_duration,
            total_duration=total_duration,
        )
        post_video = post_sub

    # Watermark (BUG 2 FIX: custom logo + opacity)
    post_wm = batch_dir / "post_wm.mp4"
    apply_niche_watermark(
        post_video, post_wm, niche,
        custom_logo_path=custom_logo_path,
        opacity=wm_opacity,
    )
    post_video = post_wm

    # B-roll overlay
    post_broll = batch_dir / "post_broll.mp4"
    apply_broll_overlay(post_video, post_broll, total_duration, niche)
    post_video = post_broll

    # ================================================================
    # STAGE 5: CAPTIONS
    # ================================================================
    log("=" * 60)
    log("STAGE 5: CAPTIONS - Burning captions")
    log("=" * 60)

    if add_captions:
        post_captions = batch_dir / "post_captions.mp4"
        burn_captions(
            post_video, post_captions,
            voice_path=str(voice_path),
            words=words,
            words_path=words_path,
            transcript_text=transcript_text,
            caption_mode=caption_mode,
            size=size,
            caption_offset=intro_sec,
            niche=niche,
        )
        post_video = post_captions
    else:
        log("[Caption] DISABLED per config")

    # ================================================================
    # STAGE 6: AUDIO MIX
    # ================================================================
    log("=" * 60)
    log("STAGE 6: AUDIO MIX - Voice + Music + SFX (BUG 5: burst mode)")
    log("=" * 60)

    final_out = Path(output_path)
    final_out.parent.mkdir(parents=True, exist_ok=True)

    mux_audio_timeline(
        post_video, voice_path, final_out,
        music=music_path,
        sfx=sfx_path,
        total_duration=total_duration,
        intro_sec=intro_sec,
        voice_duration=voice_duration,
        niche=niche,
    )

    # ================================================================
    # STAGE 7: CLEANUP
    # ================================================================
    log("=" * 60)
    log("STAGE 7: FINALIZE")
    log("=" * 60)

    elapsed = time.time() - start_time
    corrupt_count = len(corrupt_clips)

    log(f"[COMPLETE] Output: {final_out}")
    log(f"[COMPLETE] Duration: {total_duration:.1f}s | "
        f"Clips: {rendered_count}/{len(clip_paths)} | "
        f"Skipped: {corrupt_count} | "
        f"Time: {elapsed:.0f}s ({elapsed/60:.1f}min)")

    if corrupt_clips:
        log(f"[WARNING] {corrupt_count} clip(s) were skipped:")
        for cc in corrupt_clips[:5]:
            log(f"  - Clip #{cc['clip_index']}: {Path(cc['clip_path']).name}: {cc['error']}")

    # Cleanup temp files
    if not keep_temp:
        try:
            shutil.rmtree(temp_root, ignore_errors=True)
            log("[Cleanup] Temp directory removed")
        except Exception as e:
            log(f"[Cleanup] Could not remove temp: {e}")

    return str(final_out)