def build_caption_drawtext(phrase, profile, video_width=854, video_height=480):
    """
    Build a single drawtext filter for a caption phrase.

    Args:
        phrase: {text, start, end}
        profile: Caption style profile
        video_width: Video width in pixels
        video_height: Video height in pixels

    Returns:
        FFmpeg drawtext filter string
    """
    font_size = profile["font_size"]
    font_color = profile["font_color"]
    border_color = profile["border_color"]
    shadow_color = profile["shadow_color"]
    bg_color = profile["bg_color"]
    alignment = profile["alignment"]
    y_pos = profile["vertical_position"]

    # Escape special characters in text
    safe_text = phrase["text"].replace("'", "\\'").replace(":", "\\:").replace("%", "\\%")

    # Build x position based on alignment
    if alignment == "center":
        x_expr = "(w-text_w)/2"
    elif alignment == "left":
        x_expr = "20"
    else:
        x_expr = "(w-text_w)-20"

    # Calculate max text width (80% of video width)
    max_text_w = int(video_width * 0.80)

    drawtext = (
        f"drawtext=text='{safe_text}':"
        f"fontsize={font_size}:"
        f"fontcolor={font_color}:"
        f"bordercolor={border_color}:borderw=2.5:"
        f"shadowcolor={shadow_color}:shadowx=2:shadowy=2:"
        f"box=1:boxcolor={bg_color}:boxborderw=10:"
        f"x={x_expr}:y={y_pos}:"
        f"enable='between(t,{phrase['start']},{phrase['end']})':"
        f"fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
    )

    return drawtext


def burn_captions(video, out, voice_path="", words=None,
                  words_path=None, transcript_text=None,
                  caption_mode="phrase", style_id=None,
                  size=(854, 480), caption_offset=2.0,
                  niche="default"):
    """
    Burn captions onto video using FFmpeg drawtext.

    This is the MAIN caption rendering function. It:
    1. Loads words from best available source
    2. Groups words into phrases
    3. Builds per-phrase drawtext filters
    4. Burns all captions onto video in one pass

    Args:
        video: Input video path
        out: Output video path
        voice_path: Voice-over path (for timing reference)
        words: Direct word list
        words_path: JSON word timing file
        transcript_text: Plain text transcript
        caption_mode: "phrase" or "word"
        style_id: Optional custom style ID
        size: Video (width, height)
        caption_offset: Seconds to delay caption start
        niche: Niche name

    Returns:
        Path to video with captions burned in
    """
    video = Path(video)
    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)

    # Load caption words
    word_list = load_caption_words(
        voice_path=str(voice_path),
        words=words,
        words_path=words_path,
        transcript_text=transcript_text,
    )

    if not word_list:
        log("[Caption] No caption words found, copying video as-is")
        shutil.copy2(str(video), str(out))
        return str(out)

    # Adjust timing for caption offset
    for w in word_list:
        w["start"] = fnum(w.get("start", 0)) + caption_offset
        w["end"] = fnum(w.get("end", 0)) + caption_offset

    # Group into phrases
    phrases = group_caption_words(word_list, mode=caption_mode)

    if not phrases:
        log("[Caption] No phrases generated, copying video as-is")
        shutil.copy2(str(video), str(out))
        return str(out)

    # Get caption profile
    profile = caption_profile_for_niche(niche)

    # Build drawtext filters
    drawtext_filters = []
    for phrase in phrases:
        dt = build_caption_drawtext(
            phrase, profile,
            video_width=size[0],
            video_height=size[1],
        )
        drawtext_filters.append(dt)

    # Combine all drawtext into one filter chain
    combined_filter = ",".join(drawtext_filters)

    log(f"[Caption] Burning {len(phrases)} phrases | mode={caption_mode} | niche={niche}")

    cmd = [
        FFMPEG, "-y",
        "-i", str(video),
        "-vf", combined_filter,
        "-c:v", "libx264",
        "-preset", "ultrafast",
        "-crf", "26",
        "-pix_fmt", "yuv420p",
        "-c:a", "copy",
        "-movflags", "+faststart",
        str(out),
    ]

    run_cmd(cmd, label=f"[Caption Burn] {len(phrases)} phrases")

    return str(out)


