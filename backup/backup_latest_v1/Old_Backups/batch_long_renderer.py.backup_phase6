def fnum(v, default=0.0):
    """Safely convert to float, falling back to default."""
    try:
        return float(v)
    except (TypeError, ValueError):
        return float(default)


def inum(v, default=0):
    """Safely convert to int, falling back to default."""
    try:
        return int(v)
    except (TypeError, ValueError):
        return int(default)


