def transition_decision(index, clip_duration, niche="default",
                         absolute_time=None, variation_data=None):
    """
    Decide which transition to use for this clip boundary.

    Anti-repeat: never repeat last 2 transitions.
    Chapter marker: every ~150 seconds use chapter transition.

    Args:
        index: Global clip index
        clip_duration: Duration of this clip
        niche: Niche name
        absolute_time: Approximate absolute time in seconds
        variation_data: Optional variation data

    Returns:
        {
            "transition": str (transition name),
            "transition_filter": str (FFmpeg filter),
            "duration": float (transition duration),
            "is_chapter": bool,
        }
    """
    profile = transition_profile_for_niche(niche)

    # Determine if this is a chapter boundary (~150 seconds)
    is_chapter = False
    if absolute_time is not None:
        chapter_interval = 150.0
        prev_chapter = (absolute_time // chapter_interval) * chapter_interval
        curr_chapter = ((absolute_time + clip_duration) // chapter_interval) * chapter_interval
        if curr_chapter > prev_chapter:
            is_chapter = True

    # Anti-repeat: use VariationIntelligence
    try:
        engine = get_variation_engine(reset=False)
        available_transitions = [
            t for t in profile["base"]
            if t not in engine._last_transitions[-2:]
        ]
        if not available_transitions:
            available_transitions = list(profile["base"])
    except Exception:
        available_transitions = list(profile["base"])

    # Pick transition
    if is_chapter:
        trans_name = profile.get("chapter", "fade")
    else:
        trans_name = random.choice(available_transitions)

    # Get filter template
    filter_template = TRANSITION_TYPES.get(trans_name, TRANSITION_TYPES["fade"])

    # Calculate duration
    dur_min, dur_max = profile["duration_range"]

    # Short clips get short transitions
    if clip_duration < 3.5:
        trans_dur = round(random.uniform(0.08, min(0.15, dur_max)), 2)
    elif clip_duration > 7.5:
        trans_dur = round(random.uniform(dur_min, dur_max), 2)
    else:
        trans_dur = round(random.uniform(dur_min, min(0.50, dur_max)), 2)

    # Format the filter
    out_start = max(0, clip_duration - trans_dur)

    # Handle special transitions
    if trans_name in ("circleopen", "circclose"):
        radius_expr = f"min(W,H)/2*{trans_dur}/{clip_duration}"
        filter_str = filter_template.format(dur=trans_dur, out_start=out_start)
        filter_str = filter_str.replace("{rad}", radius_expr)
    else:
        filter_str = filter_template.format(dur=trans_dur, out_start=out_start)

    # Update anti-repeat
    try:
        engine = get_variation_engine(reset=False)
        engine._last_transitions.append(trans_name)
        if len(engine._last_transitions) > 4:
            engine._last_transitions = engine._last_transitions[-4:]
    except Exception:
        pass

    return {
        "transition": trans_name,
        "transition_filter": filter_str,
        "duration": trans_dur,
        "is_chapter": is_chapter,
    }


