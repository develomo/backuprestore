def save_uploaded_file(uploaded_file, folder: Path) -> Optional[str]:
    if uploaded_file is None:
        return None
    file_path = folder / uploaded_file.name
    with open(file_path, "wb") as f:
        f.write(uploaded_file.getbuffer())
    return str(file_path)

