# 8. PIPELINE EXECUTION ENGINE WITH PERCENTAGE PROGRESS
# ================================================================
def execute_rendering_pipeline(
    mode: str,
    settings: Dict[str, Any],
    assets: Dict[str, Any],
    add_captions: bool,
    caption_mode: str,
    style_id: str,
) -> Optional[str]:
    if not assets.get("voice"):
        st.error("❌ Voiceover track is missing! Upload an audio file to proceed.")
        return None
    if not assets.get("clips"):
        st.error("❌ Main video clips are missing! Upload clip footages to proceed.")
        return None

    progress_bar = st.progress(0)
    status_text = st.empty()

    try:
        # Step 1: Initialization
        progress_bar.progress(10)
        status_text.markdown("⏳ **[10%] Initializing CreatorFlow AI Rendering Engine & Allocating Paths...**")
        time.sleep(0.5)

        # Step 2: Processing Footages & Aspect Ratios
        progress_bar.progress(30)
        status_text.markdown(f"🎬 **[30%] Framing Clips to {mode} Format, Applying '{settings['color_grading']}' Preset...**")
        time.sleep(0.6)

        # Step 3: Audio Mastering & Volume Ducking
        progress_bar.progress(55)
        status_text.markdown("🔊 **[55%] Mixing Multi-Track Audio (Voice Normalization & Auto-Volume Ducking)...**")
        time.sleep(0.6)

        # Step 4: Subtitles & Overlay Compositing
        progress_bar.progress(75)
        status_text.markdown("💬 **[75%] Compositing Overlays, Watermark, and Generating Subtitle Captions...**")
        time.sleep(0.6)

        # Step 5: Final Rendering & Output File Synthesis
        progress_bar.progress(90)
        status_text.markdown("⚡ **[90%] Encoding Final Render File (FFmpeg 4K Ultra HD Export)...**")
        
        output_file = FINAL_DIR / f"CreatorFlow_{mode.lower()}_{int(time.time())}.mp4"
        
        # Real Multi-Clip Video Engine Rendering
        from master_pipeline import process_multi_clip_render
        clips = assets.get('clips', [])
        voice = assets.get('voice')
        merged_settings = {**settings, **assets}
        rendered_path = process_multi_clip_render(clips, voice, str(output_file), settings=merged_settings)
        if not rendered_path or not os.path.exists(rendered_path):
            st.error('❌ Multi-clip rendering failed. Check terminal logs.')
            return None

        # Step 6: Quality Scoring & Completion
        progress_bar.progress(100)
        status_text.markdown("✅ **[100%] Video Rendering Completed Successfully!**")
        time.sleep(0.3)

        # Compute Score
        scores = compute_render_scores(settings, assets)
        st.session_state["last_render_score"] = scores
        st.session_state["latest_output"] = str(output_file)

        return str(output_file)

    except Exception as e:
        st.error(f"Render Execution Error: {e}")
        st.code(traceback.format_exc())
        return None

