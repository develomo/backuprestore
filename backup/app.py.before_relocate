def compute_render_scores(settings: Dict[str, Any], assets: Dict[str, Any]) -> Dict[str, Any]:
    video_score = 7.5
    voice_score = 8.0

    if settings.get("final_4k"): video_score += 1.0
    if settings.get("fps", 24) >= 30: video_score += 0.5
    if settings.get("motion"): video_score += 0.4
    if settings.get("overlays"): video_score += 0.3
    if assets.get("watermark"): video_score += 0.3

    if settings.get("clean_silence"): voice_score += 0.7
    if assets.get("music"): voice_score += 0.7
    if assets.get("sfx") and len(assets.get("sfx", [])) > 0: voice_score += 0.6

    video_score = min(10.0, round(video_score, 1))
    voice_score = min(10.0, round(voice_score, 1))
    combined_score = min(10.0, round((video_score * 0.55 + voice_score * 0.45), 1))

    return {
        "video_score": video_score,
        "voice_score": voice_score,
        "combined_score": combined_score,
    }

