SAFE_WORD_RE = re.compile(r"[^\wÀ-ž'’\-]+", re.UNICODE)
SPACE_RE = re.compile(r"\s+")


@dataclass
class CaptionToken:
    word: str
    start: float
    end: float
    confidence: float = 1.0


@dataclass
class CaptionSegment:
    text: str
    start: float
    end: float
    words: List[CaptionToken]
    mode: str
    style_id: str
    index: int


