    FONT_CANDIDATES = FINAL_CAPTION_PREMIUM_FONTS

def _final_caption_safe_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return float(default)

def _final_caption_safe_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return int(default)

def _final_caption_text_from_item(item):
    try:
        if isinstance(item, CaptionToken):
            return str(item.word or "").strip()
    except Exception:
        pass
    if isinstance(item, dict):
        return str(item.get("word", item.get("text", ""))).strip()
    return str(getattr(item, "word", getattr(item, "text", item))).strip()

def _final_caption_is_fake_words(words):
    if not words:
        return True
    try:
        iterable = words.get("words", []) if isinstance(words, dict) else words
    except Exception:
        return True

    cleaned = []
    for item in iterable:
        w = _final_caption_text_from_item(item).strip().lower()
        if w:
            cleaned.append(w)

    if not cleaned:
        return True

    unique = set(cleaned)
    if unique and unique.issubset(FINAL_CAPTION_FAKE_WORDS):
        return True

    if len(cleaned) <= 12 and len(unique.intersection(FINAL_CAPTION_FAKE_WORDS)) >= max(2, len(unique) - 1):
        return True

    return False

def _final_caption_choose_font(preferred=None):
    try:
        if preferred and Path(str(preferred)).exists():
            return str(preferred)
    except Exception:
        pass

    for candidate in FINAL_CAPTION_PREMIUM_FONTS:
        try:
            if Path(candidate).exists():
                return str(candidate)
        except Exception:
            pass

    try:
        return find_font_path(preferred)
    except Exception:
        return None

def _final_caption_make_token(word, start, end, confidence=1.0):
    start = max(0.0, _final_caption_safe_float(start, 0.0))
    end = max(start + FINAL_CAPTION_MIN_WORD_DURATION, _final_caption_safe_float(end, start + 0.18))
    confidence = _final_caption_safe_float(confidence, 1.0)
    try:
        return CaptionToken(word=str(word), start=start, end=end, confidence=confidence)
    except Exception:
        return {"word": str(word), "start": start, "end": end, "confidence": confidence}

def _final_caption_refine_tokens(words, start_offset=FINAL_CAPTION_START_OFFSET):
    if not words:
        return []
    try:
        iterable = words.get("words", []) if isinstance(words, dict) else words
    except Exception:
        iterable = words

    raw_tokens = []
    for item in iterable or []:
        try:
            if isinstance(item, CaptionToken):
                word = clean_word(item.word)
                start = item.start
                end = item.end
                conf = item.confidence
            elif isinstance(item, dict):
                word = clean_word(item.get("word", item.get("text", "")))
                start = item.get("start", item.get("s", 0.0))
                end = item.get("end", item.get("e", _final_caption_safe_float(start, 0.0) + 0.20))
                conf = item.get("confidence", item.get("probability", 1.0))
            elif isinstance(item, (list, tuple)) and len(item) >= 3:
                word = clean_word(item[0])
                start = item[1]
                end = item[2]
                conf = item[3] if len(item) > 3 else 1.0
            else:
                word = clean_word(item)
                start = 0.0
                end = 0.20
                conf = 1.0

            if not word:
                continue

            start = max(0.0, _final_caption_safe_float(start, 0.0) + _final_caption_safe_float(start_offset, 0.0))
            end = max(start + FINAL_CAPTION_MIN_WORD_DURATION, _final_caption_safe_float(end, start + 0.20) + _final_caption_safe_float(start_offset, 0.0) - FINAL_CAPTION_END_PADDING)
            raw_tokens.append(_final_caption_make_token(word, start, end, conf))
        except Exception:
            pass

    raw_tokens.sort(key=lambda token: (_final_caption_safe_float(getattr(token, "start", token.get("start", 0.0) if isinstance(token, dict) else 0.0), 0.0), _final_caption_safe_float(getattr(token, "end", token.get("end", 0.1) if isinstance(token, dict) else 0.1), 0.1)))

    refined = []
    previous_end = 0.0
    for token in raw_tokens:
        try:
            word = token.word if isinstance(token, CaptionToken) else token.get("word", "")
            start = token.start if isinstance(token, CaptionToken) else token.get("start", 0.0)
            end = token.end if isinstance(token, CaptionToken) else token.get("end", start + 0.18)
            conf = token.confidence if isinstance(token, CaptionToken) else token.get("confidence", 1.0)

            start = max(0.0, _final_caption_safe_float(start, 0.0))
            end = max(start + FINAL_CAPTION_MIN_WORD_DURATION, _final_caption_safe_float(end, start + 0.18))

            if refined and start < previous_end - 0.030:
                start = max(0.0, previous_end - 0.015)
                end = max(end, start + FINAL_CAPTION_MIN_WORD_DURATION)

            refined.append(_final_caption_make_token(word, start, end, conf))
            previous_end = end
        except Exception:
            pass

    return refined

def _final_caption_segment_text(words):
    text = " ".join([_final_caption_text_from_item(x) for x in words or []]).strip()
    return clean_text(text)

def _final_caption_refine_segments(segments):
    if not segments:
        return []
    output = []
    previous_end = 0.0

    for index, seg in enumerate(segments or []):
        try:
            words = _final_caption_refine_tokens(getattr(seg, "words", []), start_offset=0.0)
            start = _final_caption_safe_float(getattr(seg, "start", 0.0), 0.0)
            end = _final_caption_safe_float(getattr(seg, "end", start + 0.20), start + 0.20)

            if words:
                try:
                    start = min(start, words[0].start if isinstance(words[0], CaptionToken) else words[0]["start"])
                    end = max(end, words[-1].end if isinstance(words[-1], CaptionToken) else words[-1]["end"])
                except Exception:
                    pass

            start = max(0.0, start)
            end = max(start + 0.070, end)

            if output and start < previous_end - 0.030:
                start = max(0.0, previous_end - 0.015)
                end = max(end, start + 0.070)

            text = getattr(seg, "text", None) or _final_caption_segment_text(words)
            mode = getattr(seg, "mode", "word_by_word")
            style_id = getattr(seg, "style_id", "")

            output.append(CaptionSegment(text=text, start=start, end=end, words=words, mode=mode, style_id=style_id, index=index))
            previous_end = end
        except Exception:
            output.append(seg)

    return output

def _final_caption_config_from_kwargs(*args, **kwargs):
    if args:
        first = args[0]
        try:
            if isinstance(first, RenderConfig):
                return first
        except Exception:
            pass
        if hasattr(first, "caption_mode") and hasattr(first, "style_id"):
            return first

    try:
        mode = kwargs.get("mode", kwargs.get("caption_mode", "word_by_word"))
        style_id = kwargs.get("style_id", None)
        return RenderConfig(
            size=kwargs.get("size", (1080, 1920)),
            fps=_final_caption_safe_int(kwargs.get("fps", 30), 30),
            niche=kwargs.get("niche", "default"),
            caption_mode=mode,
            style_id=style_id,
            font_path=_final_caption_choose_font(kwargs.get("font_path", None)),
            base_font_size=kwargs.get("base_font_size", None),
            render_scale=_final_caption_safe_int(kwargs.get("render_scale", 1), 1),
            cache_enabled=bool(kwargs.get("cache_enabled", True)),
            max_phrase_words=_final_caption_safe_int(kwargs.get("max_phrase_words", kwargs.get("max_words", 4)), 4),
            min_caption_duration=max(0.060, _final_caption_safe_float(kwargs.get("min_duration", kwargs.get("min_caption_duration", 0.08)), 0.08)),
            max_caption_duration=min(2.80, _final_caption_safe_float(kwargs.get("max_duration", kwargs.get("max_caption_duration", 2.80)), 2.80)),
            word_delay_fix=_final_caption_safe_float(kwargs.get("word_delay_fix", 0.0), 0.0),
            end_padding=min(0.030, _final_caption_safe_float(kwargs.get("end_padding", FINAL_CAPTION_END_PADDING), FINAL_CAPTION_END_PADDING)),
            y_offset=_final_caption_safe_int(kwargs.get("y_offset", 0), 0),
            uppercase=bool(kwargs.get("uppercase", True)),
            debug=bool(kwargs.get("debug", False)),
        )
    except Exception:
        return None

