_PHASE13_PREVIOUS_ADD_CAPTIONS = globals().get("add_captions_to_video")

PHASE13_FAKE_WORDS = {"warning", "impact", "now", "alert"}


def phase13_caption_report():
    return {
        "version": PHASE13_CAPTION_ENGINE_VERSION,
        "fake_preview_words_blocked": True,
        "build_segments_kwargs_compatible": True,
        "add_captions_kwargs_compatible": True,
        "whisper_fallback": True,
        "word_by_word": True,
        "phrase_3_to_4_words": True,
        "real_voice_words_only": True,
    }


def _phase13_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return float(default)


def _phase13_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return int(default)


def _phase13_clean_text(text):
    try:
        return clean_text(text)
    except Exception:
        import re
        return re.sub(r"\s+", " ", str(text or "")).strip()


def _phase13_clean_word(word):
    try:
        return clean_word(word)
    except Exception:
        import re
        s = _phase13_clean_text(word)
        s = re.sub(r"[^\wÀ-ž'’\-]+", "", s, flags=re.UNICODE)
        return s.strip()


def _phase13_token_class():
    return globals().get("CaptionToken")


def _phase13_segment_class():
    return globals().get("CaptionSegment")


def _phase13_make_token(word, start, end, confidence=1.0):
    word = _phase13_clean_word(word)
    start = max(0.0, _phase13_float(start, 0.0))
    end = max(start + 0.05, _phase13_float(end, start + 0.25))
    cls = _phase13_token_class()
    if cls:
        try:
            return cls(word=word, start=start, end=end, confidence=confidence)
        except Exception:
            pass
    return {"word": word, "start": start, "end": end, "confidence": confidence}


def _phase13_token_word(token):
    if isinstance(token, dict):
        return _phase13_clean_word(token.get("word", token.get("text", "")))
    return _phase13_clean_word(getattr(token, "word", getattr(token, "text", "")))


def _phase13_token_start(token):
    if isinstance(token, dict):
        return _phase13_float(token.get("start", token.get("s", 0.0)), 0.0)
    return _phase13_float(getattr(token, "start", 0.0), 0.0)


def _phase13_token_end(token):
    st = _phase13_token_start(token)
    if isinstance(token, dict):
        return max(st + 0.05, _phase13_float(token.get("end", token.get("e", st + 0.25)), st + 0.25))
    return max(st + 0.05, _phase13_float(getattr(token, "end", st + 0.25), st + 0.25))


def _phase13_normalize_mode(mode=None):
    try:
        return normalize_caption_mode(mode)
    except Exception:
        m = str(mode or "word_by_word").lower()
        if m in ("phrase", "phrases", "group", "groups", "line", "story", "3-4", "3_to_4"):
            return "phrase"
        if m in ("off", "none", "false", "0"):
            return "none"
        return "word_by_word"


def _phase13_is_fake_words(tokens):
    words = [_phase13_token_word(t).lower() for t in tokens if _phase13_token_word(t)]
    if not words:
        return False
    return set(words).issubset(PHASE13_FAKE_WORDS)


def _phase13_normalize_words_any(words):
    if not words:
        return []

    if isinstance(words, dict):
        if "words" in words:
            words = words.get("words") or []
        elif "segments" in words:
            temp = []
            for seg in words.get("segments", []) or []:
                if isinstance(seg, dict):
                    if seg.get("words"):
                        temp.extend(seg.get("words") or [])
                    elif seg.get("text"):
                        st = _phase13_float(seg.get("start", 0.0), 0.0)
                        en = max(st + 0.2, _phase13_float(seg.get("end", st + 1.0), st + 1.0))
                        parts = str(seg.get("text", "")).split()
                        step = (en - st) / max(1, len(parts))
                        for i, w in enumerate(parts):
                            temp.append({"word": w, "start": st + i * step, "end": st + (i + 1) * step})
            words = temp
        else:
            words = []

    out = []
    for item in words or []:
        try:
            if isinstance(item, dict):
                word = _phase13_clean_word(item.get("word", item.get("text", "")))
                if not word:
                    continue
                st = _phase13_float(item.get("start", item.get("s", 0.0)), 0.0)
                en = _phase13_float(item.get("end", item.get("e", st + 0.25)), st + 0.25)
                out.append(_phase13_make_token(word, st, en, _phase13_float(item.get("confidence", 1.0), 1.0)))
            elif isinstance(item, (list, tuple)) and len(item) >= 3:
                word = _phase13_clean_word(item[0])
                if not word:
                    continue
                out.append(_phase13_make_token(word, item[1], item[2], 1.0))
            else:
                word = _phase13_clean_word(getattr(item, "word", getattr(item, "text", item)))
                if not word:
                    continue
                st = _phase13_float(getattr(item, "start", 0.0), 0.0)
                en = _phase13_float(getattr(item, "end", st + 0.25), st + 0.25)
                out.append(_phase13_make_token(word, st, en, _phase13_float(getattr(item, "confidence", 1.0), 1.0)))
        except Exception:
            pass

    out.sort(key=lambda t: (_phase13_token_start(t), _phase13_token_end(t)))

    if _phase13_is_fake_words(out):
        try:
            safe_print("[CaptionPhase13] Fake/preview caption words blocked.")
        except Exception:
            print("[CaptionPhase13] Fake/preview caption words blocked.", flush=True)
        return []

    return out


def _phase13_words_from_transcript(transcript_text, duration=0.0):
    parts = [x.strip() for x in str(transcript_text or "").split() if x.strip()]
    if not parts:
        return []
    duration = max(1.0, _phase13_float(duration, len(parts) * 0.35))
    step = duration / max(1, len(parts))
    tokens = []
    for i, word in enumerate(parts):
        st = i * step
        tokens.append(_phase13_make_token(word, st, st + min(0.8, max(0.22, step * 0.90))))
    return tokens


def _phase13_words_from_voice(voice_path, model_name="base"):
    if not voice_path:
        return []
    try:
        p = Path(voice_path)
        if not p.exists():
            return []
    except Exception:
        return []
    try:
        import whisper
        try:
            safe_print("[CaptionPhase13] Generating real captions with Whisper...")
        except Exception:
            pass
        model = whisper.load_model(model_name)
        result = model.transcribe(str(voice_path), word_timestamps=True, verbose=False)
        tokens = []
        for seg in result.get("segments", []) or []:
            if seg.get("words"):
                for w in seg.get("words") or []:
                    word = _phase13_clean_word(w.get("word", ""))
                    if word:
                        tokens.append(_phase13_make_token(word, w.get("start", seg.get("start", 0.0)), w.get("end", seg.get("end", 0.0)), w.get("probability", 1.0)))
            else:
                text = str(seg.get("text", "")).strip()
                parts = [x for x in text.split() if x.strip()]
                st = _phase13_float(seg.get("start", 0.0), 0.0)
                en = max(st + 0.2, _phase13_float(seg.get("end", st + len(parts) * 0.35), st + len(parts) * 0.35))
                step = (en - st) / max(1, len(parts))
                for i, word in enumerate(parts):
                    tokens.append(_phase13_make_token(word, st + i * step, st + (i + 1) * step, 1.0))
        return _phase13_normalize_words_any(tokens)
    except Exception as e:
        try:
            safe_print(f"[CaptionPhase13] Whisper fallback failed: {e}")
        except Exception:
            pass
        return []


def _phase13_resolve_config(config=None, **kwargs):
    RenderConfigCls = globals().get("RenderConfig")
    if config is not None and hasattr(config, "caption_mode"):
        # Update selected values from kwargs but preserve object.
        for key, value in kwargs.items():
            if hasattr(config, key) and value is not None:
                try:
                    setattr(config, key, value)
                except Exception:
                    pass
        return config

    if RenderConfigCls:
        try:
            return RenderConfigCls(
                size=kwargs.get("size", kwargs.get("video_size", (1080, 1920))),
                fps=_phase13_int(kwargs.get("fps", 30), 30),
                niche=str(kwargs.get("niche", "default")),
                caption_mode=_phase13_normalize_mode(kwargs.get("caption_mode", kwargs.get("mode", "word_by_word"))),
                style_id=kwargs.get("style_id"),
                render_scale=_phase13_int(kwargs.get("render_scale", 1), 1),
                cache_enabled=bool(kwargs.get("cache_enabled", True)),
                word_delay_fix=_phase13_float(kwargs.get("word_delay_fix", kwargs.get("sync_offset_sec", -0.12)), -0.12),
                uppercase=bool(kwargs.get("uppercase", True)),
            )
        except Exception:
            pass

    class SimpleConfig:
        pass

    c = SimpleConfig()
    c.size = kwargs.get("size", kwargs.get("video_size", (1080, 1920)))
    c.fps = _phase13_int(kwargs.get("fps", 30), 30)
    c.niche = str(kwargs.get("niche", "default"))
    c.caption_mode = _phase13_normalize_mode(kwargs.get("caption_mode", kwargs.get("mode", "word_by_word")))
    c.style_id = kwargs.get("style_id")
    c.font_path = kwargs.get("font_path")
    c.base_font_size = kwargs.get("base_font_size")
    c.render_scale = _phase13_int(kwargs.get("render_scale", 1), 1)
    c.cache_enabled = bool(kwargs.get("cache_enabled", True))
    c.max_phrase_words = _phase13_int(kwargs.get("max_phrase_words", 4), 4)
    c.min_caption_duration = _phase13_float(kwargs.get("min_caption_duration", 0.10), 0.10)
    c.max_caption_duration = _phase13_float(kwargs.get("max_caption_duration", 3.50), 3.50)
    c.word_delay_fix = _phase13_float(kwargs.get("word_delay_fix", kwargs.get("sync_offset_sec", -0.12)), -0.12)
    c.end_padding = _phase13_float(kwargs.get("end_padding", 0.04), 0.04)
    c.y_offset = _phase13_int(kwargs.get("y_offset", 0), 0)
    c.uppercase = bool(kwargs.get("uppercase", True))
    c.debug = bool(kwargs.get("debug", False))
    return c


def _phase13_choose_style_id(niche, mode, style_id=None):
    if style_id:
        return style_id
    try:
        return choose_default_style_for_niche(niche, mode)
    except Exception:
        return "phrase_crystal_line" if mode == "phrase" else "wbw_crystal_cyan"


def _phase13_make_segment(text, start, end, words, mode, style_id, index):
    cls = _phase13_segment_class()
    if cls:
        try:
            return cls(text=text, start=start, end=end, words=words, mode=mode, style_id=style_id, index=index)
        except Exception:
            pass
    return {"text": text, "start": start, "end": end, "words": words, "mode": mode, "style_id": style_id, "index": index}


def build_segments(words=None, config=None, *args, **kwargs):
    """Phase 13 compatible build_segments.

    Supports old call:
        build_segments(words, config)

    Supports new call:
        build_segments(words, mode="phrase", style_id="...", niche="...")
    """
    cfg = _phase13_resolve_config(config, **kwargs)
    tokens = _phase13_normalize_words_any(words)

    if not tokens and kwargs.get("transcript_text"):
        tokens = _phase13_words_from_transcript(kwargs.get("transcript_text"), kwargs.get("duration", kwargs.get("target_duration", 0.0)))

    if not tokens and kwargs.get("voice_path"):
        tokens = _phase13_words_from_voice(kwargs.get("voice_path"))

    if not tokens:
        return []

    mode = _phase13_normalize_mode(getattr(cfg, "caption_mode", kwargs.get("mode", "word_by_word")))
    if mode == "none":
        return []

    style_id = _phase13_choose_style_id(getattr(cfg, "niche", "default"), mode, getattr(cfg, "style_id", None) or kwargs.get("style_id"))

    min_d = _phase13_float(getattr(cfg, "min_caption_duration", 0.10), 0.10)
    max_d = _phase13_float(getattr(cfg, "max_caption_duration", 3.50), 3.50)
    offset = _phase13_float(getattr(cfg, "word_delay_fix", -0.12), -0.12)
    end_pad = _phase13_float(getattr(cfg, "end_padding", 0.04), 0.04)
    uppercase = bool(getattr(cfg, "uppercase", True))

    segments = []

    if mode == "word_by_word":
        for i, token in enumerate(tokens):
            word = _phase13_token_word(token)
            if not word:
                continue
            st = max(0.0, _phase13_token_start(token) + offset)
            en = max(st + min_d, _phase13_token_end(token) + offset + end_pad)
            en = min(en, st + max_d)
            text = word.upper() if uppercase else word
            segments.append(_phase13_make_segment(text, st, en, [token], mode, style_id, i))
        return segments

    max_words = 4
    try:
        style = get_caption_style(style_id, fallback_mode=mode)
        max_words = _phase13_int(style.get("max_words", style.get("words_per_line", 4)), 4)
    except Exception:
        pass
    max_words = max(2, min(max_words, 4))

    group = []
    idx = 0
    for token in tokens:
        group.append(token)
        word = _phase13_token_word(token)
        ender = word.endswith((".", "?", "!", "…"))
        if len(group) >= max_words or ender:
            st = max(0.0, _phase13_token_start(group[0]) + offset)
            en = max(st + min_d, _phase13_token_end(group[-1]) + offset + end_pad)
            en = min(en, st + max_d)
            text = " ".join(_phase13_token_word(x) for x in group if _phase13_token_word(x))
            text = text.upper() if uppercase else text
            if text:
                segments.append(_phase13_make_segment(text, st, en, list(group), mode, style_id, idx))
                idx += 1
            group = []

    if group:
        st = max(0.0, _phase13_token_start(group[0]) + offset)
        en = max(st + min_d, _phase13_token_end(group[-1]) + offset + end_pad)
        en = min(en, st + max_d)
        text = " ".join(_phase13_token_word(x) for x in group if _phase13_token_word(x))
        text = text.upper() if uppercase else text
        if text:
            segments.append(_phase13_make_segment(text, st, en, list(group), mode, style_id, idx))

    return segments


def _phase13_filter_kwargs_for_previous(fn, kwargs):
    try:
        import inspect
        sig = inspect.signature(fn)
        has_var = any(p.kind == p.VAR_KEYWORD for p in sig.parameters.values())
        if has_var:
            return kwargs
        return {k: v for k, v in kwargs.items() if k in sig.parameters}
    except Exception:
        return {}


def add_captions_to_video(video, words=None, *args, **kwargs):
    """Phase 13 compatible caption entry.

    This wrapper first blocks fake captions and resolves missing words.
    It then calls old renderer if possible. If old renderer fails, it returns
    the original video instead of crashing the whole pipeline.
    """
    if not kwargs.get("add_captions", True):
        return video

    mode = _phase13_normalize_mode(kwargs.get("caption_mode", kwargs.get("mode", "word_by_word")))
    if mode == "none":
        return video

    resolved_words = _phase13_normalize_words_any(words)

    if not resolved_words and kwargs.get("transcript_text"):
        resolved_words = _phase13_words_from_transcript(kwargs.get("transcript_text"), kwargs.get("duration", kwargs.get("target_duration", 0.0)))

    if not resolved_words and kwargs.get("voice_path"):
        resolved_words = _phase13_words_from_voice(kwargs.get("voice_path"))

    if not resolved_words:
        try:
            safe_print("[CaptionPhase13] No real caption words found; captions skipped.")
        except Exception:
            pass
        return video

    if _phase13_is_fake_words(resolved_words):
        try:
            safe_print("[CaptionPhase13] Fake/preview caption words blocked; captions skipped.")
        except Exception:
            pass
        return video

    kwargs = dict(kwargs)
    kwargs["caption_mode"] = mode
    kwargs.setdefault("word_delay_fix", -0.12)

    if _PHASE13_PREVIOUS_ADD_CAPTIONS and _PHASE13_PREVIOUS_ADD_CAPTIONS is not add_captions_to_video:
        try:
            safe_kwargs = _phase13_filter_kwargs_for_previous(_PHASE13_PREVIOUS_ADD_CAPTIONS, kwargs)
            return _PHASE13_PREVIOUS_ADD_CAPTIONS(video, resolved_words, *args, **safe_kwargs)
        except TypeError:
            try:
                return _PHASE13_PREVIOUS_ADD_CAPTIONS(video, resolved_words, *args)
            except Exception as e:
                try:
                    safe_print(f"[CaptionPhase13] Previous caption renderer failed safely: {e}")
                except Exception:
                    pass
                return video
        except Exception as e:
            try:
                safe_print(f"[CaptionPhase13] Caption render failed safely: {e}")
            except Exception:
                pass
            return video

    return video


def generate_caption_words_from_voice(voice_path, **kwargs):
    return _phase13_words_from_voice(voice_path, kwargs.get("model_name", "base"))


def generate_caption_words_from_transcript(transcript_text, duration=0.0, **kwargs):
    return _phase13_words_from_transcript(transcript_text, duration)


def phase13_build_caption_segments(words=None, **kwargs):
    return build_segments(words, **kwargs)


def phase13_add_captions_to_video(video, words=None, **kwargs):
    return add_captions_to_video(video, words, **kwargs)


