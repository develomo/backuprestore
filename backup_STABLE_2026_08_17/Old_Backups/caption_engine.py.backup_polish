def safe_print(message: Any) -> None:
    try:
        print(str(message).replace("→", "->").replace("—", "-"), flush=True)
    except Exception:
        pass


def clamp(v: float, low: float, high: float) -> float:
    return max(low, min(high, float(v)))


def hex_to_rgb(value: Any, fallback: Tuple[int, int, int] = (255, 255, 255)) -> Tuple[int, int, int]:
    if isinstance(value, tuple) and len(value) >= 3:
        return tuple(int(clamp(x, 0, 255)) for x in value[:3])
    s = str(value or "").strip()
    if not s:
        return fallback
    if s.startswith("#"):
        s = s[1:]
    if len(s) == 3:
        s = "".join(ch * 2 for ch in s)
    try:
        return int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16)
    except Exception:
        return fallback


def rgba(rgb: Tuple[int, int, int], opacity: float = 1.0) -> Tuple[int, int, int, int]:
    return int(rgb[0]), int(rgb[1]), int(rgb[2]), int(clamp(opacity, 0, 1) * 255)


def clean_text(text: Any) -> str:
    s = str(text or "").replace("\n", " ").replace("\t", " ")
    s = SPACE_RE.sub(" ", s).strip()
    return s


def clean_word(word: Any) -> str:
    s = clean_text(word)
    s = SAFE_WORD_RE.sub("", s)
    return s.strip()


def normalize_word_item(item: Any) -> Optional[CaptionToken]:
    if isinstance(item, CaptionToken):
        if not item.word:
            return None
        return item
    if isinstance(item, dict):
        word = clean_word(item.get("word", item.get("text", "")))
        if not word:
            return None
        start = float(item.get("start", item.get("s", 0.0)) or 0.0)
        end = float(item.get("end", item.get("e", start + 0.20)) or (start + 0.20))
        conf = float(item.get("confidence", item.get("probability", 1.0)) or 1.0)
        end = max(end, start + 0.03)
        return CaptionToken(word=word, start=start, end=end, confidence=conf)
    if isinstance(item, (list, tuple)) and len(item) >= 3:
        word = clean_word(item[0])
        if not word:
            return None
        start = float(item[1] or 0.0)
        end = float(item[2] or start + 0.20)
        return CaptionToken(word=word, start=start, end=max(end, start + 0.03))
    word = clean_word(item)
    if word:
        return CaptionToken(word=word, start=0.0, end=0.25)
    return None


def normalize_words(words: Any) -> List[CaptionToken]:
    if not words:
        return []
    output: List[CaptionToken] = []
    if isinstance(words, dict):
        if "words" in words:
            words = words["words"]
        elif "segments" in words:
            temp = []
            for seg in words.get("segments", []):
                temp.extend(seg.get("words", []))
            words = temp
        else:
            words = []
    for item in words:
        token = normalize_word_item(item)
        if token:
            output.append(token)
    output.sort(key=lambda w: (w.start, w.end))
    fixed: List[CaptionToken] = []
    last_end = 0.0
    for token in output:
        start = max(0.0, float(token.start))
        end = max(float(token.end), start + 0.05)
        if fixed and start < fixed[-1].start:
            start = fixed[-1].end
            end = max(end, start + 0.05)
        fixed.append(CaptionToken(token.word, start, end, token.confidence))
        last_end = end
    return fixed


def words_to_plain_text(words: List[CaptionToken]) -> str:
    return " ".join(w.word for w in words if w.word)


def find_font_path(preferred: Optional[str] = None) -> str:
    if preferred and Path(preferred).exists():
        return str(preferred)
    for p in FONT_CANDIDATES:
        if Path(p).exists():
            return str(p)
    return ""


def load_font(font_path: Optional[str], size: int) -> ImageFont.ImageFont:
    chosen = find_font_path(font_path)
    if chosen:
        try:
            return ImageFont.truetype(chosen, size=size)
        except Exception:
            pass
    return ImageFont.load_default()


def measure_text(draw: ImageDraw.ImageDraw, text: str, font: ImageFont.ImageFont, stroke_width: int = 0) -> Tuple[int, int]:
    try:
        box = draw.textbbox((0, 0), text, font=font, stroke_width=stroke_width)
        return max(1, box[2] - box[0]), max(1, box[3] - box[1])
    except Exception:
        return max(1, len(text) * 20), max(1, int(getattr(font, "size", 40)))


def fit_font_size(text: str, style: Dict[str, Any], config: RenderConfig, max_width_ratio: float = 0.86) -> int:
    w, h = config.size
    if config.base_font_size:
        base = int(config.base_font_size)
    else:
        if style.get("mode") == "phrase":
            base = int(h * 0.043 * float(style.get("font_scale", 1.0)))
        else:
            base = int(h * 0.060 * float(style.get("font_scale", 1.0)))
    base = max(22, base)
    img = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    max_width = int(w * max_width_ratio)
    for size in range(base, 18, -2):
        font = load_font(config.font_path, size)
        tw, th = measure_text(draw, text, font, int(style.get("stroke_width", 3)))
        if tw <= max_width:
            return size
    return 20


def split_phrase_words(words: List[CaptionToken], max_words: int = 4) -> List[List[CaptionToken]]:
    groups: List[List[CaptionToken]] = []
    current: List[CaptionToken] = []
    for token in words:
        current.append(token)
        ender = token.word.endswith((".", "?", "!", "…"))
        if len(current) >= max_words or ender:
            groups.append(current)
            current = []
    if current:
        groups.append(current)
    return groups


def build_segments(words: Any, config: RenderConfig) -> List[CaptionSegment]:
    tokens = normalize_words(words)
    if not tokens:
        return []
    mode = normalize_caption_mode(config.caption_mode)
    style_id = config.style_id or choose_default_style_for_niche(config.niche, mode)
    style = get_caption_style(style_id, fallback_mode=mode)
    style_mode = style.get("mode", mode)
    if style_mode != mode:
        mode = style_mode
    segments: List[CaptionSegment] = []
    if mode == "word_by_word":
        for i, token in enumerate(tokens):
            start = max(0.0, token.start + config.word_delay_fix)
            end = max(start + config.min_caption_duration, token.end + config.word_delay_fix + config.end_padding)
            end = min(end, start + config.max_caption_duration)
            text = token.word.upper() if config.uppercase else token.word
            segments.append(CaptionSegment(text=text, start=start, end=end, words=[token], mode=mode, style_id=style_id, index=i))
        return segments
    max_words = int(style.get("max_words", config.max_phrase_words) or config.max_phrase_words)
    max_words = max(2, min(max_words, 6))
    groups = split_phrase_words(tokens, max_words=max_words)
    for i, group in enumerate(groups):
        start = max(0.0, group[0].start + config.word_delay_fix)
        end = max(group[-1].end + config.word_delay_fix + config.end_padding, start + config.min_caption_duration)
        end = min(end, start + config.max_caption_duration)
        text = words_to_plain_text(group)
        text = text.upper() if config.uppercase else text
        segments.append(CaptionSegment(text=text, start=start, end=end, words=group, mode=mode, style_id=style_id, index=i))
    return segments


def style_hash(style: Dict[str, Any]) -> str:
    raw = json.dumps(style, sort_keys=True, ensure_ascii=False)
    return hashlib.md5(raw.encode("utf-8")).hexdigest()[:12]


def segment_cache_key(segment: CaptionSegment, style: Dict[str, Any], config: RenderConfig) -> str:
    raw = {
        "text": segment.text,
        "mode": segment.mode,
        "style": style_hash(style),
        "size": config.size,
        "scale": config.render_scale,
        "index": segment.index,
    }
    return hashlib.md5(json.dumps(raw, sort_keys=True).encode("utf-8")).hexdigest()


def make_alpha_shadow(text_layer: Image.Image, blur: int, opacity: float) -> Image.Image:
    alpha = text_layer.split()[-1]
    if blur > 0:
        alpha = alpha.filter(ImageFilter.GaussianBlur(radius=int(blur)))
    shadow = Image.new("RGBA", text_layer.size, (0, 0, 0, int(255 * clamp(opacity, 0, 1))))
    shadow.putalpha(alpha)
    return shadow


def create_gradient_text_mask(size: Tuple[int, int], text: str, font: ImageFont.ImageFont, pos: Tuple[int, int], stroke_width: int = 0) -> Image.Image:
    mask = Image.new("L", size, 0)
    draw = ImageDraw.Draw(mask)
    draw.text(pos, text, font=font, fill=255, stroke_width=stroke_width, stroke_fill=255)
    return mask


def gradient_image(size: Tuple[int, int], colors: List[Tuple[int, int, int]]) -> Image.Image:
    w, h = size
    if not colors:
        colors = [(255, 255, 255)]
    if len(colors) == 1:
        return Image.new("RGBA", size, rgba(colors[0], 1.0))
    arr = np.zeros((h, w, 4), dtype=np.uint8)
    stops = len(colors) - 1
    for x in range(w):
        p = x / max(1, w - 1)
        idx = min(stops - 1, int(p * stops)) if stops > 1 else 0
        local = (p * stops) - idx
        c1 = colors[idx]
        c2 = colors[idx + 1]
        c = [int(c1[i] * (1 - local) + c2[i] * local) for i in range(3)]
        arr[:, x, 0] = c[0]
        arr[:, x, 1] = c[1]
        arr[:, x, 2] = c[2]
        arr[:, x, 3] = 255
    return Image.fromarray(arr, "RGBA")


def draw_rounded_box(base: Image.Image, rect: Tuple[int, int, int, int], color: Tuple[int, int, int], opacity: float, radius: int = 20) -> None:
    overlay = Image.new("RGBA", base.size, (0, 0, 0, 0))
    d = ImageDraw.Draw(overlay)
    d.rounded_rectangle(rect, radius=radius, fill=rgba(color, opacity))
    base.alpha_composite(overlay)


def render_text_image(segment: CaptionSegment, style: Dict[str, Any], config: RenderConfig) -> Image.Image:
    w, h = config.size
    scale = max(1, int(config.render_scale))
    canvas_size = (w * scale, h * scale)
    style2 = dict(style)
    stroke_width = int(style2.get("stroke_width", 3)) * scale
    shadow_blur = int(style2.get("shadow_blur", 8)) * scale
    y_ratio = float(style2.get("safe_area_y", 0.78))
    y = int(h * y_ratio) * scale + int(config.y_offset) * scale
    text = segment.text
    font_size = fit_font_size(text, style2, RenderConfig(size=config.size, font_path=config.font_path, base_font_size=config.base_font_size, render_scale=scale)) * scale
    font = load_font(config.font_path, font_size)
    base = Image.new("RGBA", canvas_size, (0, 0, 0, 0))
    d = ImageDraw.Draw(base)
    tw, th = measure_text(d, text, font, stroke_width)
    x = int((canvas_size[0] - tw) / 2)
    y = int(y - th / 2)
    pad_x = int(max(18, font_size * 0.22))
    pad_y = int(max(10, font_size * 0.12))
    if style2.get("box_enabled"):
        rect = (x - pad_x, y - pad_y, x + tw + pad_x, y + th + pad_y)
        draw_rounded_box(base, rect, hex_to_rgb(style2.get("box_color", "#000000")), float(style2.get("box_opacity", 0.25)), radius=int(font_size * 0.22))
    text_layer = Image.new("RGBA", canvas_size, (0, 0, 0, 0))
    td = ImageDraw.Draw(text_layer)
    primary = hex_to_rgb(style2.get("primary", "#FFFFFF"))
    stroke = hex_to_rgb(style2.get("stroke_color", "#000000"))
    color_type = style2.get("color_type", "single")
    if color_type in ("dual", "triple") and (style2.get("secondary") or style2.get("tertiary")):
        mask = create_gradient_text_mask(canvas_size, text, font, (x, y), stroke_width=0)
        colors = [primary]
        if style2.get("secondary"):
            colors.append(hex_to_rgb(style2.get("secondary")))
        if style2.get("tertiary"):
            colors.append(hex_to_rgb(style2.get("tertiary")))
        grad = gradient_image(canvas_size, colors)
        stroke_layer = Image.new("RGBA", canvas_size, (0, 0, 0, 0))
        sd = ImageDraw.Draw(stroke_layer)
        sd.text((x, y), text, font=font, fill=rgba(stroke, 1), stroke_width=stroke_width, stroke_fill=rgba(stroke, 1))
        text_layer.alpha_composite(stroke_layer)
        grad.putalpha(mask)
        text_layer.alpha_composite(grad)
    else:
        td.text((x, y), text, font=font, fill=rgba(primary, 1), stroke_width=stroke_width, stroke_fill=rgba(stroke, 1))
    if style2.get("shadow_opacity", 0) > 0:
        shadow = make_alpha_shadow(text_layer, blur=shadow_blur, opacity=float(style2.get("shadow_opacity", 0.35)))
        shifted = Image.new("RGBA", canvas_size, (0, 0, 0, 0))
        shifted.alpha_composite(shadow, (0, int(font_size * 0.05)))
        base.alpha_composite(shifted)
    if style2.get("glow_enabled"):
        glow_color = hex_to_rgb(style2.get("glow_color") or style2.get("primary") or "#FFFFFF")
        mask = text_layer.split()[-1]
        glow = Image.new("RGBA", canvas_size, rgba(glow_color, float(style2.get("glow_opacity", 0.14))))
        glow.putalpha(mask.filter(ImageFilter.GaussianBlur(radius=max(3, int(font_size * 0.08)))))
        base.alpha_composite(glow)
    base.alpha_composite(text_layer)
    if scale != 1:
        base = base.resize((w, h), Image.Resampling.LANCZOS)
    return base


def save_caption_png(segment: CaptionSegment, style: Dict[str, Any], config: RenderConfig) -> Path:
    key = segment_cache_key(segment, style, config)
    path = CACHE_DIR / f"{key}.png"
    if config.cache_enabled and path.exists():
        return path
    img = render_text_image(segment, style, config)
    img.save(path)
    return path


def animation_values(animation: str, local_t: float, duration: float) -> Tuple[float, float, float, float]:
    p = clamp(local_t / max(duration, 0.001), 0, 1)
    intro = clamp(local_t / 0.10, 0, 1)
    outro = clamp((duration - local_t) / 0.10, 0, 1)
    opacity = min(intro, outro)
    scale = 1.0
    dx = 0.0
    dy = 0.0
    animation = str(animation or "pop").lower()
    if "pop" in animation or "snap" in animation or "bounce" in animation:
        if p < 0.20:
            scale = 0.82 + 0.24 * ease_out(p / 0.20)
        else:
            scale = 1.0
    elif "rise" in animation or "line" in animation:
        dy = (1.0 - ease_out(min(p / 0.18, 1.0))) * 18.0
    elif "fade" in animation:
        scale = 1.0
    elif "premium" in animation:
        scale = 0.92 + 0.08 * ease_out(min(p / 0.18, 1.0))
        dy = (1.0 - ease_out(min(p / 0.18, 1.0))) * 10.0
    return opacity, scale, dx, dy


def ease_out(t: float) -> float:
    t = clamp(t, 0, 1)
    return 1 - (1 - t) ** 3


def make_moviepy_caption_clip(segment: CaptionSegment, style: Dict[str, Any], config: RenderConfig):
    if ImageClip is None:
        return None
    png = save_caption_png(segment, style, config)
    duration = max(0.05, segment.end - segment.start)
    animation = style.get("animation", "pop")
    clip = ImageClip(str(png), transparent=True).set_start(segment.start).set_duration(duration)
    def pos_func(t):
        opacity, scale, dx, dy = animation_values(animation, t, duration)
        return (int(dx), int(dy))
    def resize_func(t):
        opacity, scale, dx, dy = animation_values(animation, t, duration)
        return scale
    try:
        clip = clip.set_position(pos_func)
    except Exception:
        clip = clip.set_position(("center", "center"))
    try:
        clip = clip.resize(resize_func)
    except Exception:
        pass
    try:
        clip = clip.set_opacity(lambda t: animation_values(animation, t, duration)[0])
    except Exception:
        pass
    return clip


def add_captions_to_video(video, words: Any, style_id: Optional[str] = None, mode: str = "word_by_word", niche: str = "default", **kwargs):
    if video is None or CompositeVideoClip is None:
        return video
    try:
        size = tuple(video.size)
    except Exception:
        size = kwargs.get("size", (1080, 1920))
    config = RenderConfig(
        size=size,
        fps=int(kwargs.get("fps", 30)),
        niche=niche,
        caption_mode=normalize_caption_mode(mode),
        style_id=style_id or choose_default_style_for_niche(niche, mode),
        font_path=kwargs.get("font_path"),
        base_font_size=kwargs.get("base_font_size"),
        render_scale=int(kwargs.get("render_scale", 1)),
        cache_enabled=bool(kwargs.get("cache_enabled", True)),
        max_phrase_words=int(kwargs.get("max_phrase_words", 4)),
        min_caption_duration=float(kwargs.get("min_caption_duration", 0.10)),
        max_caption_duration=float(kwargs.get("max_caption_duration", 3.50)),
        word_delay_fix=float(kwargs.get("word_delay_fix", 0.0)),
        end_padding=float(kwargs.get("end_padding", 0.04)),
        y_offset=int(kwargs.get("y_offset", 0)),
        uppercase=bool(kwargs.get("uppercase", True)),
        debug=bool(kwargs.get("debug", False)),
    )
    segments = build_segments(words, config)
    if not segments:
        return video
    style = get_caption_style(config.style_id, fallback_mode=config.caption_mode)
    caption_clips = []
    for seg in segments:
        c = make_moviepy_caption_clip(seg, style, config)
        if c is not None:
            caption_clips.append(c)
    if not caption_clips:
        return video
    safe_print(f"[CaptionEngine] captions={len(caption_clips)} mode={config.caption_mode} style={config.style_id}")
    try:
