        if _final_caption_is_fake_words(words):
            safe_print("[CaptionEngineFinal] No real caption words found; returning empty segments.")
            return []

        config = _final_caption_config_from_kwargs(*args, **kwargs)
        refined_words = _final_caption_refine_tokens(words, start_offset=0.0)

        if config is not None:
            try:
                segments = _final_original_build_segments(refined_words, config)
                return _final_caption_refine_segments(segments)
            except TypeError as exc:
                if "unexpected keyword argument" not in str(exc):
                    try:
                        segments = _final_original_build_segments(refined_words, config)
                        return _final_caption_refine_segments(segments)
                    except Exception:
                        pass
            except Exception as exc:
                safe_print(f"[CaptionEngineFinal] build_segments config path failed: {exc}")

        try:
            segments = _final_original_build_segments(refined_words, *args)
            return _final_caption_refine_segments(segments)
        except Exception:
            pass

        try:
            fallback_config = RenderConfig(font_path=_final_caption_choose_font(None))
            segments = _final_original_build_segments(refined_words, fallback_config)
            return _final_caption_refine_segments(segments)
