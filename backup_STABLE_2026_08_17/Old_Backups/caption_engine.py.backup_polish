    except Exception:
        size = kwargs.get("size", (1080, 1920))
    safe_fps = min(int(kwargs.get("fps", 30) or 30), 30)
    normalized_mode = normalize_caption_mode(mode)
    resolved_style_id = _SELECTED_STYLE_ALIAS.get(str(style_id or ""), style_id or choose_default_style_for_niche(niche, normalized_mode))
    config = RenderConfig(size=size, fps=safe_fps, niche=niche, caption_mode=normalized_mode, style_id=resolved_style_id, font_path=kwargs.get("font_path"), base_font_size=kwargs.get("base_font_size"), render_scale=1, cache_enabled=True, max_phrase_words=int(kwargs.get("max_phrase_words", 4)), min_caption_duration=float(kwargs.get("min_caption_duration", 0.10)), max_caption_duration=min(float(kwargs.get("max_caption_duration", 2.50)), 2.50), word_delay_fix=float(kwargs.get("word_delay_fix", 0.0)), end_padding=float(kwargs.get("end_padding", 0.04)), y_offset=int(kwargs.get("y_offset", 0)), uppercase=bool(kwargs.get("uppercase", True)), debug=bool(kwargs.get("debug", False)))
    segments = build_segments(words, config)
    if not segments:
        safe_print("[CaptionEngine] No caption segments created; returning video unchanged.")
        return video
    segments = _caption_low_ram_limit_segments(segments, config.caption_mode, kwargs.get("max_caption_clips"))
    style = get_caption_style(config.style_id, fallback_mode=config.caption_mode)
    caption_clips = []
    for seg in segments:
        try:
            c = make_moviepy_caption_clip(seg, style, config)
            if c is not None:
                caption_clips.append(c)
        except MemoryError:
            safe_print("[CaptionEngine] MemoryError while making caption clips; stopping at visible safe count.")
            break
        except Exception as e:
            safe_print(f"[CaptionEngine] caption clip skipped: {e}")
    if not caption_clips:
        safe_print("[CaptionEngine] No caption clips rendered; returning original video.")
        return video
    safe_print(f"[CaptionEngine] captions applied={len(caption_clips)} mode={config.caption_mode} style={config.style_id}")
    try:
        return CompositeVideoClip([video] + caption_clips, size=size).set_duration(video.duration)
    except MemoryError:
        safe_print("[CaptionEngine] Composite MemoryError; retrying with reduced caption count.")
        for c in caption_clips[int(len(caption_clips)/2):]:
            try: c.close()
            except Exception: pass
        caption_clips = caption_clips[:max(1, int(len(caption_clips)/2))]
        try:
            return CompositeVideoClip([video] + caption_clips, size=size).set_duration(video.duration)
        except Exception:
            return video
    except Exception as e:
        safe_print(f"[CaptionEngine] caption composite failed: {e}")
        return video
