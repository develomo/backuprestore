        except Exception:
            pass
    try:
        return find_font_path()
    except Exception:
        return None

def _safe_caption_refine_tokens(tokens):
    refined = []
    previous_end = 0.0
    try:
        for token in tokens or []:
            try:
                if isinstance(token, CaptionToken):
                    word = token.word
                    start = _safe_caption_float(token.start, 0.0)
                    end = _safe_caption_float(token.end, start + 0.22)
                    conf = _safe_caption_float(token.confidence, 1.0)
                elif isinstance(token, dict):
                    word = str(token.get("word", token.get("text", ""))).strip()
                    start = _safe_caption_float(token.get("start", token.get("s", 0.0)), 0.0)
                    end = _safe_caption_float(token.get("end", token.get("e", start + 0.22)), start + 0.22)
                    conf = _safe_caption_float(token.get("confidence", token.get("probability", 1.0)), 1.0)
                else:
                    word = str(getattr(token, "word", "")).strip()
                    start = _safe_caption_float(getattr(token, "start", 0.0), 0.0)
                    end = _safe_caption_float(getattr(token, "end", start + 0.22), start + 0.22)
                    conf = _safe_caption_float(getattr(token, "confidence", 1.0), 1.0)

                if not word:
                    continue

                start = max(0.0, start)
                end = max(start + 0.055, end)

                if refined and start < previous_end:
                    start = previous_end + 0.010
                    end = max(end, start + 0.055)

                refined.append(CaptionToken(word=word, start=start, end=end, confidence=conf))
                previous_end = end
            except Exception:
                pass
    except Exception:
        return tokens
    return refined

def _safe_caption_refine_segments(segments):
    output = []
    previous_end = 0.0
    try:
        for index, seg in enumerate(segments or []):
            try:
                start = max(0.0, _safe_caption_float(getattr(seg, "start", previous_end), previous_end))
                end = max(start + 0.080, _safe_caption_float(getattr(seg, "end", start + 0.22), start + 0.22))

                if output and start < previous_end:
                    start = previous_end + 0.008
                    end = max(end, start + 0.080)

                words = getattr(seg, "words", [])
                words = _safe_caption_refine_tokens(words)

                output.append(
                    CaptionSegment(
                        text=getattr(seg, "text", ""),
                        start=start,
                        end=end,
                        words=words,
                        mode=getattr(seg, "mode", "word_by_word"),
                        style_id=getattr(seg, "style_id", ""),
                        index=index,
                    )
                )
                previous_end = end
            except Exception:
                output.append(seg)
        return output
    except Exception:
        return segments

