FINAL_CAPTION_START_OFFSET = -0.22
FINAL_CAPTION_END_PADDING = 0.020
FINAL_CAPTION_MIN_WORD_DURATION = 0.045
FINAL_CAPTION_FAKE_WORDS = {
    "warning", "impact", "now", "alert", "future", "power", "focus", "money",
    "attention", "signal", "viral", "hook", "caption", "preview"
}
FINAL_CAPTION_PREMIUM_FONTS = [
