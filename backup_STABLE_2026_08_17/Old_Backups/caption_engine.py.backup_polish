class CaptionEngine:
    def __init__(self, config: Optional[RenderConfig] = None):
        self.config = config or RenderConfig()

    def with_config(self, **kwargs):
        data = self.config.__dict__.copy()
        data.update(kwargs)
        return CaptionEngine(RenderConfig(**data))

    def segments(self, words: Any) -> List[CaptionSegment]:
        return build_segments(words, self.config)

    def clips(self, words: Any):
        return create_caption_clips(
            words,
            size=self.config.size,
            style_id=self.config.style_id,
            mode=self.config.caption_mode,
            niche=self.config.niche,
            font_path=self.config.font_path,
            base_font_size=self.config.base_font_size,
            render_scale=self.config.render_scale,
            cache_enabled=self.config.cache_enabled,
            max_phrase_words=self.config.max_phrase_words,
            word_delay_fix=self.config.word_delay_fix,
            end_padding=self.config.end_padding,
            y_offset=self.config.y_offset,
            uppercase=self.config.uppercase,
        )

    def apply(self, video, words: Any):
        return add_captions_to_video(
            video,
            words,
            style_id=self.config.style_id,
            mode=self.config.caption_mode,
            niche=self.config.niche,
            fps=self.config.fps,
            font_path=self.config.font_path,
            base_font_size=self.config.base_font_size,
            render_scale=self.config.render_scale,
            cache_enabled=self.config.cache_enabled,
            max_phrase_words=self.config.max_phrase_words,
            word_delay_fix=self.config.word_delay_fix,
            end_padding=self.config.end_padding,
            y_offset=self.config.y_offset,
            uppercase=self.config.uppercase,
            debug=self.config.debug,
        )

    def preview(self, style_id: Optional[str] = None, text: Optional[str] = None):
        return render_caption_preview(style_id or self.config.style_id or choose_default_style_for_niche(self.config.niche, self.config.caption_mode), mode=self.config.caption_mode, size=self.config.size, text=text)


