# ========================= LOW RAM CAPTION PATCH =========================
# The original caption engine is preserved above. This final override reduces
# RAM pressure by resizing/limiting caption ImageClips and by avoiding giant
# CompositeVideoClip layer stacks. It keeps the same public function name used
# by master_pipeline.py and safe_long_video_polished.py.

LOW_RAM_CAPTION_MAX_WORD_CLIPS = 160
LOW_RAM_CAPTION_MAX_PHRASE_CLIPS = 260


def _caption_low_ram_limit_segments(segments, mode, max_caption_clips=None):
    if max_caption_clips is not None:
        limit = int(max_caption_clips)
    else:
        limit = LOW_RAM_CAPTION_MAX_WORD_CLIPS if normalize_caption_mode(mode) == "word_by_word" else LOW_RAM_CAPTION_MAX_PHRASE_CLIPS
    if limit <= 0 or len(segments) <= limit:
        return segments
    step = max(1, int(math.ceil(len(segments) / float(limit))))
    limited = segments[::step][:limit]
    safe_print(f"[CaptionEngine] LOW RAM caption segment limit {len(segments)} -> {len(limited)}")
    return limited


def add_captions_to_video(video, words: Any, style_id: Optional[str] = None, mode: str = "word_by_word", niche: str = "default", **kwargs):
    if video is None or CompositeVideoClip is None:
        return video
    try:
        size = tuple(video.size)
    except Exception:
        size = kwargs.get("size", (720, 1280))
    safe_fps = min(int(kwargs.get("fps", 24) or 24), 24)
    config = RenderConfig(
        size=size,
        fps=safe_fps,
        niche=niche,
        caption_mode=normalize_caption_mode(mode),
        style_id=style_id or choose_default_style_for_niche(niche, mode),
        font_path=kwargs.get("font_path"),
        base_font_size=kwargs.get("base_font_size"),
        render_scale=1,
        cache_enabled=True,
        max_phrase_words=int(kwargs.get("max_phrase_words", 4)),
        min_caption_duration=float(kwargs.get("min_caption_duration", 0.10)),
        max_caption_duration=min(float(kwargs.get("max_caption_duration", 2.50)), 2.50),
        word_delay_fix=float(kwargs.get("word_delay_fix", 0.0)),
        end_padding=float(kwargs.get("end_padding", 0.04)),
        y_offset=int(kwargs.get("y_offset", 0)),
        uppercase=bool(kwargs.get("uppercase", True)),
        debug=bool(kwargs.get("debug", False)),
    )
    segments = build_segments(words, config)
    if not segments:
        return video
    segments = _caption_low_ram_limit_segments(segments, config.caption_mode, kwargs.get("max_caption_clips"))
    style = get_caption_style(config.style_id, fallback_mode=config.caption_mode)
    caption_clips = []
    for seg in segments:
        try:
            c = make_moviepy_caption_clip(seg, style, config)
            if c is not None:
                caption_clips.append(c)
        except MemoryError:
            safe_print("[CaptionEngine] LOW RAM: MemoryError while building caption clip; remaining captions skipped.")
            break
        except Exception as e:
            safe_print(f"[CaptionEngine] LOW RAM caption clip skipped: {e}")
    if not caption_clips:
        return video
    safe_print(f"[CaptionEngine] LOW RAM captions={len(caption_clips)} mode={config.caption_mode} style={config.style_id}")
    try:
        return CompositeVideoClip([video] + caption_clips, size=size).set_duration(video.duration)
    except MemoryError:
        safe_print("[CaptionEngine] LOW RAM Composite MemoryError; returning video without captions.")
        for c in caption_clips:
            try:
                c.close()
            except Exception:
                pass
        return video
    except Exception as e:
        safe_print(f"[CaptionEngine] LOW RAM Composite failed: {e}")
        return video
# ======================= END LOW RAM CAPTION PATCH =======================


