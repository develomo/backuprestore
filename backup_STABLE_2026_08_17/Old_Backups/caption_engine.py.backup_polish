        return video


def create_caption_clips(words: Any, size=(1080, 1920), style_id: Optional[str] = None, mode: str = "word_by_word", niche: str = "default", **kwargs):
    config = RenderConfig(
        size=tuple(size),
        niche=niche,
        caption_mode=normalize_caption_mode(mode),
        style_id=style_id or choose_default_style_for_niche(niche, mode),
        font_path=kwargs.get("font_path"),
        base_font_size=kwargs.get("base_font_size"),
        render_scale=int(kwargs.get("render_scale", 1)),
        cache_enabled=bool(kwargs.get("cache_enabled", True)),
        max_phrase_words=int(kwargs.get("max_phrase_words", 4)),
        word_delay_fix=float(kwargs.get("word_delay_fix", 0.0)),
        end_padding=float(kwargs.get("end_padding", 0.04)),
        y_offset=int(kwargs.get("y_offset", 0)),
        uppercase=bool(kwargs.get("uppercase", True)),
    )
    segments = build_segments(words, config)
    style = get_caption_style(config.style_id, fallback_mode=config.caption_mode)
    clips = []
    for seg in segments:
        c = make_moviepy_caption_clip(seg, style, config)
        if c is not None:
            clips.append(c)
    return clips


def render_caption_preview(style_id: str, mode: Optional[str] = None, size=(1080, 1920), text: Optional[str] = None) -> str:
    style = get_caption_style(style_id, fallback_mode=mode or "word_by_word")
    caption_mode = style.get("mode", normalize_caption_mode(mode or "word_by_word"))
    if text is None:
        text = style.get("preview_text", "FUTURE")
    token = CaptionToken(word=text, start=0.0, end=1.0)
    seg = CaptionSegment(text=text.upper(), start=0.0, end=1.0, words=[token], mode=caption_mode, style_id=style.get("id", style_id), index=0)
    config = RenderConfig(size=tuple(size), caption_mode=caption_mode, style_id=style.get("id", style_id), cache_enabled=False)
    img = render_text_image(seg, style, config)
    path = PREVIEW_DIR / f"{style.get('id', style_id)}_preview.png"
    img.save(path)
    return str(path)


def render_all_previews(size=(1080, 1920)) -> List[str]:
    paths = []
    for sid in list_style_ids():
        try:
            paths.append(render_caption_preview(sid, size=size))
        except Exception as e:
            safe_print(f"[CaptionEngine] Preview failed {sid}: {e}")
    return paths


def export_segments_json(words: Any, output_path: Any, style_id: Optional[str] = None, mode: str = "word_by_word", niche: str = "default") -> str:
    config = RenderConfig(niche=niche, caption_mode=normalize_caption_mode(mode), style_id=style_id or choose_default_style_for_niche(niche, mode))
    segments = build_segments(words, config)
    data = []
    for s in segments:
        data.append({
            "text": s.text,
            "start": s.start,
            "end": s.end,
            "mode": s.mode,
            "style_id": s.style_id,
            "index": s.index,
            "words": [w.__dict__ for w in s.words],
        })
    path = Path(output_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    return str(path)


def load_words_from_json(path: Any) -> List[CaptionToken]:
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    if isinstance(data, dict) and "words" in data:
        data = data["words"]
    return normalize_words(data)


def captions_from_text(text: str, words_per_second: float = 2.6) -> List[Dict[str, Any]]:
    text = clean_text(text)
    raw = text.split()
    out = []
    t = 0.0
    dur = 1.0 / max(0.5, float(words_per_second))
    for word in raw:
        out.append({"word": word, "start": round(t, 3), "end": round(t + dur, 3)})
        t += dur
    return out


def fix_caption_timing(words: Any, min_gap: float = 0.0, min_duration: float = 0.08) -> List[Dict[str, Any]]:
    tokens = normalize_words(words)
    out = []
    last_end = 0.0
    for token in tokens:
        start = max(token.start, last_end + min_gap)
        end = max(token.end, start + min_duration)
        out.append({"word": token.word, "start": round(start, 3), "end": round(end, 3), "confidence": token.confidence})
        last_end = end
    return out


def remove_empty_words(words: Any) -> List[Dict[str, Any]]:
    return [{"word": w.word, "start": w.start, "end": w.end, "confidence": w.confidence} for w in normalize_words(words)]


def group_words_for_phrase_captions(words: Any, max_words: int = 4) -> List[Dict[str, Any]]:
    tokens = normalize_words(words)
    groups = split_phrase_words(tokens, max_words=max_words)
    output = []
    for i, group in enumerate(groups):
        output.append({
            "text": words_to_plain_text(group),
            "start": group[0].start,
            "end": group[-1].end,
            "words": [w.__dict__ for w in group],
            "index": i,
        })
    return output


