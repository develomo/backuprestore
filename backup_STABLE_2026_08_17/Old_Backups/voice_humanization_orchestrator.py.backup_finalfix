def humanize_audio_file(
    input_audio,
    output_audio=None,
    profile=None,
    mode="short",
    render_plan=None,
    content_hint=None,
    add_room_tone=True,
    apply_tempo=True,
):
    """
    Main humanization function.

    Args:
        input_audio:
            source voice path.

        output_audio:
            output path. If None, generated automatically.

        profile:
            resolved voice profile dict.

        mode:
            short/long.

        render_plan:
            AI Editing Brain plan.

        content_hint:
            niche.

        add_room_tone:
            adds extremely quiet pink-noise texture.

        apply_tempo:
            applies tiny global tempo adjustment.

    Returns:
        output path string.
    """
    input_audio = Path(input_audio)

    if not input_audio.exists():
        raise FileNotFoundError(f"Input audio not found: {input_audio}")

    mode = _mode_key(mode)
    profile = _resolve_profile(profile=profile, content_hint=content_hint, render_plan=render_plan)

    if output_audio is None:
        output_audio = _output_path(input_audio, mode, profile)
    else:
        output_audio = Path(output_audio)

    output_audio.parent.mkdir(parents=True, exist_ok=True)

    temp_master = TEMP_DIR / f"{input_audio.stem}_master_{datetime.now().strftime('%Y%m%d_%H%M%S')}.wav"

    filter_chain, tempo_value = _build_main_filter(
        profile,
        mode=mode,
        apply_tempo=apply_tempo,
    )

    cmd = [
        "ffmpeg",
        "-y",
        "-i", str(input_audio),
        "-af", filter_chain,
        "-ar", "44100",
        "-ac", "2",
        str(temp_master),
    ]

    safe_print(
        f"[VoiceOrchestrator] Humanizing | mode={mode} | "
        f"profile={profile.get('name')} | tempo={tempo_value:.5f}"
    )

    _run_ffmpeg(cmd, label="voice_master")

    final_path = str(temp_master)

    if add_room_tone:
        duration = get_audio_duration(temp_master)
        room_tone = _generate_subtle_room_tone(
            duration=duration,
            output_path=TEMP_DIR / f"{input_audio.stem}_roomtone.wav",
            profile=profile,
        )

        final_path = _mix_room_tone(
            voice_path=temp_master,
            room_tone_path=room_tone,
            output_path=output_audio,
        )
    else:
        # Copy temp master to output path via ffmpeg for format consistency.
        cmd2 = [
            "ffmpeg",
            "-y",
            "-i", str(temp_master),
            "-ar", "44100",
            "-ac", "2",
            str(output_audio),
        ]
        _run_ffmpeg(cmd2, label="voice_output_copy")
        final_path = str(output_audio)

    entry = {
        "created_at": datetime.now().isoformat(timespec="seconds"),
        "input_audio": str(input_audio),
        "output_audio": str(final_path),
        "mode": mode,
        "profile": profile.get("name"),
        "tempo_value": tempo_value,
        "room_tone": bool(add_room_tone),
    }
    _append_log(entry)

    safe_print(f"[VoiceOrchestrator] Humanized voice ready: {final_path}")
    return str(final_path)


