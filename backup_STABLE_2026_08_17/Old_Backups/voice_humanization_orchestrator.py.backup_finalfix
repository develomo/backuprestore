def _generate_subtle_room_tone(duration, output_path, profile):
    """
    Generates very low volume noise texture.

    This is optional and extremely quiet.
    It helps avoid "digital dead silence" feel, but should not be heard.
    """
    duration = max(float(duration or 0), 0.1)
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    breath_db = _clamp(_safe_float(profile.get("breath_layer_db"), -38), -55, -26)

    # Convert dB to volume multiplier.
    # -38 dB is extremely quiet.
    volume = 10 ** (breath_db / 20.0)

    cmd = [
        "ffmpeg",
        "-y",
        "-f", "lavfi",
        "-i", f"anoisesrc=color=pink:duration={duration}:amplitude={volume}",
        "-ar", "44100",
        "-ac", "2",
        str(output_path),
    ]

    try:
        _run_ffmpeg(cmd, label="room_tone")
        return str(output_path)
    except Exception as e:
        safe_print(f"[VoiceOrchestrator] Room tone skipped: {e}")
        return None


def _mix_room_tone(voice_path, room_tone_path, output_path):
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    if not room_tone_path or not Path(room_tone_path).exists():
        return str(voice_path)

    cmd = [
        "ffmpeg",
        "-y",
        "-i", str(voice_path),
        "-i", str(room_tone_path),
        "-filter_complex",
        "[0:a][1:a]amix=inputs=2:duration=first:dropout_transition=0[aout]",
        "-map", "[aout]",
        "-ar", "44100",
        "-ac", "2",
        str(output_path),
    ]

    try:
        _run_ffmpeg(cmd, label="room_tone_mix")
        return str(output_path)
    except Exception as e:
        safe_print(f"[VoiceOrchestrator] Room tone mix skipped: {e}")
        return str(voice_path)


