def humanize_folder(folder_path, mode="short", content_hint=None):
    folder = Path(folder_path)

    if not folder.exists():
        return {}

    files = []
    for ext in (".mp3", ".wav", ".m4a", ".aac"):
        files.extend(folder.glob(f"*{ext}"))

    results = {}
    for f in sorted(files):
        try:
            results[str(f)] = humanize_audio_file(
                input_audio=f,
                output_audio=None,
                mode=mode,
                content_hint=content_hint,
            )
        except Exception as e:
            safe_print(f"[VoiceOrchestrator] Failed {f.name}: {e}")
            results[str(f)] = str(f)

    return results


def read_orchestrator_log():
    if not LOG_FILE.exists():
        return []
    try:
        return json.loads(LOG_FILE.read_text(encoding="utf-8"))
    except Exception:
        return []


