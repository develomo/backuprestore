import json
import subprocess
from pathlib import Path
from datetime import datetime

try:
    from voice_settings_manager import (
        resolve_voice_profile,
        resolve_voice_profile_for_render,
        sanitize_voice_profile,
        DEFAULT_PROFILE_NAME,
    )
except Exception:
    resolve_voice_profile = None
    resolve_voice_profile_for_render = None
    sanitize_voice_profile = None
    DEFAULT_PROFILE_NAME = "warm_measured"


BASE_DIR = Path(__file__).parent
OUT_DIR = BASE_DIR / "outputs" / "voice_orchestrator"
OUT_DIR.mkdir(parents=True, exist_ok=True)

TEMP_DIR = BASE_DIR / "outputs" / "temp_voice"
TEMP_DIR.mkdir(parents=True, exist_ok=True)

LOG_FILE = OUT_DIR / "voice_orchestrator_log.json"


# ==========================================================
# SAFE HELPERS
# ==========================================================

def safe_print(message):
    try:
        text = str(message).replace("→", "->").replace("—", "-").replace("–", "-")
        print(text, flush=True)
    except Exception:
        pass


def _mode_key(mode):
    mode = str(mode or "short").lower().strip()
    if mode in ("long", "youtube_long", "horizontal"):
        return "long"
    return "short"


def _safe_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return default


def _clamp(value, low, high):
    return max(low, min(high, value))


def _clean_file_stem(text):
    text = str(text or "voice")
    safe = "".join(ch if ch.isalnum() or ch in ("_", "-") else "_" for ch in text)
    return safe.strip("_") or "voice"


def _run_ffmpeg(cmd, label="ffmpeg"):
    safe_print(f"[VoiceOrchestrator] Running {label}...")

    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        shell=False,
    )

    if result.returncode != 0:
        safe_print(result.stderr)
        raise RuntimeError(f"{label} failed")

    return True


def _append_log(entry):
    try:
        data = []
        if LOG_FILE.exists():
            data = json.loads(LOG_FILE.read_text(encoding="utf-8"))
            if not isinstance(data, list):
                data = []
        data.append(entry)
        LOG_FILE.write_text(json.dumps(data[-300:], indent=2, ensure_ascii=False), encoding="utf-8")
    except Exception:
        pass


def _default_profile(content_hint=None):
    if resolve_voice_profile:
        try:
            return resolve_voice_profile(content_hint=content_hint)
        except Exception:
            pass

    return {
        "name": DEFAULT_PROFILE_NAME,
        "pitch_drift_cents": 28,
        "pace_variation_pct": 0.04,
        "pause_extension_ms": 100,
        "volume_variation_db": 1.2,
        "breath_layer_db": -38,
        "voice_gain": 1.03,
        "compression_ratio": 2.1,
        "highpass_hz": 80,
        "lowpass_hz": 11500,
        "description": "Fallback voice profile.",
    }


def _resolve_profile(profile=None, content_hint=None, render_plan=None):
    if profile:
        try:
            if sanitize_voice_profile:
                return sanitize_voice_profile(profile)
            return dict(profile)
        except Exception:
            return dict(profile)

    render_count = 0
    selected_profile = None

    if render_plan:
        try:
            content_hint = content_hint or render_plan.get("niche")
            selected_profile = render_plan.get("voice_plan", {}).get("profile_name")
            render_count = int(render_plan.get("variation_plan", {}).get("render_count", 0))
        except Exception:
            pass

    if resolve_voice_profile_for_render:
        try:
            return resolve_voice_profile_for_render(
                selected_profile=selected_profile,
                content_hint=content_hint,
                render_count=render_count,
                variation_strength=1.0,
            )
        except Exception:
            pass

    return _default_profile(content_hint=content_hint)


def _output_path(input_audio, mode, profile):
    input_audio = Path(input_audio)
    profile_name = _clean_file_stem(profile.get("name", "profile"))
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    return OUT_DIR / f"{input_audio.stem}_{mode}_{profile_name}_humanized_{ts}.wav"


# ==========================================================
# FFPROBE / DURATION
# ==========================================================

def get_audio_duration(path):
    path = Path(path)
    cmd = [
        "ffprobe",
        "-v", "error",
        "-show_entries", "format=duration",
        "-of", "json",
        str(path),
    ]

    result = subprocess.run(cmd, capture_output=True, text=True, shell=False)

    if result.returncode != 0:
        return 0.0

    try:
        return float(json.loads(result.stdout)["format"]["duration"])
    except Exception:
        return 0.0


