    if str(mode).upper() == "LONG":
        kinds.extend(["intro", "outro", "overlays"])
    for kind in kinds:
        clear_folder(asset_path(mode, kind))


def natural_key(path: Path) -> list:
    stem = Path(path).stem
    parts = []
    current = ""
    for char in stem:
        if char.isdigit():
            current += char
        else:
            if current:
                parts.append((0, int(current)))
                current = ""
            parts.append((1, char.lower()))
    if current:
        parts.append((0, int(current)))
    return parts


def list_files(folder: Path, exts: Optional[set] = None) -> List[Path]:
    folder = Path(folder)
    if not folder.exists():
        return []
    files = [item for item in folder.iterdir() if item.is_file()]
    if exts:
        files = [item for item in files if item.suffix.lower() in exts]
    try:
        return sorted(files, key=natural_key)
    except Exception:
        return sorted(files, key=lambda p: p.name.lower())


def save_uploaded_file(uploaded, target_folder: Path) -> Optional[Path]:
    if uploaded is None:
        return None
    clear_folder(target_folder)
    path = Path(target_folder) / uploaded.name
    path.write_bytes(uploaded.getbuffer())
    return path


def save_many_uploads(uploaded_files, target_folder: Path) -> List[Path]:
    if uploaded_files:
        clear_folder(target_folder)
    saved = []
    for uploaded in uploaded_files or []:
        path = Path(target_folder) / uploaded.name
        path.write_bytes(uploaded.getbuffer())
        saved.append(path)
    return saved


def file_count_label(folder: Path, exts: set) -> str:
    count = len(list_files(folder, exts))
    return f"{count} files"


