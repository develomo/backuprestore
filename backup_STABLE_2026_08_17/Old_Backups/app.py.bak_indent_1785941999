def run_render(mode: str, settings: Dict[str, Any], assets: Dict[str, Any], add_captions: bool, caption_mode: str, style_id: Optional[str], progress_bar, status) -> None:
    voice = assets.get("voice")
    clips = assets.get("clips") or []

    if not voice:
        status.write("Voice missing")
        return
    if not clips:
        status.write("Clips missing")
        return

    def update(value: int, label: str) -> None:
        progress_bar.progress(value)
        status.write(label)

    try:
        update(5, "Preparing")
        kwargs = build_render_kwargs(mode, settings, assets, add_captions, caption_mode, style_id)

        update(20, "Loading pipeline")
        if mode == "SHORT":
            pipeline = load_short_pipeline()
            if hasattr(pipeline, "run_integrated_short_pipeline"):
                fn = pipeline.run_integrated_short_pipeline
            elif hasattr(pipeline, "run_short_pipeline"):
                fn = pipeline.run_short_pipeline
            else:
                raise RuntimeError("Short pipeline function not found")
        else:
            pipeline = load_long_pipeline()
            if hasattr(pipeline, "run_integrated_long_pipeline"):
                fn = pipeline.run_integrated_long_pipeline
            elif hasattr(pipeline, "run_long_pipeline"):
                fn = pipeline.run_long_pipeline
            else:
                raise RuntimeError("Long pipeline function not found")

        update(40, "Rendering")
        result = call_supported(fn, kwargs)
        # Normalize audio to -14 LUFS
        if result and Path(str(result)).suffix in (".mp4", ".mkv", ".mov"):
            try:
                import subprocess, shutil as _sh
                norm = str(Path(result).with_stem(Path(result).stem + "_LUFS14"))
                cmd = [
                    "ffmpeg", "-y", "-i", str(result),
                    "-af", "loudnorm=I=-14:LRA=11:TP=-1.5",
                    "-c:v", "copy", "-c:a", "aac", "-b:a", "192k",
                    norm
                ]
                _sh.copy2(result, str(result) + ".prelufs.bak")
                subprocess.run(cmd, capture_output=True, text=True)
                if Path(norm).exists() and Path(norm).stat().st_size > 1000:
                    _sh.move(norm, result)
                    print(f"[LUFS] Normalized to -14 LUFS: {result}")
                else:
                    print("[LUFS] Normalization skipped (unchanged)")
            except Exception as e:
                print(f"[LUFS] Normalization error: {e}")

        update(100, "Done")
        st.session_state["latest_output"] = str(result)
        if mode == "LONG":
            st.session_state["latest_long_output"] = str(result)
        clear_mode_assets(mode)
        st.success(str(result))

        # ================================================================
        # PHASE 4: AUTO-COMPUTE SCORES AFTER RENDER (Surgical Addition)
        # ================================================================
        try:
            preset_num = st.session_state.get("editing_preset_number", 1)
            niche = settings.get("niche", "default")
            compute_render_scores(
                render_result_path=str(result),
                mode=mode,
                niche=niche,
                preset_number=preset_num
            )
        except Exception as score_err:
            print(f"[Phase4] Score compute skipped: {score_err}", flush=True)
        # ================================================================
        import gc
        gc.collect()
        # Clear any large temporary variables
        if 'kwargs' in locals(): del kwargs
        if 'result' in locals(): del result


    except Exception as exc:
        update(0, "Failed")
        st.error(str(exc))
        with st.expander("Error", expanded=True):
            st.code(traceback.format_exc())


