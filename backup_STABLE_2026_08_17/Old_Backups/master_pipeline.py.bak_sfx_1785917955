def _mp_premium_cut_plan(total_duration, clip_count):
    total_duration = max(0.1, _mp_premium_float(total_duration, 0.1))
    clip_count = max(1, _mp_premium_int(clip_count, 1))
    base = total_duration / clip_count

    if base < 3.0:
        durations = [base for _ in range(clip_count)]
    else:
        pattern = [2.9, 3.25, 3.8, 4.4, 5.1, 5.8, 4.6, 3.6, 6.2, 4.9, 5.4, 3.95]
        low = 2.6
        high = 6.8
        durations = []
        for i in range(clip_count):
            proposed = pattern[i % len(pattern)]
            blended = base * 0.70 + proposed * 0.30
            durations.append(max(low, min(high, blended)))

    scale = total_duration / max(0.1, sum(durations))
    durations = [max(0.20, d * scale) for d in durations]
    diff = total_duration - sum(durations)
    if durations:
        durations[-1] = max(0.20, durations[-1] + diff)
    return durations

def _mp_premium_chunk_size(total_duration, clip_count):
    total_duration = max(0.1, _mp_premium_float(total_duration, 0.1))
    clip_count = max(1, _mp_premium_int(clip_count, 1))
    raw = total_duration / clip_count
    if raw < 3.0:
        return max(0.5, raw)
    return max(2.8, min(6.8, raw))

def _mp_apply_caption_timing_offset(words, offset=-0.18):
    if not words:
        return words
    shifted = []
    offset = _mp_premium_float(offset, -0.18)
    try:
        iterable = words.get("words", []) if isinstance(words, dict) else words
    except Exception:
        return words

    for item in iterable:
        try:
            if isinstance(item, dict):
                x = dict(item)
                if "start" in x:
                    x["start"] = max(0.0, _mp_premium_float(x.get("start"), 0.0) + offset)
                if "end" in x:
                    x["end"] = max(_mp_premium_float(x.get("start"), 0.0) + 0.045, _mp_premium_float(x.get("end"), 0.2) + offset)
                shifted.append(x)
            else:
                shifted.append(item)
        except Exception:
            shifted.append(item)
    return shifted

