def _mp_natural_key_for_clips(path):
    stem = Path(path).stem
    out = []
    buf = ""
    for ch in stem:
        if ch.isdigit():
            buf += ch
        else:
            if buf:
                out.append((0, int(buf)))
                buf = ""
            out.append((1, ch.lower()))
    if buf:
        out.append((0, int(buf)))
    return out

def _mp_existing_clip_paths(clips):
    cleaned = []
    for item in clips or []:
        try:
            p = Path(item)
            if p.exists() and p.is_file():
