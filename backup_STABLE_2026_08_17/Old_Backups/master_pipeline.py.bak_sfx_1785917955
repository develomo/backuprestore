SFX_VOLUME_SAFE = 0.10
FAKE_CAPTION_WORDS_BLOCKLIST = {"warning", "impact", "now", "alert", "future", "power", "focus", "money"}

def _fix_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return float(default)

def _fix_is_fake_caption_words(words):
    if not words:
        return True
    cleaned = []
    try:
        iterable = words.get("words", []) if isinstance(words, dict) else words
        for item in iterable:
            if isinstance(item, dict):
                w = str(item.get("word", item.get("text", ""))).strip().lower()
            else:
                w = str(getattr(item, "word", item)).strip().lower()
            if w:
                cleaned.append(w)
    except Exception:
        return True
    if not cleaned:
        return True
    unique = set(cleaned)
    if unique.issubset(FAKE_CAPTION_WORDS_BLOCKLIST):
        return True
    if len(cleaned) <= 8 and len(unique.intersection(FAKE_CAPTION_WORDS_BLOCKLIST)) >= max(2, len(unique)-1):
        return True
    return False

def _fix_load_real_words(voice_path=None, words=None):
    if words and not _fix_is_fake_caption_words(words):
        return words
    if not voice_path:
        return []
    vp = Path(voice_path)
    candidates = [
        vp.with_suffix(".json"),
        vp.with_name(vp.stem + "_words.json"),
        vp.with_name(vp.stem + "_transcript.json"),
        vp.parent / "words.json",
        vp.parent / "transcript_words.json",
        vp.parent / "transcript.json",
    ]
    for c in candidates:
        try:
            loaded = load_words_json(c)
            if loaded and not _fix_is_fake_caption_words(loaded):
                return loaded
        except Exception:
            pass
    try:
        import whisper
        safe_print("[CaptionFix] Transcribing voice for real synced captions...")
        model = whisper.load_model("base")
        result = model.transcribe(str(vp), word_timestamps=True, fp16=False)
        real_words = []
        for seg in result.get("segments", []):
            for item in seg.get("words", []):
                word = str(item.get("word", "")).strip()
                start = item.get("start")
                end = item.get("end")
                if word and start is not None and end is not None:
                    real_words.append({"word": word, "start": float(start), "end": float(end)})
        if real_words and not _fix_is_fake_caption_words(real_words):
            try:
                vp.with_name(vp.stem + "_words.json").write_text(json.dumps(real_words, indent=2, ensure_ascii=False), encoding="utf-8")
            except Exception:
                pass
            return real_words
    except Exception as exc:
        safe_print(f"[CaptionFix] Whisper transcript unavailable. Captions disabled instead of fake words: {exc}")
    return []

def _fix_smart_chunk_size(total_duration, clip_count):
    total_duration = max(0.1, _fix_float(total_duration, 0.1))
    clip_count = max(1, int(clip_count or 1))
    raw = total_duration / clip_count
    if raw < SMART_CUT_MIN_SECONDS:
        return max(2.8, raw)
    return max(SMART_CUT_MIN_SECONDS, min(SMART_CUT_MAX_SECONDS, raw))

def _fix_normalize_captions(words=None, voice_path=None, add_captions=True, caption_mode="word_by_word", style_id=None):
    if add_captions is False or not style_id or str(caption_mode or "").lower() in ("none", "off", "false", "disabled"):
        return False, [], "none", None
    real_words = _fix_load_real_words(voice_path=voice_path, words=words)
    if not real_words:
        return False, [], "none", None
    return True, real_words, caption_mode, style_id

