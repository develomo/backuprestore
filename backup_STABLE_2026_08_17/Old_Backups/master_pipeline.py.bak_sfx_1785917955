# ========================= LOW RAM OPTIMIZATION PATCH =========================
# This patch is intentionally placed at the end of the file so Python uses these
# definitions instead of the earlier heavy definitions. The original functions
# above remain preserved. These overrides reduce MoviePy CompositeVideoClip RAM
# usage on 8GB RAM laptops by avoiding nested visual composites, lowering the
# temporary edit resolution, capping FPS during temp render, closing clips, and
# keeping final mux/export handled by the existing final_assembler pipeline.

LOW_RAM_RENDER = True
LOW_RAM_SHORT_SIZE = (720, 1280)
LOW_RAM_SHORT_FPS = 24
LOW_RAM_THREADS = 1


def _low_ram_close_clip(clip):
    try:
        if clip is not None:
            clip.close()
    except Exception:
        pass


def _low_ram_resize_video(video, size=LOW_RAM_SHORT_SIZE):
    if video is None:
        return video
    try:
        if tuple(getattr(video, "size", (0, 0))) == tuple(size):
            return video
    except Exception:
        pass
    try:
        return video.resize(newsize=size)
    except TypeError:
        try:
            return video.resize(size)
        except Exception:
            return video
    except Exception:
        return video


def _low_ram_effects_enabled():
    return not LOW_RAM_RENDER


def write_temp_video(video, output_path=None, fps=30):
    output_path = Path(output_path or TEMP_DIR / f"temp_short_video_low_ram_{int(time.time())}.mp4")
    output_path.parent.mkdir(parents=True, exist_ok=True)
    safe_fps = min(int(fps or LOW_RAM_SHORT_FPS), LOW_RAM_SHORT_FPS)
    render_video = _low_ram_resize_video(video, LOW_RAM_SHORT_SIZE) if LOW_RAM_RENDER else video
    safe_print(f"[MasterPipeline] LOW RAM temp render | size={getattr(render_video, 'size', None)} fps={safe_fps}")
    render_video.write_videofile(
        str(output_path),
        fps=safe_fps,
        codec="libx264",
        audio=False,
        preset="ultrafast",
        threads=LOW_RAM_THREADS,
        logger=None,
    )
    try:
        if render_video is not video:
            render_video.close()
    except Exception:
        pass
    return str(output_path)


def create_integrated_base_video_from_plan(plan, clips=None, apply_motion=True, apply_animation=True, apply_zoom=True):
    progress("Preparing LOW RAM integrated short clips", 1, 12)
    niche = plan.get("niche", "default")
    render_count = int(plan.get("render_count", 0))
    target_duration = float(plan.get("target_duration") or plan.get("voice_duration") or 0.0)
    sequence_paths = [Path(x["clip_path"]) for x in plan.get("clip_sequence", []) if isinstance(x, dict) and x.get("clip_path")]
    source_clips = list(clips or sequence_paths)
    if not source_clips:
        raise FileNotFoundError("Integrated master plan has no source clips.")
    formatted_clips = prepare_clip_sequence_for_duration(
        video_paths=source_clips,
        target_duration=target_duration,
        mode="SHORT",
        strategy="smart",
        quality="edit",
        chunk_size=float(plan.get("preset", {}).get("chunk_size", 8.0)),
        audio=False,
    )
    if not formatted_clips:
        raise RuntimeError("No formatted clips created in LOW RAM integrated pipeline.")
    processed = []
    for i, clip in enumerate(formatted_clips):
        current = clip
        if not LOW_RAM_RENDER and apply_motion:
            try:
                current = apply_human_motion_to_clip(current, mode="SHORT", niche=niche, render_count=render_count + i, clip_index=i)
            except TypeError:
                current = apply_human_motion_to_clip(current, mode="SHORT", niche=niche, render_count=render_count + i)
            except Exception as e:
                safe_print(f"[MasterPipeline] LOW RAM motion skipped on clip {i}: {e}")
        if not LOW_RAM_RENDER and apply_animation:
            try:
                current = apply_auto_animation(current, niche=niche, mode="SHORT", render_count=render_count + i, clip_index=i)
            except Exception as e:
                safe_print(f"[MasterPipeline] LOW RAM animation skipped on clip {i}: {e}")
        if not LOW_RAM_RENDER and apply_zoom:
            try:
                current = apply_auto_zoom(current, niche=niche, mode="SHORT", render_count=render_count + i, clip_index=i)
            except Exception as e:
                safe_print(f"[MasterPipeline] LOW RAM zoom skipped on clip {i}: {e}")
        try:
            current = _low_ram_resize_video(current, LOW_RAM_SHORT_SIZE)
        except Exception:
            pass
        processed.append(current)
    progress("Concatenating LOW RAM short clips", 2, 12)
    video = concatenate_formatted_clips(processed, target_duration=target_duration)
    if video is None:
        raise RuntimeError("LOW RAM integrated short video concatenate failed.")
    return video


def apply_integrated_visual_layers(
    video,
    plan,
    add_captions=True,
    add_keyword_zoom=True,
    add_beat=True,
    add_story=True,
):
    words = plan.get("caption_setup", {}).get("words") or []
    niche = plan.get("niche", "default")
    render_count = int(plan.get("render_count", 0))
