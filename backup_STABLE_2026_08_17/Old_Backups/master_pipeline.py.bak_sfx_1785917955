def build_deep_integrated_master_plan(
    voice_path=None,
    clips=None,
    words=None,
    mode="SHORT",
    niche="default",
    render_count=0,
    caption_mode="word_by_word",
    style_id=None,
    preset_overrides=None,
):
    voice_path = Path(voice_path) if voice_path else choose_default_voice(mode)
    if voice_path is None:
        raise FileNotFoundError("No voice file found for integrated master plan.")
    voice_duration = get_voice_duration_float(voice_path)
    export_duration_data = build_export_duration(voice_path=voice_path, voice_duration=voice_duration, mode=mode)
    final_duration = float(export_duration_data.get("export_duration") or export_duration_data.get("final_duration") or voice_duration)
    preset = build_preset(mode=mode, niche=niche, overrides=preset_overrides or {})
    assets = list_assets(mode)
    clips = list(clips or assets["clips"])
    if not clips:
        raise FileNotFoundError("No clips found for integrated master plan.")
    viral_plan = build_viral_clip_plan(
        duration=final_duration,
        clips=clips,
        words=words or [],
        mode=mode,
        niche=niche,
        render_count=render_count,
        hook_text=None,
    )
    pacing_plan = build_pacing_plan(
        final_duration,
        mode=mode,
        niche=niche,
        render_count=render_count,
        max_clips=500,
        prefer_viral=True,
    )
    pacing_plan = add_retention_flags(pacing_plan, mode=mode, niche=niche)
    brain_sequence = build_brain_render_plan(
        clips,
        pacing_plan,
        niche=niche,
        mode=mode,
        render_count=render_count,
    )
    if not brain_sequence:
        brain_sequence = build_smart_clip_sequence(
            clips,
            pacing_plan,
            words=words or [],
            niche=niche,
            render_count=render_count,
        )
    caption_setup = ensure_caption_setup_safe(
        words or [],
        style_id=style_id or preset.get("caption_style"),
        mode=caption_mode or preset.get("caption_mode", "word_by_word"),
        niche=niche,
        video_type=mode,
    )
    audio_plan = {
        "music": build_music_plan(duration=final_duration, mode=mode, niche=niche, render_count=render_count),
        "sfx": build_sfx_plan(duration=final_duration, mode=mode, niche=niche, render_count=render_count, words=words or []),
    }
    validation = {
        "clip_sequence": validate_clip_sequence(brain_sequence, total_duration=final_duration),
        "duration": export_duration_data,
        "pipeline_settings": decide_pipeline_settings(mode=mode, niche=niche, duration=final_duration, render_count=render_count),
    }
    return {
        "voice_path": str(voice_path),
        "voice_duration": voice_duration,
        "target_duration": final_duration,
        "mode": _mode_key(mode),
        "niche": niche,
        "render_count": int(render_count or 0),
        "preset": preset,
        "viral_plan": viral_plan,
        "pacing_plan": pacing_plan,
        "clip_sequence": brain_sequence,
        "clip_usage": build_clip_usage_report(brain_sequence),
        "caption_setup": caption_setup,
        "audio_plan": audio_plan,
        "validation": validation,
        "clip_count": len(clips),
    }


def create_integrated_base_video_from_plan(plan, clips=None, apply_motion=True, apply_animation=True, apply_zoom=True):
    progress("Preparing integrated formatted clips", 1, 12)
    mode = plan.get("mode", "SHORT")
    niche = plan.get("niche", "default")
    render_count = int(plan.get("render_count", 0))
    target_duration = float(plan.get("target_duration") or plan.get("voice_duration") or 0.0)
    sequence_paths = [Path(x["clip_path"]) for x in plan.get("clip_sequence", []) if x.get("clip_path")]
    source_clips = list(clips or sequence_paths)
    if not source_clips:
        raise FileNotFoundError("Integrated plan has no source clips.")
    formatted_clips = prepare_clip_sequence_for_duration(
        video_paths=source_clips,
        target_duration=target_duration,
        mode=mode,
        strategy="smart",
        quality="edit",
        chunk_size=float(plan.get("preset", {}).get("chunk_size", 8.0)),
        audio=False,
    )
    if not formatted_clips:
        raise RuntimeError("No formatted clips created in integrated pipeline.")
    processed = []
    for i, clip in enumerate(formatted_clips):
        current = clip
        if apply_motion:
            try:
                current = apply_human_motion_to_clip(current, mode=mode, niche=niche, render_count=render_count + i, clip_index=i)
            except Exception as e:
                safe_print(f"[MasterPipeline] integrated human motion skipped on clip {i}: {e}")
        if apply_animation:
            try:
                current = apply_auto_animation(current, niche=niche, mode=mode, render_count=render_count + i, clip_index=i)
            except Exception as e:
                safe_print(f"[MasterPipeline] integrated animation skipped on clip {i}: {e}")
        if apply_zoom:
            try:
                current = apply_auto_zoom(current, niche=niche, mode=mode, render_count=render_count + i, clip_index=i)
            except Exception as e:
                safe_print(f"[MasterPipeline] integrated zoom skipped on clip {i}: {e}")
        processed.append(current)
    progress("Applying integrated transitions and concatenate", 2, 12)
    try:
        transitioned = apply_auto_transitions(processed, mode=mode, niche=niche, render_count=render_count, timeline_plan=plan.get("pacing_plan"))
        if transitioned is not None:
            return transitioned
    except Exception as e:
        safe_print(f"[MasterPipeline] integrated transitions skipped: {e}")
    video = concatenate_formatted_clips(processed, target_duration=target_duration)
    if video is None:
        raise RuntimeError("Integrated video concatenate failed.")
    return video


def apply_integrated_visual_layers(
    video,
    plan,
    add_captions=True,
    add_keyword_zoom=True,
    add_beat=True,
    add_story=True,
):
    words = plan.get("caption_setup", {}).get("words") or []
    mode = plan.get("mode", "SHORT")
    niche = plan.get("niche", "default")
    render_count = int(plan.get("render_count", 0))
    caption_setup = plan.get("caption_setup", {})
    if add_keyword_zoom and words:
        progress("Applying integrated keyword zoom", 3, 12)
        try:
            video = apply_keyword_zoom(video, words, niche=niche, mode=mode, caption_mode=caption_setup.get("mode"), render_count=render_count)
        except TypeError:
            video = apply_keyword_zoom(video, words, niche=niche, mode=mode, caption_mode=caption_setup.get("mode"))
        except Exception as e:
            safe_print(f"[MasterPipeline] integrated keyword zoom skipped: {e}")
    if add_beat:
        progress("Applying integrated beat sync", 4, 12)
        try:
            video = apply_beat_sync(video, duration=video.duration, words=words, mode=mode, niche=niche, render_count=render_count, use_flash=True, use_pulse=False)
        except Exception:
            try:
                video = apply_beat_flashes(video, duration=video.duration, mode=mode, niche=niche, render_count=render_count)
            except Exception as e:
                safe_print(f"[MasterPipeline] integrated beat sync skipped: {e}")
    if add_story:
        progress("Applying integrated story flow", 5, 12)
        try:
            video = apply_story_flow(video, words=words, mode=mode, niche=niche, render_count=render_count, show_markers=True)
        except TypeError:
            video = apply_story_flow(video, mode=mode, niche=niche, render_count=render_count)
        except Exception as e:
            safe_print(f"[MasterPipeline] integrated story flow skipped: {e}")
    if add_captions and words:
        progress("Adding integrated captions", 6, 12)
        try:
            video = add_captions_to_video(
                video,
                words,
                style_id=caption_setup.get("style_id"),
                mode=caption_setup.get("mode", "word_by_word"),
                niche=niche,
            )
        except Exception as e:
            safe_print(f"[MasterPipeline] integrated captions skipped: {e}")
    return video


def apply_integrated_hook(video, plan, hook_text=None, use_hook=True):
    if not use_hook:
        return video
    progress("Adding integrated hook", 7, 12)
    mode = plan.get("mode", "SHORT")
    niche = plan.get("niche", "default")
    render_count = int(plan.get("render_count", 0))
    text = hook_text or plan.get("viral_plan", {}).get("hook_text") or choose_viral_hook_text(niche=niche, render_count=render_count)
    try:
        hook = create_hook_clip(mode=mode, niche=niche, render_count=render_count, hook_text=text)
        if hook is not None:
            return prepend_hook_to_video(video, hook)
    except Exception as e:
        safe_print(f"[MasterPipeline] integrated hook skipped: {e}")
    return video


def build_integrated_audio_for_pipeline(voice_path, plan, music_path=None, sfx_files=None, clean_silence=False):
