def _auto_caption_words_if_missing(words=None, voice_path=None, duration=None, caption_mode="word_by_word", style_id=None):
    existing = list(words or [])
    if existing:
        return existing
    duration = float(duration or 0.0)
    if duration <= 0 and voice_path:
        try:
            duration = float(get_voice_duration_float(voice_path) or 0.0)
        except Exception:
            duration = 0.0
    duration = max(duration, 6.0)
    mode = str(caption_mode or "word_by_word").lower()
    base_text = _caption_patch_style_text(style_id=style_id, mode=mode)
    raw = [w for w in str(base_text).split() if w]
    if not raw:
        raw = ["FOCUS", "POWER", "FUTURE"]
    if mode in ("phrase", "group", "3_to_4_words", "3-4", "line"):
        # group captions still need word timestamps; caption_engine will group them into phrases.
        words_per_second = 2.2
    else:
        words_per_second = 2.6
    step = 1.0 / max(0.8, words_per_second)
    out = []
    t = 0.0
    idx = 0
    while t < duration - 0.05:
        word = raw[idx % len(raw)]
        out.append({"word": word, "start": round(t, 3), "end": round(min(t + step * 0.92, duration), 3)})
        t += step
        idx += 1
    safe_print(f"[MasterPipeline] Auto caption words generated: {len(out)} mode={caption_mode} style={style_id}")
    return out


def _dynamic_chunk_size_for_all_clips(target_duration, clip_count, default_chunk=8.0):
    try:
        target_duration = float(target_duration or 0.0)
        clip_count = int(clip_count or 0)
        if target_duration > 0 and clip_count > 0:
            return max(2.0, min(float(default_chunk), target_duration / float(clip_count)))
    except Exception:
        pass
    return float(default_chunk or 8.0)


def _quality_resize_video(video, size):
    if video is None:
        return video
    try:
        if tuple(getattr(video, "size", (0, 0))) == tuple(size):
            return video
    except Exception:
        pass
    try:
        return video.resize(newsize=size)
    except TypeError:
        try:
            return video.resize(size)
        except Exception:
            return video
    except Exception:
        return video


def write_temp_video(video, output_path=None, fps=30):
    output_path = Path(output_path or TEMP_DIR / f"temp_short_video_quality_{int(time.time())}.mp4")
    output_path.parent.mkdir(parents=True, exist_ok=True)
    primary_fps = min(int(fps or QUALITY_SHORT_FPS), QUALITY_SHORT_FPS)
    render_video = _quality_resize_video(video, QUALITY_SHORT_SIZE)
    try:
        safe_print(f"[MasterPipeline] QUALITY temp render | size={getattr(render_video, 'size', None)} fps={primary_fps}")
        render_video.write_videofile(str(output_path), fps=primary_fps, codec="libx264", audio=False, preset="ultrafast", threads=1, logger=None)
    except MemoryError:
        safe_print("[MasterPipeline] 1080p temp render MemoryError -> retrying safe 720p fallback.")
        try:
