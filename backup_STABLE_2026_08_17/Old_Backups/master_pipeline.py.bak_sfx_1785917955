    _root_original_create_integrated_base_video_from_plan = create_integrated_base_video_from_plan
    def create_integrated_base_video_from_plan(plan, clips=None):
        clip_list = root_quality_extract_plan_clips(plan, clips=clips)
        target_duration = root_quality_get_plan_duration(plan)
        if target_duration <= 0:
            try:
                target_duration = float(plan.get("duration", 0.0))
            except Exception:
                target_duration = 0.0
        if target_duration <= 0:
            target_duration = max(1.0, len(clip_list) * 5.0)

        safe_print(f"[RootQuality] rebuild integrated base | duration={target_duration:.2f}s | clips={len(clip_list)}")
        prepared = root_quality_prepare_clips(
            clips=clip_list,
            target_duration=target_duration,
            mode="SHORT",
            quality="high",
            audio=False,
        )
        if prepared:
            video = root_quality_concatenate(prepared, target_duration=target_duration)
            if video is not None:
                return video

        safe_print("[RootQuality] dynamic builder empty, falling back to original integrated base builder")
        return _root_original_create_integrated_base_video_from_plan(plan, clips=clips)
except Exception as exc:
    try:
        safe_print(f"[RootQuality] create_integrated_base_video_from_plan patch failed: {exc}")
