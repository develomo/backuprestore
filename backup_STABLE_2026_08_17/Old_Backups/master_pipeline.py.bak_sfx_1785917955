def captions_enabled_for_render(add_captions=True, caption_enabled=True, caption_mode=None, style_id=None, **kwargs):
    if add_captions is False or caption_enabled is False:
        return False
    if str(caption_mode or "none").lower() in ("none", "off", "false", "disabled"):
        return False
    if not style_id:
        return False
    return True

def normalize_caption_selection(add_captions=True, caption_enabled=True, caption_mode=None, style_id=None, default_mode="word_by_word"):
    enabled = captions_enabled_for_render(add_captions=add_captions, caption_enabled=caption_enabled, caption_mode=caption_mode, style_id=style_id)
    if not enabled:
        return {"add_captions": False, "caption_mode": "none", "style_id": None}
    mode = str(caption_mode or default_mode).lower()
    if mode in ("phrase", "group", "3_to_4_words", "3-4", "line"):
        mode = "phrase"
    else:
        mode = "word_by_word"
    return {"add_captions": True, "caption_mode": mode, "style_id": style_id}

