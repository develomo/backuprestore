def run_short_pipeline(
    voice_path=None,
    clips=None,
    words=None,
    words_path=None,
    transcript_text=None,
    output_path=None,
    niche="default",
    render_count=0,
    caption_mode="word_by_word",
    style_id=None,
    music_path=None,
    sfx_files=None,
    use_hook=True,
    hook_text=None,
    final_4k=True,
    fps=30,
    quality="high",
    clean_silence=False,
    add_captions=True,
):
    started = time.time()
    log = {"started": started, "niche": niche, "render_count": render_count}
    video_obj = None
    try:
        mode = "SHORT"
        voice_path = Path(voice_path) if voice_path else choose_default_voice(mode)
        if voice_path is None:
            raise FileNotFoundError("Voice missing.")
        voice_path = _validate_file(voice_path, "voice")
        assets = list_assets(mode)
        clips = list(clips or assets["clips"])
        if not clips:
            raise FileNotFoundError("Clips missing.")
        if words_path and not words:
            words = load_words_json(words_path)
        if transcript_text and not words:
            words = transcript_to_fake_words(transcript_text)
        words = words or []
        music_path = music_path or choose_default_music(mode, render_count=render_count)
        voice_duration = get_voice_duration_float(voice_path)
        export_plan = build_export_duration_plan(voice_path, target_mode=mode)
        target_duration = float(export_plan.get("final_duration") or min(voice_duration, 89.5))
        plan = build_pipeline_plan(voice_path=voice_path, clips=clips, mode=mode, niche=niche, render_count=render_count, words=words, style_id=style_id, caption_mode=caption_mode)
        log["plan"] = plan
        video_obj = create_base_video(clips, target_duration=target_duration, mode=mode, niche=niche, render_count=render_count, apply_motion=True)
        video_obj = apply_visual_layers(video_obj, words=words, mode=mode, niche=niche, render_count=render_count, caption_mode=caption_mode, style_id=style_id, add_captions=add_captions)
        video_obj = apply_hook_layer(video_obj, mode=mode, niche=niche, render_count=render_count, hook_text=hook_text, use_hook=use_hook)
        temp_video = write_temp_video(video_obj, fps=fps)
        log["temp_video"] = temp_video
        audio_mix = build_audio_for_pipeline(voice_path, mode=mode, niche=niche, render_count=render_count, music_path=music_path, sfx_files=sfx_files or assets["sfx"], clean_silence=clean_silence)
        log["audio_mix"] = audio_mix
        final = export_final_pipeline_video(temp_video, audio_mix, output_path=output_path, mode=mode, final_4k=final_4k, fps=fps, quality=quality)
        log["final"] = final
        log["duration_seconds"] = round(time.time() - started, 3)
        save_pipeline_log(log)
        progress("Done", 9, 9)
        return final
    except Exception as e:
        log["error"] = str(e)
        log["traceback"] = traceback.format_exc()
        save_pipeline_log(log)
        raise
    finally:
        try:
            if video_obj is not None:
                video_obj.close()
        except Exception:
            pass


def save_pipeline_log(log, output_path=None):
    output_path = Path(output_path or LOG_DIR / f"master_pipeline_{int(time.time())}.json")
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(log, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
    return str(output_path)


