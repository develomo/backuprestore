    if not LOW_RAM_RENDER:
        if add_keyword_zoom and words:
            progress("Applying integrated keyword zoom", 3, 12)
            try:
                video = apply_keyword_zoom(video, words, niche=niche, mode=plan.get("mode", "SHORT"), caption_mode=caption_setup.get("mode"), render_count=render_count)
            except TypeError:
                video = apply_keyword_zoom(video, words, niche=niche, mode=plan.get("mode", "SHORT"), caption_mode=caption_setup.get("mode"))
            except Exception as e:
                safe_print(f"[MasterPipeline] integrated keyword zoom skipped: {e}")
        if add_beat:
            progress("Applying integrated beat sync", 4, 12)
            try:
                video = apply_beat_sync(video, duration=video.duration, words=words, mode=plan.get("mode", "SHORT"), niche=niche, render_count=render_count, use_flash=True, use_pulse=False)
            except Exception:
                try:
                    video = apply_beat_flashes(video, duration=video.duration, mode=plan.get("mode", "SHORT"), niche=niche, render_count=render_count)
                except Exception as e:
                    safe_print(f"[MasterPipeline] integrated beat sync skipped: {e}")
        if add_story:
            progress("Applying integrated story flow", 5, 12)
            try:
                video = apply_story_flow(video, words=words, mode=plan.get("mode", "SHORT"), niche=niche, render_count=render_count, show_markers=True)
            except TypeError:
                video = apply_story_flow(video, mode=plan.get("mode", "SHORT"), niche=niche, render_count=render_count)
            except Exception as e:
                safe_print(f"[MasterPipeline] integrated story flow skipped: {e}")
    else:
        progress("LOW RAM visual layers: heavy zoom/beat/story skipped safely", 5, 12)
    if add_captions and words:
        progress("Adding LOW RAM integrated captions", 6, 12)
        try:
            video = add_captions_to_video(
                video,
                words,
                style_id=caption_setup.get("style_id"),
                mode=caption_setup.get("mode", "word_by_word"),
                niche=niche,
                fps=LOW_RAM_SHORT_FPS,
                render_scale=1,
                cache_enabled=True,
                max_caption_clips=160,
            )
        except TypeError:
            try:
                video = add_captions_to_video(video, words, style_id=caption_setup.get("style_id"), mode=caption_setup.get("mode", "word_by_word"), niche=niche)
            except Exception as e:
                safe_print(f"[MasterPipeline] LOW RAM captions skipped: {e}")
        except Exception as e:
            safe_print(f"[MasterPipeline] LOW RAM captions skipped: {e}")
    return video


