        except Exception:
            pass
    return sorted(cleaned, key=_mp_natural_key_for_clips)

def _mp_duration_from_voice_or_plan(voice_path=None, plan=None, fallback=0.0):
    if isinstance(plan, dict):
        for key in ("final_duration", "export_duration", "target_duration", "duration", "voice_duration"):
