def _mp_premium_prepare_clips(clips, target_duration, mode="SHORT", quality="balanced", preset_overrides=None):
    clip_paths = _mp_existing_clip_paths(clips)
    if not clip_paths:
        _mp_premium_safe_print("[MasterPremium] No valid clip paths found.")
        return []

    target_duration = max(0.1, _mp_premium_float(target_duration, len(clip_paths) * 4.0))
    chunk_size = _mp_premium_chunk_size(target_duration, len(clip_paths))
    _mp_premium_safe_print(f"[MasterPremium] Preparing all clips | clips={len(clip_paths)} | duration={target_duration:.2f}s | chunk={chunk_size:.2f}s")

    try:
        prepared = prepare_clip_sequence_for_duration(
            video_paths=clip_paths,
            target_duration=target_duration,
            mode=mode,
            strategy="premium_all_clips_dynamic",
            quality=quality,
            chunk_size=chunk_size,
            audio=False,
        )
        if prepared and len(prepared) >= len(clip_paths):
            return prepared
        if prepared:
            _mp_premium_safe_print(f"[MasterPremium] Formatter returned {len(prepared)}/{len(clip_paths)} clips. Retrying safer all-clips chunk.")
    except Exception as exc:
        _mp_premium_safe_print(f"[MasterPremium] Formatter failed: {exc}")

    safe_chunk = max(0.5, target_duration / max(1, len(clip_paths)))
    try:
        return prepare_clip_sequence_for_duration(
            video_paths=clip_paths,
            target_duration=target_duration,
            mode=mode,
            strategy="force_all_clips",
            quality="edit",
            chunk_size=safe_chunk,
