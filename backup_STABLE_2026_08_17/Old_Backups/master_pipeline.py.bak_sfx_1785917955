def premium_build_cut_duration_plan(total_duration, clip_count, mode="SHORT"):
    total_duration = max(0.1, _premium_patch_safe_float(total_duration, 0.1))
    clip_count = max(1, int(clip_count or 1))
    base = total_duration / clip_count
    if mode == "SHORT":
        pattern = [2.8, 3.2, 3.8, 4.4, 5.0, 5.6, 4.2, 3.6, 5.8, 4.8]
        low, high = 2.4, 6.8
    else:
        pattern = [4.5, 5.0, 5.6, 6.2, 6.8, 7.4, 5.8, 6.5, 7.0, 5.2]
        low, high = 4.0, 8.0
    if base < low:
        durations = [base for _ in range(clip_count)]
    else:
        durations = []
        for i in range(clip_count):
            proposed = pattern[i % len(pattern)]
            blended = base * 0.70 + proposed * 0.30
            durations.append(max(low, min(high, blended)))
    scale = total_duration / max(0.1, sum(durations))
    durations = [max(0.2, d * scale) for d in durations]
    if durations:
        durations[-1] = max(0.2, durations[-1] + (total_duration - sum(durations)))
    return durations

