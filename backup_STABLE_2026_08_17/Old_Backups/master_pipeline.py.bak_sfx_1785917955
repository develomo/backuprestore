# ROOT QUALITY INTEGRATED PIPELINE REBUILD
# Fixes: No formatted clips created in QUALITY integrated pipeline.
# Applies all-clips dynamic fit directly inside integrated base builder.
# ============================================================

ROOT_QUALITY_MIN_SECONDS = 2.8
ROOT_QUALITY_IDEAL_MIN_SECONDS = 5.0
ROOT_QUALITY_IDEAL_MAX_SECONDS = 7.0

def root_quality_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return float(default)

def root_quality_natural_key(path):
    stem = Path(path).stem
    parts = []
    cur = ""
    for ch in stem:
        if ch.isdigit():
            cur += ch
        else:
            if cur:
                parts.append((0, int(cur)))
                cur = ""
            parts.append((1, ch.lower()))
    if cur:
        parts.append((0, int(cur)))
    return parts

def root_quality_clip_duration(clip):
    try:
        return max(0.05, float(clip.duration))
    except Exception:
        return 0.05

def root_quality_duration_plan(total_duration, clip_count):
    total_duration = max(0.1, root_quality_float(total_duration, 0.1))
    clip_count = max(1, int(clip_count or 1))
    base = total_duration / clip_count
    pattern = [5.0, 5.5, 6.0, 6.5, 7.0, 5.25, 6.25, 5.75, 6.75, 5.4, 6.4, 5.9]
    if base < ROOT_QUALITY_IDEAL_MIN_SECONDS:
        durations = [base for _ in range(clip_count)]
    else:
        durations = []
        for i in range(clip_count):
            proposed = pattern[i % len(pattern)]
            blended = (base * 0.72) + (proposed * 0.28)
            durations.append(max(ROOT_QUALITY_MIN_SECONDS, min(ROOT_QUALITY_IDEAL_MAX_SECONDS, blended)))
    scale = total_duration / max(0.1, sum(durations))
    durations = [max(0.2, d * scale) for d in durations]
    diff = total_duration - sum(durations)
    if durations:
        durations[-1] = max(0.2, durations[-1] + diff)
    return durations

def root_quality_get_plan_duration(plan):
    if isinstance(plan, dict):
        for key in ["target_duration", "duration", "voice_duration", "final_duration"]:
            if key in plan and root_quality_float(plan.get(key), 0.0) > 0:
                return root_quality_float(plan.get(key), 0.0)
        voice_path = plan.get("voice_path") or plan.get("voice") or plan.get("audio_path")
        if voice_path:
            try:
                return float(get_voice_duration_float(voice_path))
            except Exception:
                pass
    return 0.0

def root_quality_open_clip(path, audio=False):
    try:
        return VideoFileClip(str(path), audio=audio)
    except TypeError:
        clip = VideoFileClip(str(path))
        if not audio:
            try:
                clip = clip.without_audio()
            except Exception:
                pass
        return clip

def root_quality_subclip(clip, wanted, index=0):
    wanted = max(0.1, root_quality_float(wanted, 0.1))
    source = root_quality_clip_duration(clip)
    if source <= wanted:
        try:
            return clip.subclip(0, source)
        except Exception:
            return clip
    max_start = max(0.0, source - wanted)
    start = 0.0
    if max_start > 0.25:
        start = max_start * ((index % 5) / 5.0)
    try:
        return clip.subclip(start, start + wanted)
    except Exception:
        try:
            return clip.subclip(0, wanted)
        except Exception:
            return clip

def root_quality_format_clip(clip, mode="SHORT", quality="high"):
    try:
        return format_clip_by_mode(clip, mode=mode, strategy="smart_all_clips_fit_root_quality", quality=quality)
    except TypeError:
        try:
            return format_clip_by_mode(clip, mode=mode, quality=quality)
        except Exception:
            return clip
    except Exception:
        return clip

def root_quality_prepare_clips(clips, target_duration, mode="SHORT", quality="high", audio=False):
    paths = [Path(p) for p in clips or [] if Path(p).exists()]
    paths = sorted(paths, key=root_quality_natural_key)
    if not paths:
        safe_print("[RootQuality] no source clip paths found")
        return []
    target_duration = max(0.1, root_quality_float(target_duration, 0.1))
    durations = root_quality_duration_plan(target_duration, len(paths))
    prepared = []
    for i, path in enumerate(paths):
        clip = None
        try:
            clip = root_quality_open_clip(path, audio=audio)
            wanted = durations[i] if i < len(durations) else target_duration / max(1, len(paths))
            clip = root_quality_subclip(clip, wanted=wanted, index=i)
            clip = root_quality_format_clip(clip, mode=mode, quality=quality)
            prepared.append(clip)
            safe_print(f"[RootQuality] include {i+1}/{len(paths)} {path.name} duration={wanted:.2f}s")
        except Exception as exc:
            safe_print(f"[RootQuality] failed {path.name}: {exc}")
            try:
                if clip:
                    clip.close()
            except Exception:
                pass
    return prepared

def root_quality_concatenate(clips, target_duration):
    clips = [c for c in clips or [] if c is not None]
    if not clips:
        return None
    try:
        video = concatenate_videoclips(clips, method="compose")
    except Exception:
        video = concatenate_videoclips(clips)
    try:
        if target_duration and video.duration > target_duration:
            video = video.subclip(0, target_duration)
    except Exception:
        pass
    return video

def root_quality_extract_plan_clips(plan, clips=None):
    if clips:
        return list(clips)
    if isinstance(plan, dict):
        for key in ["clips", "video_paths", "clip_paths", "source_clips"]:
            found = plan.get(key)
            if found:
                return list(found)
    return []

