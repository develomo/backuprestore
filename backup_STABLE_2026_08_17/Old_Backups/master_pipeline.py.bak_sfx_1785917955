def real_caption_save_words(voice_path, words):
    try:
        vp = Path(voice_path)
        out = vp.with_name(vp.stem + "_words.json")
        out.write_text(json.dumps(words, indent=2, ensure_ascii=False), encoding="utf-8")
        real_caption_safe_print(f"[RealCaption] saved transcript words: {out}")
    except Exception as exc:
        real_caption_safe_print(f"[RealCaption] could not save transcript json: {exc}")

def real_caption_transcribe_voice(voice_path):
    if not voice_path:
        return []
    vp = Path(voice_path)
    if not vp.exists():
        return []

    for candidate in real_caption_json_candidates(vp):
        loaded = real_caption_load_json(candidate)
        if loaded and not real_caption_is_fake(loaded):
            real_caption_safe_print(f"[RealCaption] loaded real words from: {candidate}")
            return loaded

    try:
        import whisper
        real_caption_safe_print("[RealCaption] Whisper transcribing uploaded voice. First time can take a little while.")
        model = whisper.load_model("base")
        result = model.transcribe(
            str(vp),
            word_timestamps=True,
            fp16=False,
            verbose=False,
            task="transcribe",
            language=None,
        )
        words = []
        for seg in result.get("segments", []):
            seg_words = seg.get("words", [])
            if seg_words:
                for item in seg_words:
                    word = str(item.get("word", "")).strip()
                    start = item.get("start")
                    end = item.get("end")
                    if word and start is not None and end is not None:
                        words.append({"word": word, "start": float(start), "end": float(end)})
            else:
                text = str(seg.get("text", "")).strip()
                start = float(seg.get("start", 0.0) or 0.0)
                end = float(seg.get("end", start + 0.5) or start + 0.5)
                parts = text.split()
                if parts:
                    step = max(0.05, (end - start) / len(parts))
                    for i, word in enumerate(parts):
                        words.append({"word": word, "start": start + i * step, "end": start + (i + 1) * step})
        if words and not real_caption_is_fake(words):
            real_caption_save_words(vp, words)
            real_caption_safe_print(f"[RealCaption] real words generated: {len(words)}")
            return words
    except Exception as exc:
        real_caption_safe_print(f"[RealCaption] Whisper failed: {exc}")
    return []

def _auto_caption_words_if_missing(words=None, voice_path=None, duration=None, caption_mode="word_by_word", style_id=None):
    real_words = real_caption_transcribe_voice(voice_path)
    if real_words:
        return real_words
    if words and not real_caption_is_fake(words):
        return words
    real_caption_safe_print("[RealCaption] No real transcript found. Returning empty words, not fake preview words.")
    return []

def real_caption_patch_plan(plan):
