def safe_print(message):
    try:
        print(str(message).replace("→", "->").replace("—", "-").replace("–", "-"), flush=True)
    except Exception:
        pass


def progress(label, step, total):
    pct = int((float(step) / max(1, float(total))) * 100)
    safe_print(f"[MasterPipeline] {pct}% | {label}")
    return pct


def _validate_file(path, label="file"):
    p = Path(path)
    if not p.exists():
        raise FileNotFoundError(f"{label} not found: {p}")
    return p


def _mode_key(mode="SHORT"):
    return "SHORT" if str(mode or "SHORT").upper() != "LONG" else "LONG"


def _natural_key(path):
    stem = Path(path).stem
    parts = []
    cur = ""
    for ch in stem:
        if ch.isdigit():
            cur += ch
        else:
            if cur:
                parts.append((0, int(cur)))
                cur = ""
            parts.append((1, ch.lower()))
    if cur:
        parts.append((0, int(cur)))
    return parts


def list_assets(mode="SHORT"):
    mode_folder = "shorts" if _mode_key(mode) == "SHORT" else "long"
    voice_dir = ASSETS_DIR / mode_folder / "voices"
    clips_dir = ASSETS_DIR / mode_folder / "clips"
    music_dir = ASSETS_DIR / mode_folder / "music"
    sfx_dir = ASSETS_DIR / mode_folder / "sfx"
    for d in (voice_dir, clips_dir, music_dir, sfx_dir):
        d.mkdir(parents=True, exist_ok=True)
    voices = sorted([p for p in voice_dir.iterdir() if p.is_file() and p.suffix.lower() in AUDIO_EXTS], key=_natural_key)
    clips = sorted([p for p in clips_dir.iterdir() if p.is_file() and p.suffix.lower() in VIDEO_EXTS], key=_natural_key)
    music = sorted([p for p in music_dir.iterdir() if p.is_file() and p.suffix.lower() in AUDIO_EXTS], key=_natural_key)
    sfx = sorted([p for p in sfx_dir.iterdir() if p.is_file() and p.suffix.lower() in AUDIO_EXTS], key=_natural_key)
    return {"voices": voices, "clips": clips, "music": music, "sfx": sfx, "dirs": {"voices": voice_dir, "clips": clips_dir, "music": music_dir, "sfx": sfx_dir}}


def choose_default_voice(mode="SHORT"):
    assets = list_assets(mode)
    return assets["voices"][0] if assets["voices"] else None


def choose_default_music(mode="SHORT", render_count=0):
    assets = list_assets(mode)
    if not assets["music"]:
        return None
    return assets["music"][int(render_count or 0) % len(assets["music"])]


def load_words_json(words_path=None):
    if not words_path:
        return []
    p = Path(words_path)
    if not p.exists():
        return []
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
        if isinstance(data, dict) and "words" in data:
            return data["words"]
        if isinstance(data, list):
            return data
    except Exception:
        return []
    return []


def transcript_to_fake_words(text, words_per_second=2.6):
    raw = str(text or "").split()
    t = 0.0
    dur = 1.0 / max(0.5, float(words_per_second))
    out = []
    for w in raw:
        out.append({"word": w, "start": round(t, 3), "end": round(t + dur, 3)})
        t += dur
    return out


def build_pipeline_plan(voice_path=None, clips=None, mode="SHORT", niche="default", render_count=0, words=None, style_id=None, caption_mode="word_by_word"):
    voice_path = Path(voice_path) if voice_path else choose_default_voice(mode)
    if voice_path is None:
        raise FileNotFoundError("No voice file found.")
    voice_duration = get_voice_duration_float(voice_path)
    export_plan = build_export_duration_plan(voice_path, target_mode=mode)
    assets = list_assets(mode)
    clips = list(clips or assets["clips"])
    if not clips:
        raise FileNotFoundError("No video clips found.")
    format_plan = build_format_plan(video_paths=clips, voice_path=voice_path, voice_duration=voice_duration, forced_mode=mode, chunk_size=8.0, quality="edit")
    pacing_plan = build_viral_pacing_plan(total_duration=export_plan.get("final_duration", voice_duration), mode=mode, niche=niche, render_count=render_count)
    clip_sequence = build_smart_clip_sequence(clips, pacing_plan, words=words or [], niche=niche, render_count=render_count)
    caption_setup = ensure_caption_setup_safe(words or [], style_id=style_id, mode=caption_mode, niche=niche, video_type=mode)
    return {
        "voice_path": str(voice_path),
        "voice_duration": voice_duration,
        "mode": _mode_key(mode),
        "niche": niche,
        "render_count": int(render_count or 0),
        "export_plan": export_plan,
        "format_plan": format_plan,
        "pacing_plan": pacing_plan,
        "clip_sequence": clip_sequence,
        "caption_setup": caption_setup,
        "clip_count": len(clips),
    }


def create_base_video(clips, target_duration, mode="SHORT", niche="default", render_count=0, apply_motion=True):
    progress("Preparing formatted clips", 1, 9)
    formatted_clips = prepare_clip_sequence_for_duration(
        video_paths=clips,
        target_duration=target_duration,
        mode=mode,
        strategy="smart",
        quality="edit",
        chunk_size=8.0,
        audio=False,
    )
    if not formatted_clips:
        raise RuntimeError("No formatted clips created.")
    if apply_motion:
        motion_clips = []
        for i, clip in enumerate(formatted_clips):
            try:
                motion_clips.append(apply_human_motion_to_clip(clip, mode=mode, niche=niche, render_count=render_count + i))
            except Exception:
                motion_clips.append(clip)
        formatted_clips = motion_clips
    progress("Concatenating clips", 2, 9)
    video = concatenate_formatted_clips(formatted_clips, target_duration=target_duration)
    if video is None:
        raise RuntimeError("Video concatenate failed.")
    return video


def apply_visual_layers(video, words=None, mode="SHORT", niche="default", render_count=0, caption_mode="word_by_word", style_id=None, add_captions=True, add_keyword_zoom=True, add_beat=True, add_story=True):
    if add_keyword_zoom and words:
        progress("Applying keyword zoom", 3, 9)
        try:
            video = apply_keyword_zoom(video, words, niche=niche, mode=mode, caption_mode=caption_mode)
        except Exception as e:
            safe_print(f"[MasterPipeline] keyword zoom skipped: {e}")
    if add_beat:
        progress("Applying rhythm accents", 4, 9)
        try:
            video = apply_beat_flashes(video, duration=video.duration, mode=mode, niche=niche, render_count=render_count)
        except Exception as e:
            safe_print(f"[MasterPipeline] beat accents skipped: {e}")
    if add_story:
        progress("Applying story flow", 5, 9)
        try:
            video = apply_story_flow(video, mode=mode, niche=niche, render_count=render_count)
        except Exception as e:
            safe_print(f"[MasterPipeline] story flow skipped: {e}")
    if add_captions and words:
        progress("Adding captions", 6, 9)
        setup = ensure_caption_setup_safe(words, style_id=style_id, mode=caption_mode, niche=niche, video_type=mode)
        try:
            video = add_captions_to_video(video, setup["words"], style_id=setup["style_id"], mode=setup["mode"], niche=niche)
        except Exception as e:
            safe_print(f"[MasterPipeline] captions skipped: {e}")
    return video


def apply_hook_layer(video, mode="SHORT", niche="default", render_count=0, hook_text=None, use_hook=True):
    if not use_hook:
        return video
    progress("Adding hook", 7, 9)
    try:
