def _ffmpeg_4k_enhance_short(input_path, output_path=None, fps=30):
    if not _quality_ffmpeg_exists():
        return str(input_path)
    input_path = Path(input_path)
    if not input_path.exists():
        return str(input_path)
    output_path = Path(output_path or input_path.with_name(input_path.stem + "_4k_enhanced.mp4"))
    vf = "scale=2160:3840:flags=lanczos,unsharp=5:5:0.70:3:3:0.35,format=yuv420p"
    cmd = ["ffmpeg", "-y", "-i", str(input_path), "-vf", vf, "-r", str(int(fps or 30)), "-c:v", "libx264", "-preset", "veryfast", "-crf", "18", "-c:a", "copy", str(output_path)]
