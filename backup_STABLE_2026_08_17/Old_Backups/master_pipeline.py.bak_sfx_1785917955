def export_integrated_final_video(video_path, audio_path, plan, output_path=None):
    progress("Exporting integrated final video", 9, 12)
    mode = plan.get("mode", "SHORT")
    preset = plan.get("preset", {})
    if mode == "SHORT":
        default_name = f"FINAL_SHORT_4K_INTEGRATED_{int(time.time())}.mp4"
        default_dir = SHORT_OUTPUT_DIR
    else:
        default_name = f"FINAL_LONG_4K_INTEGRATED_{int(time.time())}.mp4"
        default_dir = OUTPUT_DIR / "long"
        default_dir.mkdir(parents=True, exist_ok=True)
    output_path = Path(output_path or default_dir / default_name)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    final_path = mux_video_audio(
        video_path,
        audio_path,
        output_path=output_path,
        mode=mode,
        duration=plan.get("target_duration"),
        final_4k=bool(preset.get("final_4k", True)),
        quality=preset.get("quality", "high"),
        fps=int(preset.get("fps", 30)),
        complexity="normal",
    )
    try:
        validation = validate_duration_pipeline(video_path=video_path, voice_path=plan.get("voice_path"), audio_path=audio_path, output_path=final_path)
        if not validation.get("ok", True):
            safe_print(f"[MasterPipeline] integrated duration validation issues: {validation.get('issues')}")
    except Exception:
        pass
    return final_path


def run_integrated_short_pipeline(
    voice_path=None,
    clips=None,
    words=None,
    words_path=None,
    transcript_text=None,
    output_path=None,
    niche="default",
    render_count=0,
    caption_mode="word_by_word",
    style_id=None,
    music_path=None,
    sfx_files=None,
    use_hook=True,
    hook_text=None,
    final_4k=True,
    fps=30,
    quality="high",
    clean_silence=False,
    add_captions=True,
    preset_overrides=None,
):
    started = time.time()
    log = {"started": started, "pipeline": "integrated_short", "niche": niche, "render_count": render_count}
    video_obj = None
    try:
        mode = "SHORT"
        assets = list_assets(mode)
        voice_path = Path(voice_path) if voice_path else choose_default_voice(mode)
        if voice_path is None:
            raise FileNotFoundError("Voice missing.")
        voice_path = _validate_file(voice_path, "voice")
        clips = list(clips or assets["clips"])
        if not clips:
            raise FileNotFoundError("Clips missing.")
        if words_path and not words:
            words = load_words_json(words_path)
        if transcript_text and not words:
            words = transcript_to_fake_words(transcript_text)
        words = words or []
        overrides = {"final_4k": final_4k, "fps": fps, "quality": quality, "clean_silence": clean_silence}
        if preset_overrides:
            overrides.update(preset_overrides)
        plan = build_deep_integrated_master_plan(
            voice_path=voice_path,
            clips=clips,
            words=words,
            mode=mode,
            niche=niche,
            render_count=render_count,
            caption_mode=caption_mode,
            style_id=style_id,
            preset_overrides=overrides,
        )
        log["plan"] = plan
        video_obj = create_integrated_base_video_from_plan(plan, clips=clips)
        video_obj = apply_integrated_visual_layers(video_obj, plan, add_captions=add_captions)
        video_obj = apply_integrated_hook(video_obj, plan, hook_text=hook_text, use_hook=use_hook)
        temp_video = write_temp_video(video_obj, fps=fps)
        log["temp_video"] = temp_video
        audio_mix = build_integrated_audio_for_pipeline(
            voice_path,
            plan,
            music_path=music_path or choose_default_music(mode, render_count=render_count),
            sfx_files=sfx_files or assets["sfx"],
            clean_silence=clean_silence,
        )
        log["audio_mix"] = audio_mix
        final = export_integrated_final_video(temp_video, audio_mix, plan, output_path=output_path)
        log["final"] = final
        log["duration_seconds"] = round(time.time() - started, 3)
        save_pipeline_log(log, output_path=LOG_DIR / f"integrated_master_pipeline_{int(time.time())}.json")
        progress("Integrated done", 12, 12)
        return final
    except Exception as e:
        log["error"] = str(e)
        log["traceback"] = traceback.format_exc()
        save_pipeline_log(log, output_path=LOG_DIR / f"integrated_master_pipeline_error_{int(time.time())}.json")
        raise
    finally:
        try:
            if video_obj is not None:
                video_obj.close()
        except Exception:
            pass

