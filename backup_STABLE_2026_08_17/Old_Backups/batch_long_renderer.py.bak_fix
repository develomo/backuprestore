# batch_long_renderer.py
# STABLE LONG RENDERER FIX: no freeze, intro voice delay, outro silent, mid subscribe chromakey.
from __future__ import annotations
from pathlib import Path
from typing import Any, Callable, Dict, Iterable, List, Optional, Sequence, Tuple
import json, re, shutil, subprocess, time, gc

VIDEO_EXTS={".mp4",".mov",".mkv",".avi",".webm",".m4v"}
AUDIO_EXTS={".mp3",".wav",".m4a",".aac",".flac",".ogg"}
IMAGE_EXTS={".png",".jpg",".jpeg",".webp"}
DEFAULT_EDIT_QUALITY="480p"; DEFAULT_BATCH_SIZE=8; DEFAULT_FPS=24
INTRO_SECONDS=2.0; OUTRO_SECONDS=2.0; VOICE_START_OFFSET=2.0

def log(x):
    try: print(str(x), flush=True)
    except Exception: pass

def fnum(x,d=0.0):
    try: return float(x)
    except Exception: return float(d)

def inum(x,d=0):
    try: return int(x)
    except Exception: return int(d)

def natural_key(path):
    s=Path(path).stem; out=[]; cur=""
    for ch in s:
        if ch.isdigit(): cur+=ch
        else:
            if cur: out.append((0,int(cur))); cur=""
            out.append((1,ch.lower()))
    if cur: out.append((0,int(cur)))
    return out

def existing_files(items, exts=None):
    out=[]
    for item in items or []:
        try:
            p=Path(item)
            if p.exists() and p.is_file() and (exts is None or p.suffix.lower() in exts): out.append(p)
        except Exception: pass
    return sorted(out,key=natural_key)

def first_existing(items, exts=None):
    xs=existing_files(items,exts); return xs[0] if xs else None

def get_ffmpeg():
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        return "ffmpeg"
FFMPEG=get_ffmpeg()
FFPROBE=str(Path(FFMPEG).with_name("ffprobe.exe")) if Path(FFMPEG).name.lower()=="ffmpeg.exe" else "ffprobe"

def run_cmd(cmd,label=None):
    if label: log(label)
    r=subprocess.run([str(x) for x in cmd],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,errors="ignore")
    if r.returncode!=0: raise RuntimeError((r.stderr or "")[-5000:])
    return r

def probe_duration(path):
    try:
        r=subprocess.run([FFPROBE,"-v","error","-show_entries","format=duration","-of","default=nw=1:nk=1",str(path)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,errors="ignore")
        if r.returncode==0: return max(0.05,float(r.stdout.strip()))
    except Exception: pass
    return 6.0

def probe_video_size(path):
    try:
        r=subprocess.run([FFPROBE,"-v","error","-select_streams","v:0","-show_entries","stream=width,height","-of","csv=s=x:p=0",str(path)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,errors="ignore")
        if r.returncode==0 and "x" in r.stdout:
            w,h=r.stdout.strip().split("x")[:2]; return max(1,int(w)),max(1,int(h))
    except Exception: pass
    return 854,480

def normalize_quality(q):
    q=str(q or "480p").lower()
    if q in {"high","balanced","edit","fast","max","1080p","4k","2160p"}: return "480p"
    if "720" in q: return "720p"
    if "360" in q: return "360p"
    return "480p"

def quality_to_size(q):
    q=normalize_quality(q)
    if q=="720p": return 1280,720
    if q=="360p": return 640,360
    return 854,480

def duration_plan(total, n):
    total=max(0.1,fnum(total,0.1)); n=max(1,int(n or 1)); base=total/n
    pattern=[4.2,5.1,6.4,7.2,5.5,8.0,4.7,6.0,7.8,5.8,6.7,4.9]
    ds=[base]*n if base<3.2 else [max(3.2,min(9.0,base*.70+pattern[i%len(pattern)]*.30)) for i in range(n)]
    scale=total/max(.1,sum(ds)); ds=[max(.25,d*scale) for d in ds]
    ds[-1]=max(.25,ds[-1]+(total-sum(ds)))
    return ds

def chunked(items,batch_size):
    batch_size=max(2,int(batch_size or DEFAULT_BATCH_SIZE))
    for i in range(0,len(items),batch_size): yield i,list(items[i:i+batch_size])

def detect_crop_filter(path):
    try:
        p=Path(path); dur=probe_duration(p); ss=min(max(0.0,dur*.2),8.0)
        r=subprocess.run([FFMPEG,"-hide_banner","-ss",f"{ss:.2f}","-t","2.0","-i",str(p),"-vf","cropdetect=limit=24:round=2:reset=0","-frames:v","30","-f","null","-"],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,errors="ignore")
        matches=re.findall(r"crop=(\d+:\d+:\d+:\d+)",(r.stderr or "")+(r.stdout or ""))
        if not matches: return None
        crop=matches[-1]; w,h,x,y=[int(v) for v in crop.split(":")]; sw,sh=probe_video_size(p)
        if w<sw*.5 or h<sh*.5 or w<=0 or h<=0: return None
        return f"crop={crop}:exact=1"
    except Exception: return None

def motion_profile_for_niche(niche="default"):
    n=str(niche or "default").lower()
    profiles={
        "luxury":{"zoom_min":1.075,"zoom_max":1.115,"step":0.00055,"grade":"eq=contrast=1.035:saturation=1.025:brightness=0.002"},
        "luxury_lifestyle":{"zoom_min":1.075,"zoom_max":1.115,"step":0.00055,"grade":"eq=contrast=1.035:saturation=1.025:brightness=0.002"},
        "mystery":{"zoom_min":1.085,"zoom_max":1.125,"step":0.00062,"grade":"eq=contrast=1.045:saturation=1.018:brightness=-0.002"},
        "ai":{"zoom_min":1.090,"zoom_max":1.130,"step":0.00068,"grade":"eq=contrast=1.045:saturation=1.045:brightness=0.001"},
        "quantum_future":{"zoom_min":1.090,"zoom_max":1.130,"step":0.00068,"grade":"eq=contrast=1.045:saturation=1.045:brightness=0.001"},
        "finance":{"zoom_min":1.045,"zoom_max":1.075,"step":0.00042,"grade":"eq=contrast=1.030:saturation=1.012:brightness=0.001"},
        "finance_simulation":{"zoom_min":1.045,"zoom_max":1.075,"step":0.00042,"grade":"eq=contrast=1.030:saturation=1.012:brightness=0.001"},
        "islamic":{"zoom_min":1.040,"zoom_max":1.070,"step":0.00038,"grade":"eq=contrast=1.020:saturation=1.010:brightness=0.002"},
        "home_design":{"zoom_min":1.060,"zoom_max":1.095,"step":0.00048,"grade":"eq=contrast=1.028:saturation=1.025:brightness=0.002"},
        "interior_design":{"zoom_min":1.060,"zoom_max":1.095,"step":0.00048,"grade":"eq=contrast=1.028:saturation=1.025:brightness=0.002"},
        "stoic":{"zoom_min":1.040,"zoom_max":1.075,"step":0.00038,"grade":"eq=contrast=1.024:saturation=1.010:brightness=0.001"},
        "default":{"zoom_min":1.065,"zoom_max":1.105,"step":0.00050,"grade":"eq=contrast=1.030:saturation=1.020:brightness=0.002"},
    }
    return profiles.get(n,profiles["default"])

def motion_direction(index):
    dirs=[
        ("center_push","(iw-iw/zoom)/2","(ih-ih/zoom)/2"),
        ("left_to_right","(iw-iw/zoom)*0.25","(ih-ih/zoom)/2"),
        ("right_to_left","(iw-iw/zoom)*0.75","(ih-ih/zoom)/2"),
        ("top_to_bottom","(iw-iw/zoom)/2","(ih-ih/zoom)*0.25"),
        ("bottom_to_top","(iw-iw/zoom)/2","(ih-ih/zoom)*0.75"),
        ("diagonal_soft","(iw-iw/zoom)*0.35","(ih-ih/zoom)*0.65"),
        ("diagonal_reverse","(iw-iw/zoom)*0.65","(ih-ih/zoom)*0.35"),
    ]
    return dirs[int(index or 0)%len(dirs)]

def make_visual_filter(src,size,index,fps,niche="default"):
    """MODULE 1 MOTION ENGINE V1.

    Every clip gets visible but safe Ken Burns motion.
    """
    w,h=size
    parts=[]
    crop=detect_crop_filter(src)
    if crop:
        parts.append(crop)
    prof=motion_profile_for_niche(niche)
    zmin=float(prof["zoom_min"]); zmax=float(prof["zoom_max"])
    z=zmin+(int(index or 0)%5)*((zmax-zmin)/4.0)
    step=float(prof["step"])
    direction,x,y=motion_direction(index)
    parts += [
        f"scale={w}:{h}:force_original_aspect_ratio=increase",
        f"crop={w}:{h}:exact=1",
        f"zoompan=z='min({z:.4f},zoom+{step:.6f})':x='{x}':y='{y}':d=1:s={w}x{h}:fps={fps}",
        f"scale={w}:{h}",
        str(prof["grade"]),
        "unsharp=5:5:0.32:5:5:0.0",
        "setsar=1",
        "setdar=16/9",
    ]
    return ",".join(parts)

def scene_start(src_dur,wanted,index):
    if src_dur<=wanted+.25: return 0.0
    return max(0.0,src_dur-wanted)*((index%7)/7.0)

def render_clip_segment(src,out,wanted,index,size,fps,quality,niche='default'):
    src=Path(src); out=Path(out); sd=probe_duration(src); start=scene_start(sd,wanted,index)
    crf="32" if normalize_quality(quality)=="360p" else "29"
    run_cmd([FFMPEG,"-y","-ss",f"{start:.3f}","-t",f"{wanted:.3f}","-i",str(src),"-an","-vf",make_visual_filter(src,size,index,fps,niche=niche),"-r",str(fps),"-pix_fmt","yuv420p","-c:v","libx264","-preset","ultrafast","-crf",crf,"-movflags","+faststart",str(out)])
    return out

def normalize_video_asset(src,out,size,fps,limit,quality):
    src=Path(src); out=Path(out); w,h=size; crf="32" if normalize_quality(quality)=="360p" else "29"
    run_cmd([FFMPEG,"-y","-t",f"{float(limit):.3f}","-i",str(src),"-an","-vf",f"scale={w}:{h}:force_original_aspect_ratio=increase,crop={w}:{h}:exact=1,scale={w}:{h},setsar=1,setdar=16/9","-r",str(fps),"-pix_fmt","yuv420p","-c:v","libx264","-preset","ultrafast","-crf",crf,"-movflags","+faststart",str(out)])
    return out

def transition_profile_for_niche(niche="default"):
    """MODULE 2 - Transition Intelligence Engine.

    FFmpeg xfade supports many transition names depending on ffmpeg build.
    We use safe common transitions mostly:
    fade, dissolve, wipeleft, wiperight, wipeup, wipedown, smoothleft, smoothright.
    """
    n=str(niche or "default").lower()
    profiles={
        "luxury":{
            "base":["fade","dissolve","fade","smoothleft","fade","smoothright"],
            "chapter":["dissolve","fade"],
            "duration_base":0.38,
            "creative_every":5,
        },
        "luxury_lifestyle":{
            "base":["fade","dissolve","fade","smoothleft","fade","smoothright"],
            "chapter":["dissolve","fade"],
            "duration_base":0.38,
            "creative_every":5,
        },
        "mystery":{
            "base":["fade","dissolve","fade","wipeleft","fade","wiperight"],
            "chapter":["fade","dissolve"],
            "duration_base":0.45,
            "creative_every":4,
        },
        "ai":{
            "base":["fade","smoothleft","dissolve","smoothright","wipeleft","wiperight"],
            "chapter":["smoothleft","smoothright"],
            "duration_base":0.34,
            "creative_every":4,
        },
        "quantum_future":{
            "base":["fade","smoothleft","dissolve","smoothright","wipeleft","wiperight"],
            "chapter":["smoothleft","smoothright"],
            "duration_base":0.34,
            "creative_every":4,
        },
        "finance":{
            "base":["fade","fade","dissolve","fade","fade","smoothleft"],
            "chapter":["dissolve"],
            "duration_base":0.28,
            "creative_every":6,
        },
        "finance_simulation":{
            "base":["fade","fade","dissolve","fade","fade","smoothleft"],
            "chapter":["dissolve"],
            "duration_base":0.28,
            "creative_every":6,
        },
        "islamic":{
            "base":["fade","dissolve","fade","fade","dissolve"],
            "chapter":["dissolve"],
            "duration_base":0.42,
            "creative_every":7,
        },
        "home_design":{
            "base":["fade","dissolve","smoothleft","fade","smoothright"],
            "chapter":["dissolve"],
            "duration_base":0.36,
            "creative_every":5,
        },
        "interior_design":{
            "base":["fade","dissolve","smoothleft","fade","smoothright"],
            "chapter":["dissolve"],
            "duration_base":0.36,
            "creative_every":5,
        },
        "stoic":{
            "base":["fade","dissolve","fade","fade"],
            "chapter":["dissolve"],
            "duration_base":0.40,
            "creative_every":8,
        },
        "default":{
            "base":["fade","dissolve","fade","smoothleft","fade","smoothright"],
            "chapter":["dissolve"],
            "duration_base":0.34,
            "creative_every":5,
        },
    }
    return profiles.get(n,profiles["default"])

def transition_decision(index=0, clip_duration=6.0, niche="default", absolute_time=0.0):
    """Choose transition type + duration.

    Rules:
    - 80% simple smooth transitions
    - 20% creative directional transitions
    - every 2-3 min chapter reset gets slightly stronger transition
    - duration adapts to clip length
    """
    prof=transition_profile_for_niche(niche)
    base=list(prof["base"])
    chapter=list(prof["chapter"])
    creative_every=max(3,int(prof.get("creative_every",5)))
    duration_base=float(prof.get("duration_base",0.34))

    # Chapter transition every around 150 sec.
    if absolute_time and int(absolute_time)//150 != int(max(0,absolute_time-clip_duration))//150:
        kind=chapter[int(index or 0)%len(chapter)]
        dur=min(0.55,max(0.32,duration_base+0.08))
    elif int(index or 0)>0 and int(index or 0)%creative_every==0:
        kind=base[(int(index or 0)*2)%len(base)]
        dur=min(0.48,max(0.25,duration_base+0.04))
    else:
        kind=base[int(index or 0)%len(base)]
        dur=duration_base

    clip_duration=float(clip_duration or 6.0)
    if clip_duration<4.0:
        dur=min(dur,0.24)
    elif clip_duration>8.0:
        dur=min(0.55,dur+0.08)
    else:
        dur=min(0.45,dur)

    dur=max(0.12,min(0.60,dur))
    return {"transition":kind,"duration":dur,"index":int(index or 0),"absolute_time":float(absolute_time or 0.0)}

def concat_files(files,out,niche="default",use_transitions=True,global_index_offset=0):
    """Concat clips using real FFmpeg xfade transitions.

    If xfade fails for any reason, falls back to safe hard concat.
    This keeps rendering stable while still trying professional transitions.
    """
    out=Path(out)
    files=[Path(f) for f in files if Path(f).exists()]
    if not files:
        raise RuntimeError("No files to concat")
    if len(files)==1:
        shutil.copy2(files[0],out)
        return out

    if not use_transitions:
        return concat_files_hard(files,out)

    try:
        return concat_files_xfade(files,out,niche=niche,global_index_offset=global_index_offset)
    except Exception as e:
        log(f"[Module2Transition] xfade failed, fallback hard concat: {str(e)[-500:]}")
        return concat_files_hard(files,out)

def concat_files_hard(files,out):
    out=Path(out)
    files=[Path(f) for f in files if Path(f).exists()]
    lf=out.with_suffix(".txt")
    with lf.open("w",encoding="utf-8") as f:
        for p in files:
            fp=str(p.resolve()).replace("\\","/").replace("'","'\\''")
            f.write(f"file '{fp}'\n")
    try:
        run_cmd([FFMPEG,"-y","-f","concat","-safe","0","-i",str(lf),"-c","copy",str(out)])
    except Exception:
        run_cmd([FFMPEG,"-y","-f","concat","-safe","0","-i",str(lf),"-c:v","libx264","-preset","ultrafast","-crf","30","-pix_fmt","yuv420p",str(out)])
    try: lf.unlink(missing_ok=True)
    except Exception: pass
    return out

def concat_files_xfade(files,out,niche="default",global_index_offset=0):
    """Build xfade filter graph for a small batch.

    Works best with batch_size 6-8. Keeps RAM low by using per-batch xfade,
    then final batches can also be xfade-concat.
    """
    out=Path(out)
    files=[Path(f) for f in files if Path(f).exists()]
    durations=[probe_duration(f) for f in files]
    cmd=[FFMPEG,"-y"]
    for f in files:
        cmd += ["-i",str(f)]

    filters=[]
    # Normalize streams to stable fps/timebase/pixel format.
    for i in range(len(files)):
        filters.append(f"[{i}:v]settb=AVTB,setpts=PTS-STARTPTS,fps={DEFAULT_FPS},format=yuv420p[v{i}]")

    current="[v0]"
    elapsed=durations[0]
    transition_report=[]

    for i in range(1,len(files)):
        decision=transition_decision(
            index=global_index_offset+i,
            clip_duration=durations[i-1],
            niche=niche,
            absolute_time=elapsed,
        )
        tr=decision["transition"]
        dur=float(decision["duration"])
        offset=max(0.05,elapsed-dur)
        out_label=f"[x{i}]"
        filters.append(f"{current}[v{i}]xfade=transition={tr}:duration={dur:.3f}:offset={offset:.3f}{out_label}")
        transition_report.append(decision)
        current=out_label
        elapsed=elapsed+durations[i]-dur

    cmd += [
        "-filter_complex",";".join(filters),
        "-map",current,
        "-an",
        "-c:v","libx264",
        "-preset","ultrafast",
        "-crf","29",
        "-pix_fmt","yuv420p",
        "-movflags","+faststart",
        str(out),
    ]
    run_cmd(cmd,label=f"[Module2Transition] xfade concat {len(files)} clips -> {out.name}")

    try:
        out.with_suffix(".transitions.json").write_text(json.dumps({
            "module":"Module 2 - Transition Intelligence Engine",
            "niche":niche,
            "input_count":len(files),
            "transitions":transition_report,
            "hard_cuts_replaced":len(transition_report),
            "output":str(out),
        },indent=2),encoding="utf-8")
    except Exception:
        pass

    return out

def module2_transition_report():
    return {
        "module":"Module 2 - Transition Intelligence Engine",
        "version":"transition_engine_v1",
        "real_ffmpeg_xfade":True,
        "hard_cut_reduction":True,
        "niche_profiles":["luxury","mystery","ai","finance","islamic","home_design","stoic","default"],
        "transition_mix":"80% smooth / 20% creative",
        "duration_range":"0.12s-0.60s",
        "chapter_aware":True,
        "fallback_safe_hard_concat":True,
        "target_score_goal":"Transitions 7.5-9/10 after render analysis",
    }

def ass_time(sec):
    sec=max(0.0,fnum(sec)); h=int(sec//3600); m=int((sec%3600)//60); s=sec%60
    return f"{h}:{m:02d}:{s:05.2f}"

def ass_escape(text):
    return str(text or "").replace("\\","\\\\").replace("{","\\{").replace("}","\\}").replace("\n"," ").strip()

def load_caption_words(voice_path,words=None,words_path=None,transcript_text=None,total_duration=0.0):
    data=words
    if not data and words_path:
        try:
            p=Path(words_path)
            if p.exists(): data=json.loads(p.read_text(encoding="utf-8",errors="ignore"))
        except Exception: data=None
    if isinstance(data,dict): data=data.get("words",data.get("segments",[]))
    clean=[]
    if isinstance(data,list):
        for item in data:
            try:
                if isinstance(item,dict):
                    word=str(item.get("word",item.get("text",""))).strip(); st=fnum(item.get("start",item.get("s",0.0))); en=fnum(item.get("end",item.get("e",st+.45)),st+.45)
                else:
                    word=str(getattr(item,"word",getattr(item,"text",""))).strip(); st=fnum(getattr(item,"start",0.0)); en=fnum(getattr(item,"end",st+.45),st+.45)
                if word: clean.append({"word":word,"start":max(0,st),"end":max(st+.08,en)})
            except Exception: pass
    if not clean and transcript_text:
        parts=[x.strip() for x in str(transcript_text).split() if x.strip()]
        if parts:
            total_duration=max(1.0,fnum(total_duration,len(parts)*.35)); step=total_duration/max(1,len(parts))
            for i,word in enumerate(parts):
                st=i*step; clean.append({"word":word,"start":st,"end":st+min(.8,max(.22,step*.9))})
    if not clean and voice_path and Path(voice_path).exists():
        try:
            import whisper
            log("[StableLong] generating captions with Whisper")
            result=whisper.load_model("base").transcribe(str(voice_path),word_timestamps=True,verbose=False)
            for seg in result.get("segments",[]) or []:
                for w in seg.get("words",[]) or []:
                    word=str(w.get("word","")).strip()
                    if word: clean.append({"word":word,"start":fnum(w.get("start",0.0)),"end":fnum(w.get("end",0.0))})
        except Exception as e: log(f"[StableLong] whisper captions failed: {e}")
    fake={"warning","impact","now","alert"}
    if clean and {x["word"].lower() for x in clean}.issubset(fake):
        log("[StableLong] fake preview captions blocked"); return []
    clean=validate_caption_tokens(clean); clean.sort(key=lambda x:x["start"]); return clean

def group_caption_words(words,mode="phrase",style_id=None,niche="default"):
    words=validate_caption_tokens(words)
    if not words:
        return []
    mode=str(mode or "phrase").lower()
    prof=caption_style(style_id,niche=niche)
    max_words=max(2,min(6,int(prof.get("max_words",4))))
    max_chars=max(28,min(56,int(prof.get("max_chars",42))))
    uppercase=bool(prof.get("uppercase",True))

    if mode in {"word_by_word","word-by-word","word","single"}:
        out=[]
        for w in words:
            text=str(w["word"]).strip()
            if uppercase:
                text=text.upper()
            out.append({"text":text,"start":w["start"],"end":w["end"]})
        return out

    out=[]; i=0
    while i<len(words):
        group=[]
        chars=0
        while i<len(words) and len(group)<max_words:
            token=str(words[i]["word"]).strip()
            if not token:
                i+=1
                continue
            if group and chars+len(token)+1>max_chars:
                break
            group.append(words[i])
            chars += len(token)+1
            i+=1
            if token.endswith((".","?","!","…")) and len(group)>=2:
                break
        if group:
            text=" ".join(x["word"] for x in group).strip()
            if uppercase:
                text=text.upper()
            out.append({"text":text,"start":group[0]["start"],"end":max(group[0]["start"]+0.35,group[-1]["end"])})
        else:
            i+=1
    return out


def caption_profile_for_niche(niche="default"):
    """MODULE 3 - Caption Intelligence Engine.

    This profile is used only when UI style_id is AUTO/empty.
    If UI sends a specific style_id, that style is locked and not replaced.
    """
    n=str(niche or "default").lower()
    profiles={
        "luxury":{
            "style_id":"luxury_gold",
            "primary":"&H0000D7FF",
            "outline":"&H00161616",
            "back":"&H90000000",
            "font":"Segoe UI Semibold",
            "fontsize":36,
