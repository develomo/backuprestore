def is_auto_caption_style(style_id=None):
    s=str(style_id or "").strip().lower()
    return s in {"","auto","automatic","default_auto","niche_auto","auto_caption","caption_auto"}

def caption_style(style_id=None,niche="default"):
    """UI style lock + AUTO support.

    - If UI sends specific style_id, use that exact style family.
    - If UI sends auto/empty, choose niche profile.
    - No random caption style.
    """
    if is_auto_caption_style(style_id):
        return caption_profile_for_niche(niche)

    sid=str(style_id or "").lower()
    st=caption_profile_for_niche(niche)
    st["style_id"]=str(style_id)

    # ASS color format is BGR.
    if "gold" in sid or "orange" in sid or "luxury" in sid:
        st["primary"]="&H0000D7FF"
    elif "cyan" in sid or "blue" in sid or "crystal" in sid:
        st["primary"]="&H00FFF3A7"
    elif "purple" in sid or "violet" in sid or "neon" in sid:
        st["primary"]="&H00FCABF0"
    elif "green" in sid or "emerald" in sid:
        st["primary"]="&H0096FF96"
    elif "red" in sid or "ruby" in sid:
        st["primary"]="&H004040FF"
    elif "yellow" in sid:
        st["primary"]="&H0000FFFF"
    elif "black" in sid:
        st["primary"]="&H00000000"; st["outline"]="&H00FFFFFF"
    elif "white" in sid or "clean" in sid or "minimal" in sid:
        st["primary"]="&H00FFFFFF"

    if "small" in sid:
        st["fontsize"]=30
    elif "large" in sid or "bold" in sid:
        st["fontsize"]=38

    return st

def clean_caption_word(text):
    s=str(text or "").strip()
    s=re.sub(r"\s+"," ",s)
    # Remove weird OCR/Whisper artifacts but keep multilingual letters.
    s=re.sub(r"[^\wÀ-ž\u0600-\u06FF\u0900-\u097F'’.,!?-]+","",s,flags=re.UNICODE)
    return s.strip()

def validate_caption_tokens(tokens):
    out=[]
    for t in tokens or []:
        try:
            word=clean_caption_word(t.get("word",""))
            if not word:
                continue
            # Block obvious gibberish tokens: too long without vowels/numbers mostly.
            letters=re.sub(r"[^A-Za-zÀ-ž]","",word)
            if len(letters)>18:
                vowels=len(re.findall(r"[aeiouAEIOUÀ-ž]",letters))
                if vowels<2:
                    continue
            st=max(0.0,fnum(t.get("start",0.0)))
            en=max(st+0.08,fnum(t.get("end",st+0.35),st+0.35))
            out.append({"word":word,"start":st,"end":en})
        except Exception:
            pass
    fake={"warning","impact","now","alert"}
    if out and {x["word"].lower() for x in out}.issubset(fake):
        return []
    return out

def module3_caption_report():
    return {
        "module":"Module 3 - Caption Intelligence Engine",
        "version":"caption_engine_v1",
        "ui_style_lock":True,
        "auto_style_mode":True,
        "niche_caption_profiles":["luxury","mystery","ai","finance","islamic","home_design","stoic","default"],
        "garbled_caption_protection":True,
        "timing_offset_sec":-0.10,
        "voice_start_offset_supported":True,
        "target_score_goal":"Captions 8.5-9.5/10 after render analysis",
    }

def wrap_caption_text(text,max_chars=42):
    text=str(text or "").strip()
    if len(text)<=max_chars:
        return text
    words=text.split()
    lines=[]; cur=[]
    for w in words:
        test=(" ".join(cur+[w])).strip()
        if len(test)>max_chars and cur:
            lines.append(" ".join(cur)); cur=[w]
        else:
            cur.append(w)
    if cur:
        lines.append(" ".join(cur))
    return "\\N".join(lines[:2])

def write_ass_file(path,segments,size,style_id,caption_offset,niche="default"):
    path=Path(path); w,h=size
    st=caption_style(style_id,niche=niche)
    margin_v=max(42,int(h*float(st.get("margin_v_ratio",0.135))))
    alignment=int(st.get("alignment",2))
    fontsize=int(st.get("fontsize",34))
    font=str(st.get("font","Segoe UI Semibold"))
    max_chars=int(st.get("max_chars",42))
    lines=[
        "[Script Info]",
        "ScriptType: v4.00+",
        f"PlayResX: {w}",
        f"PlayResY: {h}",
        "ScaledBorderAndShadow: yes",
        "",
        "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
        f"Style: Default,{font},{fontsize},{st['primary']},&H000000FF,{st['outline']},{st['back']},-1,0,0,0,100,100,0,0,3,2.8,0,{alignment},42,42,{margin_v},1",
        "",
        "[Events]",
        "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text"
    ]
    for seg in segments:
        start=max(0.0,fnum(seg.get("start"))+caption_offset-0.10)
        end=max(start+0.15,fnum(seg.get("end"),start+0.5)+caption_offset)
        text=wrap_caption_text(ass_escape(seg.get("text","")),max_chars=max_chars)
        if text:
            lines.append(f"Dialogue: 0,{ass_time(start)},{ass_time(end)},Default,,0,0,0,,{text}")
    path.write_text("\\n".join(lines),encoding="utf-8")
    return path

def burn_captions(video,out,voice_path,words=None,words_path=None,transcript_text=None,caption_mode="phrase",style_id=None,size=(854,480),caption_offset=VOICE_START_OFFSET,niche='default'):
    video=Path(video); out=Path(out); total=probe_duration(video)
    word_items=load_caption_words(voice_path,words=words,words_path=words_path,transcript_text=transcript_text,total_duration=max(1,total-caption_offset-OUTRO_SECONDS))
    segments=group_caption_words(word_items,caption_mode,style_id=style_id,niche=niche)
    if not segments:
        log("[StableLong] captions requested but no real words found; skipping captions"); shutil.copy2(video,out); return out
    ass=out.with_suffix(".ass"); write_ass_file(ass,segments,size,style_id,caption_offset,niche=niche)
    ass_filter=str(ass.resolve()).replace("\\","/").replace(":","\\:")
    run_cmd([FFMPEG,"-y","-i",str(video),"-vf",f"subtitles='{ass_filter}'","-c:v","libx264","-preset","ultrafast","-crf","29","-pix_fmt","yuv420p","-an",str(out)])
    return out

def apply_subscribe_overlay_mid(video,overlay,out,intro_sec,voice_duration):
    video=Path(video); out=Path(out)
    if not overlay or not Path(overlay).exists(): shutil.copy2(video,out); return out
    overlay=Path(overlay); total=probe_duration(video); mid=intro_sec+max(5.0,voice_duration*.50)
    start=max(intro_sec+5.0,mid-4.0); end=min(total-OUTRO_SECONDS-.25,start+8.0)
    if end<=start: shutil.copy2(video,out); return out
    if overlay.suffix.lower() in IMAGE_EXTS:
        filt=f"[1:v]scale=220:-1,format=rgba,colorchannelmixer=aa=0.92[ov];[0:v][ov]overlay=main_w-overlay_w-24:main_h-overlay_h-24:enable='between(t,{start:.3f},{end:.3f})'"
        cmd=[FFMPEG,"-y","-i",str(video),"-loop","1","-i",str(overlay),"-filter_complex",filt,"-c:v","libx264","-preset","ultrafast","-crf","30","-pix_fmt","yuv420p","-an",str(out)]
    else:
        filt=f"[1:v]scale=260:-1,format=rgba,chromakey=0x00ff00:0.28:0.12,colorchannelmixer=aa=0.95[ov];[0:v][ov]overlay=main_w-overlay_w-24:main_h-overlay_h-24:enable='between(t,{start:.3f},{end:.3f})'"
        cmd=[FFMPEG,"-y","-i",str(video),"-stream_loop","-1","-i",str(overlay),"-filter_complex",filt,"-t",f"{total:.3f}","-c:v","libx264","-preset","ultrafast","-crf","30","-pix_fmt","yuv420p","-an",str(out)]
    run_cmd(cmd); return out

